<title>
  Schulferien {@federal_state.name} {@year} - Alle Ferientermine
</title>
<meta
  name="description"
  content={dynamic_federal_state_description(@federal_state.name, @year, @periods, @today)}
/>
<meta
  name="keywords"
  content={"Schulferien #{@federal_state.name} #{@year}, Sommerferien #{@federal_state.name}, Osterferien #{@federal_state.name}, Herbstferien #{@federal_state.name}, Weihnachtsferien #{@federal_state.name}, Ferien #{@federal_state.name}, Ferientermine"}
/>

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<link
  rel="canonical"
  href={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}")}
/>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta
  property="og:url"
  content={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}")}
/>
<meta
  property="og:title"
  content={"Schulferien #{@federal_state.name} #{@year} - Alle Ferientermine"}
/>
<meta
  property="og:description"
  content={"Alle Schulferien #{@year} für #{@federal_state.name}: Oster-, Sommer-, Herbst- und Weihnachtsferien. Mit Kalender, iCal-Export und Brückentagen."}
/>
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- OpenGraph Image -->
<meta
  property="og:image"
  content={"https://www.mehr-schulferien.de/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}/handwritten.webp"}
/>
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={"Schulferien #{@federal_state.name} #{@year} - Handgeschriebene Übersicht"}
/>
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta
  property="twitter:url"
  content={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}")}
/>
<meta property="twitter:title" content={"Schulferien #{@federal_state.name} #{@year}"} />
<meta
  property="twitter:description"
  content={"Alle Schulferien #{@year} für #{@federal_state.name}: Oster-, Sommer-, Herbst- und Weihnachtsferien."}
/>
<meta
  property="twitter:image"
  content={"https://www.mehr-schulferien.de/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}/handwritten.webp"}
/>
<!-- Pagination for year navigation -->
<% prev_year = @year - 1 %>
<% next_year = @year + 1 %>
<%= if prev_year >= 2020 do %>
  <link
    rel="prev"
    href={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{prev_year}")}
  />
<% end %>
<%= if next_year <= 2030 do %>
  <link
    rel="next"
    href={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{next_year}")}
  />
<% end %>

<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: @country.name, item: url(~p"/ferien/#{@country.slug}")},
    %{name: "Ferientermine #{@federal_state.name} #{@year}", item: url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}")}
  ]) %>
</script>
