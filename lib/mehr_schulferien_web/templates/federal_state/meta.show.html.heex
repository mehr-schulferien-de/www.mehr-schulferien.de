<title>
  Schulferien {@federal_state.name} {@current_year}/{@next_year} - Alle Ferientermine
</title>
<meta
  name="description"
  content={
    dynamic_federal_state_description(@federal_state.name, @current_year, @periods, @today)
  }
/>
<meta
  name="keywords"
  content={"Schulferien #{@federal_state.name}, Ferien #{@federal_state.name}, Sommerferien #{@federal_state.name}, Osterferien #{@federal_state.name}, Herbstferien #{@federal_state.name}, Weihnachtsferien #{@federal_state.name}, Ferientermine, #{@current_year}, #{@next_year}"}
/>

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<link
  rel="canonical"
  href={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}")}
/>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta
  property="og:url"
  content={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}")}
/>
<meta
  property="og:title"
  content={"Schulferien #{@federal_state.name} #{@current_year}/#{@next_year} - Alle Ferientermine"}
/>
<meta
  property="og:description"
  content={"Alle Schulferien für #{@federal_state.name} #{@current_year} und #{@next_year}: Oster-, Sommer-, Herbst- und Weihnachtsferien. Mit Kalender, iCal-Export und Brückentagen."}
/>
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- OpenGraph Image -->
<meta
  property="og:image"
  content={"https://www.mehr-schulferien.de/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@current_year}/handwritten.webp"}
/>
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={"Schulferien #{@federal_state.name} - Handgeschriebene Übersicht"}
/>
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta
  property="twitter:url"
  content={url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}")}
/>
<meta
  property="twitter:title"
  content={"Schulferien #{@federal_state.name} #{@current_year}/#{@next_year}"}
/>
<meta
  property="twitter:description"
  content={"Alle Schulferien für #{@federal_state.name} #{@current_year} und #{@next_year}: Oster-, Sommer-, Herbst- und Weihnachtsferien."}
/>
<meta
  property="twitter:image"
  content={"https://www.mehr-schulferien.de/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@current_year}/handwritten.webp"}
/>

<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: @country.name, item: url(~p"/ferien/#{@country.slug}")},
    %{name: "Schulferien #{@federal_state.name}", item: url(~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}")}
  ]) %>
</script>
