<div class="mt-0 sm:mt-1">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4">
      <.heading level={1} class="text-left">
        Schulferien <%= @federal_state.name %>
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@federal_state}
        location_type={:federal_state}
        years_with_data={@years_with_data}
        year={@year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <.periods_table
                periods={@periods}
                all_periods={@all_periods}
                today={@today}
                federal_state={@federal_state}
                conn={@conn}
                year={@year}
              />
              <.partial_data periods={@periods} federal_state={@federal_state} year={@year} />
              <.last_updated periods={@periods} federal_state={@federal_state} />
            <% else %>
              <.no_data
                conn={@conn}
                country={@country}
                federal_state={@federal_state}
                year={@year}
                years_with_data={@years_with_data}
              />
            <% end %>
          </:content>
        </.card>
      </div>
      <div class="lg:w-1/3">
        <.ical_panel
          conn={@conn}
          entity_slug={@federal_state.slug}
          entity_name={@federal_state.name}
          entity_type="federal_state"
          year={@year}
        />

        <% # Quick links to vacation-specific pages %>
        <%= if length(@vacation_types) > 0 do %>
          <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <.heading level={3} class="text-lg text-blue-900 mb-3">
              Direkt zu den Ferien:
            </.heading>
            <div class="grid grid-cols-2 gap-2">
              <%= for vacation_type <- @vacation_types do %>
                <a
                  href={"/#{vacation_type.slug}ferien/#{@federal_state.slug}/#{@year}"}
                  class="px-3 py-2 text-sm font-medium text-blue-700 bg-white hover:bg-blue-100 border border-blue-300 rounded-md transition-colors text-center"
                >
                  <%= vacation_type.colloquial %>
                </a>
              <% end %>
            </div>
          </div>
        <% end %>

        <.wordpress_plugin_info
          location_type={:federal_state}
          location_name={@federal_state.name}
          location_slug={@federal_state.slug}
        />
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-4">Kalenderansicht</.heading>

        <.calendar_legend />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <% # Use DateCalculations helper for date calculations
      date_data = MehrSchulferienWeb.Helpers.DateCalculations.calculate_surrounding_dates(@today)
      yesterday = date_data.yesterday
      tomorrow = date_data.tomorrow
      day_after_tomorrow = date_data.day_after_tomorrow

      # Use PeriodHelpers for filtering periods
      yesterdays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, yesterday)

      todays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, @today)

      tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, tomorrow)

      day_after_tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          @periods,
          day_after_tomorrow
        )

      # Find public holiday periods for specific days
      public_holidays =
        MehrSchulferienWeb.Helpers.PeriodHelpers.public_holiday_periods(@public_periods)

      yesterdays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          yesterday
        )

      todays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, @today)

      tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, tomorrow)

      day_after_tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          day_after_tomorrow
        ) %>

      <%= if @today.year == @year do %>
        <.faq
          conn={@conn}
          country={@country}
          federal_state={@federal_state}
          location={@federal_state}
          next_schoolday={ViewHelpers.next_schoolday(@public_periods ++ @periods)}
          current_year={@year}
          today={@today}
          yesterday={yesterday}
          tomorrow={tomorrow}
          day_after_tomorrow={day_after_tomorrow}
          school_periods={@periods}
          public_periods={@public_periods}
          months={MehrSchulferienWeb.Helpers.MonthHelpers.months_map()}
          yesterdays_school_free_periods={yesterdays_school_free_periods}
          todays_school_free_periods={todays_school_free_periods}
          tomorrows_school_free_periods={tomorrows_school_free_periods}
          day_after_tomorrows_school_free_periods={day_after_tomorrows_school_free_periods}
          yesterdays_public_holiday_periods={yesterdays_public_holiday_periods}
          todays_public_holiday_periods={todays_public_holiday_periods}
          tomorrows_public_holiday_periods={tomorrows_public_holiday_periods}
          day_after_tomorrows_public_holiday_periods={day_after_tomorrows_public_holiday_periods}
        />
      <% end %>
    <% end %>

    <.schema_org_event periods={@periods} federal_state={@federal_state} country={@country} />
    <%= unless @today.year == @year do %>
      <.faq_schema federal_state={@federal_state} year={@year} periods={@periods} />
    <% end %>
    <.itemlist_schema
      periods={@periods}
      all_periods={@all_periods}
      federal_state={@federal_state}
      year={@year}
    />
  </div>
</div>
