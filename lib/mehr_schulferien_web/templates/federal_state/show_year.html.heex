<div class="mt-6 sm:mt-8">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4">
      <.heading level={1}>
        Schulferien {@federal_state.name}
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@federal_state}
        location_type={:federal_state}
        years_with_data={@years_with_data}
        year={@year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <.periods_table
                periods={@periods}
                all_periods={@all_periods}
                today={@today}
                federal_state={@federal_state}
                conn={@conn}
                year={@year}
              />
              <.partial_data periods={@periods} federal_state={@federal_state} year={@year} />
              <.last_updated periods={@periods} federal_state={@federal_state} />
              <!-- iCal Export Box -->
              <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mt-4">
                <div>
                  <.heading
                    level={2}
                    class="text-sm font-medium text-gray-900 dark:text-gray-100 mb-1 flex items-center"
                  >
                    <svg
                      class="w-4 h-4 mr-2 text-gray-600 dark:text-gray-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    iCal Download
                  </.heading>
                  <.text variant="muted" class="mb-3">
                    Importieren Sie die Schulferien direkt in Ihren Kalender.
                  </.text>
                  <div class="grid grid-cols-2 gap-2">
                    <%= link to: "/api/v2.1/federal-states/#{@federal_state.slug}/icalendar?vacation_types=school&year=#{@year}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 rounded-md transition-colors",
                        download: "schulferien-#{@federal_state.slug}-#{@year}.ics" do %>
                      📅 {@year}
                    <% end %>
                    <%= link to: "/api/v2.1/federal-states/#{@federal_state.slug}/icalendar?vacation_types=school&year=#{@year + 1}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 rounded-md transition-colors",
                        download: "schulferien-#{@federal_state.slug}-#{@year + 1}.ics" do %>
                      📅 {@year + 1}
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <.no_data
                conn={@conn}
                country={@country}
                federal_state={@federal_state}
                year={@year}
                years_with_data={@years_with_data}
              />
            <% end %>
          </:content>
        </.card>
      </div>
      <div class="lg:w-1/3">
        <% # Show handwritten date visualization if we have vacation data %>
        <%= if @has_data and length(@periods) > 0 do %>
          <% # Get only actual vacation periods (exclude single "schulfrei" days) %>
          <% school_vacation_periods =
            Enum.filter(@periods, fn period ->
              # Include only multi-day vacations, not single school-free days
              Date.diff(period.ends_on, period.starts_on) > 0
            end) %>

          <%= if length(school_vacation_periods) > 0 do %>
            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 shadow-sm">
              <.heading level={3} class="text-lg text-gray-800 dark:text-gray-200 mb-3">
                Ferientermine als Notiz
              </.heading>
              <div class="w-full" style="max-width: 400px; margin: 0 auto;">
                {Phoenix.HTML.raw(
                  MehrSchulferienWeb.Helpers.HandwrittenDateImage.generate_all_vacations_svg(
                    school_vacation_periods,
                    @federal_state.name,
                    @year
                  )
                )}
              </div>
            </div>
          <% end %>
        <% end %>

        <% # Quick links to vacation-specific pages %>
        <%= if length(@vacation_types) > 0 do %>
          <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
            <.heading level={3} class="text-lg text-blue-900 dark:text-blue-100 mb-3">
              Direkt zu den Ferien:
            </.heading>
            <div class="grid grid-cols-2 gap-2">
              <%= for vacation_type <- @vacation_types do %>
                <a
                  href={"/#{vacation_type.slug}ferien/#{@federal_state.slug}/#{@year}"}
                  class="px-3 py-2 text-sm font-medium text-blue-700 dark:text-blue-300 bg-white dark:bg-blue-900/30 hover:bg-blue-100 dark:hover:bg-blue-900/40 border border-blue-300 dark:border-blue-700 rounded-md transition-colors text-center"
                >
                  {vacation_type.colloquial}
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
        <% # Quick links to date query tools %>
        <div class="mt-6 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
          <.heading level={3} class="text-lg text-green-900 dark:text-green-100 mb-3">
            Schnelle Abfragen:
          </.heading>
          <div class="grid grid-cols-1 gap-2">
            <a
              href={~p"/ist-heute-feiertag/#{@federal_state.slug}"}
              class="px-3 py-2 text-sm font-medium text-green-700 dark:text-green-300 bg-white dark:bg-green-900/30 hover:bg-green-100 dark:hover:bg-green-900/40 border border-green-300 dark:border-green-700 rounded-md transition-colors text-center"
            >
              🎉 Ist heute ein Feiertag?
            </a>
            <a
              href={~p"/ist-heute-schulfrei/#{@federal_state.slug}"}
              class="px-3 py-2 text-sm font-medium text-green-700 dark:text-green-300 bg-white dark:bg-green-900/30 hover:bg-green-100 dark:hover:bg-green-900/40 border border-green-300 dark:border-green-700 rounded-md transition-colors text-center"
            >
              🎒 Ist heute schulfrei?
            </a>
          </div>
        </div>
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-4">Kalenderansicht</.heading>

        <.calendar_legend />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <% # Use DateCalculations helper for date calculations
      date_data = MehrSchulferienWeb.Helpers.DateCalculations.calculate_surrounding_dates(@today)
      yesterday = date_data.yesterday
      tomorrow = date_data.tomorrow
      day_after_tomorrow = date_data.day_after_tomorrow

      # Use PeriodHelpers for filtering periods
      yesterdays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, yesterday)

      todays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, @today)

      tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, tomorrow)

      day_after_tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          @periods,
          day_after_tomorrow
        )

      # Find public holiday periods for specific days
      public_holidays =
        MehrSchulferienWeb.Helpers.PeriodHelpers.public_holiday_periods(@public_periods)

      yesterdays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          yesterday
        )

      todays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, @today)

      tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, tomorrow)

      day_after_tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          day_after_tomorrow
        ) %>

      <%= if @today.year == @year do %>
        <.faq
          conn={@conn}
          country={@country}
          federal_state={@federal_state}
          location={@federal_state}
          next_schoolday={ViewHelpers.next_schoolday(@public_periods ++ @periods)}
          current_year={@year}
          today={@today}
          yesterday={yesterday}
          tomorrow={tomorrow}
          day_after_tomorrow={day_after_tomorrow}
          school_periods={@periods}
          public_periods={@public_periods}
          months={MehrSchulferienWeb.Helpers.MonthHelpers.months_map()}
          yesterdays_school_free_periods={yesterdays_school_free_periods}
          todays_school_free_periods={todays_school_free_periods}
          tomorrows_school_free_periods={tomorrows_school_free_periods}
          day_after_tomorrows_school_free_periods={day_after_tomorrows_school_free_periods}
          yesterdays_public_holiday_periods={yesterdays_public_holiday_periods}
          todays_public_holiday_periods={todays_public_holiday_periods}
          tomorrows_public_holiday_periods={tomorrows_public_holiday_periods}
          day_after_tomorrows_public_holiday_periods={day_after_tomorrows_public_holiday_periods}
        />
      <% end %>
    <% end %>

    <.schema_org_event periods={@periods} federal_state={@federal_state} country={@country} />
    <%= unless @today.year == @year do %>
      <.faq_schema federal_state={@federal_state} year={@year} periods={@periods} />
    <% end %>
    <.itemlist_schema
      periods={@periods}
      all_periods={@all_periods}
      federal_state={@federal_state}
      year={@year}
    />
    <!-- Developer Section -->
    <div class="mt-12 border-t border-gray-200 dark:border-gray-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <.heading level={2} class="text-2xl text-center mb-8">
          Für Entwickler
        </.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- WordPress Plugin Card -->
          <.card variant="enhanced" padding="p-6">
            <:content>
              <div class="flex items-start">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-blue-600 mr-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                  />
                </svg>
                <div>
                  <.heading level={3} class="text-lg mb-2">
                    WordPress Plugin
                  </.heading>
                  <.text variant="small" class="text-gray-700 dark:text-gray-300 mb-4">
                    Integrieren Sie die Schulferien von {@federal_state.name} direkt in Ihre WordPress-Website mit unserem kostenlosen Plugin.
                  </.text>

                  <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md p-3 mb-4 font-mono text-xs break-all text-gray-900 dark:text-gray-100">
                    [schulferien location_type="federal_state" location="{@federal_state.slug}" display="table"]
                  </div>

                  <a
                    href="https://github.com/mehr-schulferien-de/mehr-schulferien-wordpress-plugin"
                    class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 mr-1"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    Plugin auf GitHub ansehen
                  </a>
                </div>
              </div>
            </:content>
          </.card>
          <!-- API Access Card -->
          <.card variant="enhanced" padding="p-6">
            <:content>
              <div class="flex items-start">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-green-600 mr-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                <div>
                  <.heading level={3} class="text-lg mb-2">
                    API Zugriff
                  </.heading>
                  <.text variant="small" class="text-gray-700 dark:text-gray-300 mb-4">
                    Nutzen Sie unsere REST API, um Feriendaten in Ihre eigenen Anwendungen zu integrieren.
                  </.text>

                  <div class="space-y-2">
                    <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md p-3 font-mono text-xs break-all text-gray-900 dark:text-gray-100">
                      GET /api/v2.1/federal-states/{@federal_state.slug}/icalendar
                    </div>
                    <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-md p-3 font-mono text-xs break-all text-gray-900 dark:text-gray-100">
                      GET /api/v2.1/federal-states/{@federal_state.slug}/periods
                    </div>
                  </div>

                  <.text variant="muted" class="mt-3">
                    Die API liefert Daten im JSON- und iCal-Format.
                  </.text>
                </div>
              </div>
            </:content>
          </.card>
        </div>
        <!-- Open Source Contribution -->
        <div class="mt-8">
          <MehrSchulferienWeb.Components.GitHubPromotionComponent.github_promotion
            locale="de"
            wrapper_class="bg-gray-50 dark:bg-gray-800 rounded-lg px-6 py-8 sm:px-8"
          />
        </div>
      </div>
    </div>
  </div>
</div>
