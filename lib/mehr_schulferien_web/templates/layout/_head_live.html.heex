<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="csrf-token" content={csrf_token_value()} />
<!-- Default meta tags -->
<title>
  {assigns[:page_title] || "Schulferien, Feiertage, Brückentage und bewegliche Ferientage"}
</title>
<meta
  name="description"
  content={
    assigns[:page_description] ||
      "Schulferien, Feiertage, Brückentage und bewegliche Ferientage für Deutschland"
  }
/>
<!-- Open Graph meta tags -->
<%= if assigns[:page_title] do %>
  <meta property="og:title" content={@page_title} />
<% end %>
<%= if assigns[:page_description] do %>
  <meta property="og:description" content={@page_description} />
<% end %>
<%= if assigns[:og_image] do %>
  <meta property="og:image" content={static_url(@socket, @og_image)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
<% end %>
<meta property="og:type" content="website" />
<%= if assigns[:current_url] do %>
  <meta property="og:url" content={@current_url} />
<% end %>
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Twitter Card meta tags -->
<meta
  property="twitter:card"
  content={if assigns[:og_image], do: "summary_large_image", else: "summary"}
/>
<%= if assigns[:page_title] do %>
  <meta property="twitter:title" content={@page_title} />
<% end %>
<%= if assigns[:page_description] do %>
  <meta property="twitter:description" content={@page_description} />
<% end %>
<%= if assigns[:og_image] do %>
  <meta property="twitter:image" content={static_url(@socket, @og_image)} />
<% end %>

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>

<% css_path = static_path(@socket, "/assets/app.css") %>
<link rel="stylesheet" href={css_path} />

<%= if assigns[:show_ads] == true do %>
  <script
    data-ad-client="ca-pub-9538764634478220"
    async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"
  >
  </script>
<% end %>

<meta name="msvalidate.01" content="889EC413403DAE7D10C24068686129FA" />
