<!DOCTYPE html>
<html lang="de" class="h-full">
  <head>
    {render(MehrSchulferienWeb.LayoutView, "_head.html", assigns)}
  </head>
  <body class="min-h-full bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased">
    <main role="main">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        {render(MehrSchulferienWeb.LayoutView, "_logo.html", assigns)}
        {render(MehrSchulferienWeb.LayoutView, "_flash.html", assigns)}
        {@inner_content}
      </div>
    </main>

    {render(MehrSchulferienWeb.LayoutView, "_footer.html", assigns)}
  </body>
</html>
