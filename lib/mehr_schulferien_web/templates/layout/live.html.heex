<!DOCTYPE html>
<html lang="de" class="h-full">
  <head>
    {render("_head_live.html", assigns)}
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={static_path(@socket, "/assets/app.js")}
    >
    </script>
  </head>

  <body class="min-h-full bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased">
    <.navigation socket={@socket} today={Date.utc_today()} />

    <main role="main" class="container mx-auto py-8">
      {@inner_content}
    </main>

    {render("_footer_tailwind.html", assigns)}
  </body>
</html>
