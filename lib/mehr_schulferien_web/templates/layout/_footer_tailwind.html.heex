<footer class="bg-gradient-to-b from-gray-50 to-white border-t border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-12">
    <!-- Main container with consistent max-width -->
    <div class="max-w-7xl mx-auto">
      <!-- Disclaimer -->
      <div class="mb-8">
        <div class="bg-gray-100 rounded-lg p-4 text-center">
          <p class="text-gray-700 font-medium">Alle Angaben auf dieser Seite ohne Gewähr.</p>
        </div>
      </div>
      <!-- DSGVO Section -->
      <div class="mb-8">
        <.heading level={3} class="text-center text-lg mb-6">DSGVO und Cookies</.heading>
        <!-- Two column layout that stacks on mobile -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Left Column -->
          <div class="space-y-4">
            <!-- Analytics Info -->
            <div class="bg-blue-50 rounded-lg p-4">
              <div class="flex gap-3">
                <svg
                  class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <div class="min-w-0">
                  <.text variant="small" class="text-gray-700">
                    Diese Seite verwendet Google Analytics. Weitere Informationen finden Sie in der
                    <a
                      href="https://policies.google.com/privacy"
                      class="text-blue-600 hover:text-blue-700 underline"
                    >
                      Datenschutzerklärung
                    </a>
                    und den <a
                      href="http://tools.google.com/dlpage/gaoptout?hl=de"
                      class="text-blue-600 hover:text-blue-700 underline"
                    >
                      Opt-Out-Möglichkeiten</a>.
                  </.text>
                </div>
              </div>
            </div>
            <!-- Cookie Notice -->
            <div class="bg-amber-50 rounded-lg p-4">
              <div class="flex gap-3">
                <svg
                  class="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                <div class="min-w-0">
                  <.text variant="small" class="text-gray-700">
                    Diese Webseite verwendet Cookies, um Inhalte und Anzeigen zu personalisieren, Funktionen für soziale Medien anbieten zu können und die Zugriffe auf unsere Website zu analysieren.
                  </.text>
                </div>
              </div>
            </div>
          </div>
          <!-- Right Column - Nikolaus Notice -->
          <div>
            <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-4 border border-red-200 h-full">
              <div class="flex gap-3">
                <svg
                  class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M10 2a8 8 0 100 16 8 8 0 000-16zM8 7a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1zm1 4a1 1 0 100 2h2a1 1 0 100-2H9z" />
                </svg>
                <div class="min-w-0">
                  <p class="font-bold text-red-800 text-sm mb-2">
                    Wichtiger Hinweis zum Datenschutz:
                  </p>
                  <div class="space-y-2 text-sm text-red-700">
                    <p>
                      Weiterhin behalten wir uns vor alle Daten an den Nikolaus (a.k.a. Weihnachtsmann) zu verkaufen. Je nachdem wie gut Sie sich im laufenden Jahr verhalten haben, wird der Nikolaus Ihnen dann pünklich zum 06.12. den vor die Haustür gestellten Stiefel füllen.
                    </p>
                    <p class="italic pl-4 border-l-2 border-red-300">
                      Es hat sich in der Vergangenheit gezeigt, das es auch gut ist, wenn man zum Besuch des Nikolaus ein - möglichst schönes - Gedicht auswendig vortragen kann.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Footer Bottom -->
      <div class="border-t border-gray-200 pt-8">
        <div class="text-center space-y-4">
          <div class="text-sm text-gray-500">
            Version <%= ViewHelpers.version() %> · © 2025
            <a
              href="https://wintermeyer-consulting.de"
              class="text-gray-700 hover:text-gray-900 font-medium"
            >
              Wintermeyer Consulting
            </a>
            · All rights reserved.
          </div>

          <div class="flex flex-wrap justify-center gap-4">
            <%= link to: ~p"/impressum", class: "inline-flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              Impressum und Datenschutzerklärung
            <% end %>

            <%= link to: ~p"/developers", class: "inline-flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                />
              </svg>
              API für Entwickler
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
