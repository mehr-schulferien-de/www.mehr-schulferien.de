<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-yellow-100 dark:bg-yellow-900">
        <svg
          class="h-10 w-10 text-yellow-600 dark:text-yellow-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
      </div>
      <h2 class="mt-6 text-3xl font-extrabold text-gray-900 dark:text-gray-100">
        Bereits verarbeitet
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
        {@message}
      </p>
      <div class="mt-4 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <strong>Status:</strong>
          <%= case @status do %>
            <% "approved" -> %>
              <span class="text-green-600 dark:text-green-400">Genehmigt</span>
            <% "rejected" -> %>
              <span class="text-red-600 dark:text-red-400">Abgelehnt</span>
            <% _ -> %>
              <span>{@status}</span>
          <% end %>
        </p>
      </div>
      <div class="mt-8">
        <a
          href="/"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          Zur Startseite
        </a>
      </div>
    </div>
  </div>
</div>
