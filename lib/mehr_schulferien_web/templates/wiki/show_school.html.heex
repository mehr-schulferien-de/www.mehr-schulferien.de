<div class="max-w-4xl mx-auto py-6">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
      Schul-Wiki: <%= @school.name %>
    </h1>
    <p class="text-gray-600">
      Bearbeiten Sie die Adressdaten dieser Schule. Alle Änderungen werden protokolliert und können rückgängig gemacht werden.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Edit Form -->
    <div class="space-y-6">
      <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
          Adressdaten bearbeiten
        </h2>

        <%= if @limit_reached do %>
          <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-red-800 text-sm">
              <strong>Tageslimit erreicht:</strong>
              Es können heute keine weiteren Änderungen vorgenommen werden.
              Versuchen Sie es morgen erneut.
            </p>
          </div>
        <% end %>

        <%= render("_school_form.html",
          changeset: @changeset,
          action: Routes.wiki_path(@conn, :update_school, @school.slug),
          method: :post,
          limit_reached: @limit_reached,
          school_name: Map.get(@changeset.data, :name) || @school.name || "",
          address: @school.address,
          disable_zip_code: false,
          submit_text: "Änderungen speichern",
          submit_class: "bg-blue-600 hover:bg-blue-700",
          submit_focus_class: "focus:ring-blue-500"
        ) %>
      </div>
      <!-- Current Data Display -->
      <%= if @school.address do %>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-3">Aktuelle Daten</h3>
          <dl class="space-y-2 text-sm">
            <div>
              <dt class="font-bold text-gray-700">Schulname:</dt>
              <dd class="text-gray-900">
                <%= @school.name || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">Straße:</dt>
              <dd class="text-gray-900">
                <%= @school.address.street || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">PLZ:</dt>
              <dd class="text-gray-900">
                <%= @school.address.zip_code || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">Stadt:</dt>
              <dd class="text-gray-900">
                <%= @school.address.city || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">E-Mail:</dt>
              <dd class="text-gray-900">
                <%= @school.address.email_address || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">Telefon:</dt>
              <dd class="text-gray-900">
                <%= @school.address.phone_number || "Nicht angegeben" %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">Homepage:</dt>
              <dd class="text-gray-900">
                <%= if @school.address.homepage_url do %>
                  <a
                    href={@school.address.homepage_url}
                    target="_blank"
                    class="text-blue-600 hover:text-blue-800 underline"
                  >
                    <%= @school.address.homepage_url %>
                  </a>
                <% else %>
                  Nicht angegeben
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="font-bold text-gray-700">Wikipedia:</dt>
              <dd class="text-gray-900">
                <%= if @school.address.wikipedia_url do %>
                  <a
                    href={@school.address.wikipedia_url}
                    target="_blank"
                    class="text-blue-600 hover:text-blue-800 underline"
                  >
                    <%= @school.address.wikipedia_url %>
                  </a>
                <% else %>
                  Nicht angegeben
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      <% else %>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
          <h3 class="text-lg font-medium text-yellow-900 mb-2">Keine Adressdaten vorhanden</h3>
          <p class="text-sm text-yellow-800">
            Für diese Schule sind noch keine Adressdaten hinterlegt.
            Bitte tragen Sie die bekannten Informationen ein.
          </p>
        </div>
      <% end %>
    </div>
    <!-- Version History and Instructions -->
    <div class="space-y-6">
      <!-- Version History -->
      <div class="bg-white shadow-sm border border-gray-200 rounded-lg">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900 flex items-center justify-between">
            Versionshistorie
            <span class="text-sm font-normal text-gray-500">
              <%= length(@versions) %> Änderungen
            </span>
          </h2>
        </div>
        <div class="divide-y divide-gray-200 max-h-96 overflow-y-auto">
          <%= if @versions == [] do %>
            <div class="p-6 text-center text-gray-500">
              Noch keine Änderungen vorhanden.
            </div>
          <% else %>
            <%= for version <- @display_versions do %>
              <div class="p-4 hover:bg-gray-50">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">
                      Version #<%= version.id %>
                    </p>
                    <p class="text-xs text-gray-500 mt-1">
                      <%= format_version_date(version) %> • <%= format_originator(version) %>
                    </p>
                    <p class="text-sm text-gray-700 mt-2">
                      <%= version_summary(version, @versions) %>
                    </p>
                  </div>
                  <%= if version.id != List.first(@versions).id do %>
                    <%= form_for %{}, Routes.wiki_path(@conn, :rollback_school, @school.slug, version.id), [method: :post, class: "inline"], fn _f -> %>
                      <%= submit("Wiederherstellen",
                        class:
                          "ml-4 px-3 py-1 text-xs font-medium rounded-md text-yellow-700 bg-yellow-100 hover:bg-yellow-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500",
                        onclick:
                          "return confirm('Sind Sie sicher, dass Sie zu dieser Version zurückkehren möchten?')"
                      ) %>
                    <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= if length(@versions) > 5 do %>
              <div class="p-4 text-center">
                <p class="text-sm text-gray-500">
                  Zeige die letzten 5 von <%= length(@versions) %> Änderungen
                </p>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= render("_daily_limit_info.html", daily_changes: @daily_changes) %>
    </div>
  </div>
  <!-- Back to School Link -->
  <div class="mt-8 text-center">
    <a
      href={"/ferien/d/schule/#{@school.slug}"}
      class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
    >
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>
      Zurück zur Schulseite
    </a>
  </div>
  <!-- Delete School Section -->
  <div class="mt-12 border-t border-gray-200 pt-8">
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <h3 class="text-lg font-medium text-red-900 mb-2">
        Gefahrenzone
      </h3>
      <p class="text-sm text-red-700 mb-4">
        Das Löschen einer Schule kann nicht rückgängig gemacht werden. Alle zugehörigen Daten werden in eine Backup-Tabelle verschoben.
      </p>
      <%= form_for @conn, Routes.wiki_path(@conn, :delete_school, @school.slug), [method: :delete, class: "inline", id: "delete-school-form"], fn _f -> %>
        <button
          type="submit"
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
          onclick={"return confirmSchoolDeletion('#{@school.name}');"}
        >
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
          Schule löschen
        </button>
      <% end %>
    </div>
  </div>
</div>

<script>
  function confirmSchoolDeletion(schoolName) {
    return confirm('Sind Sie sicher, dass Sie die Schule "' + schoolName + '" wirklich löschen wollen?\n\nDiese Aktion kann nicht rückgängig gemacht werden!');
  }
</script>
