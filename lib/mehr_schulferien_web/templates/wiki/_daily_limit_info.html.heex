<div class="bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 rounded-lg p-4">
  <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100 mb-2">Tageslimit</h3>
  <div class="space-y-2 text-sm">
    <p class="text-gray-600 dark:text-gray-400">
      Zum Schutz vor Missbrauch gibt es ein Tageslimit von {MehrSchulferien.Config.daily_change_limit()} Änderungen.
    </p>
    <div class="flex items-center justify-between">
      <span class="text-gray-600 dark:text-gray-400">Heutige Änderungen:</span>
      <span class={"font-medium #{if @daily_changes >= MehrSchulferien.Config.daily_change_limit(), do: "text-red-600 dark:text-red-400", else: "text-gray-900 dark:text-gray-100"}"}>
        {@daily_changes} / {MehrSchulferien.Config.daily_change_limit()}
      </span>
    </div>
    <div class="mt-2">
      <div class="bg-gray-200 dark:bg-gray-700 rounded-full h-2">
        <div
          class={"h-2 rounded-full #{if @daily_changes >= MehrSchulferien.Config.daily_change_limit(), do: "bg-red-600 dark:bg-red-500", else: "bg-green-600 dark:bg-green-500"}"}
          style={"width: #{min(@daily_changes / MehrSchulferien.Config.daily_change_limit() * 100, 100)}%"}
        >
        </div>
      </div>
    </div>
  </div>
</div>
