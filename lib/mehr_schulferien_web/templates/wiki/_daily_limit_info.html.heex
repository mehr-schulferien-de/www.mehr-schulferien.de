<div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
  <.heading level={3} class="text-lg mb-3">Tageslimit</.heading>
  <div class="space-y-2 text-sm">
    <.text class="text-gray-700">
      Zum Schutz vor Missbrauch gibt es ein Tageslimit von <%= MehrSchulferien.Config.daily_change_limit() %> Änderungen.
    </.text>
    <div class="flex items-center justify-between">
      <span class="text-gray-600">Heutige Änderungen:</span>
      <span class={"font-semibold #{if @daily_changes >= MehrSchulferien.Config.daily_change_limit(), do: "text-red-600", else: "text-gray-900"}"}>
        <%= @daily_changes %> / <%= MehrSchulferien.Config.daily_change_limit() %>
      </span>
    </div>
    <div class="mt-2">
      <div class="bg-gray-200 rounded-full h-2">
        <div
          class={"h-2 rounded-full #{if @daily_changes >= MehrSchulferien.Config.daily_change_limit(), do: "bg-red-600", else: "bg-green-600"}"}
          style={"width: #{min(@daily_changes, 100)}%"}
        >
        </div>
      </div>
    </div>
  </div>
</div>
