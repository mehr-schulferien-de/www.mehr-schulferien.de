<%= form_for @changeset, "#", [as: :address, phx_submit: assigns[:submit_event] || "update_school", phx_change: "validate", class: "space-y-4"], fn f -> %>
  <div>
    {label(f, :name, "Schulname *",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {text_input(f, :name,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. Max-Mustermann-Gymnasium",
      value: @school_name,
      autofocus: true,
      required: true,
      name: "name",
      phx_debounce: "500"
    )}
    {error_tag(f, :name, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :street, "Straße *",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {text_input(f, :street,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. Musterstraße 123",
      value: get_field_value(f, :street, @address),
      required: true,
      name: "address[street]"
    )}
    {error_tag(f, :street, class: "mt-1 text-sm text-red-600")}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <div class="flex items-center justify-between mb-1">
        {label(f, :zip_code, "PLZ *",
          class: "text-sm font-medium text-gray-700 dark:text-gray-300"
        )}
        <%= if assigns[:existing_schools] && length(assigns[:existing_schools]) > 0 do %>
          <a
            href="#existing-schools"
            class="text-xs text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 flex items-center gap-1"
          >
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
            {length(assigns[:existing_schools])} {if length(assigns[:existing_schools]) == 1,
              do: "Schule vorhanden",
              else: "Schulen vorhanden"}
          </a>
        <% end %>
      </div>
      <%= text_input(f, :zip_code,
        class:
          "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
        disabled: @limit_reached || @disable_zip_code,
        placeholder: "z.B. 12345",
        value: get_field_value(f, :zip_code, @address),
        required: true,
        pattern: "[0-9]<%= 5}",
        title: "Bitte geben Sie eine gültige 5-stellige deutsche Postleitzahl ein",
        name: "address[zip_code]",
        phx_debounce: "500"
      ) %>
      {error_tag(f, :zip_code, class: "mt-1 text-sm text-red-600")}
      <%= if assigns[:zip_code_valid] == false do %>
        <p class="mt-1 text-sm text-red-600">Diese Postleitzahl wurde nicht gefunden.</p>
      <% end %>
    </div>

    <div>
      {label(f, :city, "Stadt *",
        class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
      )}
      {text_input(f, :city,
        class:
          "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
        disabled: @limit_reached,
        placeholder: "z.B. Berlin",
        value:
          get_field_value(f, :city, @address) ||
            (assigns[:city_from_zip] && assigns[:city_from_zip].name) || "",
        required: true,
        name: "address[city]"
      )}
      {error_tag(f, :city, class: "mt-1 text-sm text-red-600")}
    </div>
  </div>

  <div>
    {label(f, :email_address, "E-Mail",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {email_input(f, :email_address,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. info@schule.de",
      value: get_field_value(f, :email_address, @address),
      name: "address[email_address]"
    )}
    {error_tag(f, :email_address, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :phone_number, "Telefon",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {text_input(f, :phone_number,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. +49 30 123456789",
      value: get_field_value(f, :phone_number, @address),
      name: "address[phone_number]"
    )}
    {error_tag(f, :phone_number, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :homepage_url, "Homepage",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {url_input(f, :homepage_url,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. https://www.schule.de (optional)",
      value: get_field_value(f, :homepage_url, @address),
      name: "address[homepage_url]"
    )}
    {error_tag(f, :homepage_url, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :wikipedia_url, "Wikipedia",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {url_input(f, :wikipedia_url,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. https://de.wikipedia.org/wiki/Beispiel-Schule",
      value: get_field_value(f, :wikipedia_url, @address),
      name: "address[wikipedia_url]"
    )}
    {error_tag(f, :wikipedia_url, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :instagram_url, "Instagram",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {url_input(f, :instagram_url,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. https://www.instagram.com/schulename",
      value: get_field_value(f, :instagram_url, @address),
      name: "address[instagram_url]"
    )}
    {error_tag(f, :instagram_url, class: "mt-1 text-sm text-red-600")}
  </div>

  <div>
    {label(f, :schuelerzeitung_url, "Schülerzeitung",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {url_input(f, :schuelerzeitung_url,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder: "z.B. https://schuelerzeitung.schule.de",
      value: get_field_value(f, :schuelerzeitung_url, @address),
      name: "address[schuelerzeitung_url]"
    )}
    {error_tag(f, :schuelerzeitung_url, class: "mt-1 text-sm text-red-600")}
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      URL der Schülerzeitung, falls vorhanden.
    </p>
  </div>

  <div>
    {label(f, :description, "Beschreibung",
      class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
    )}
    {textarea(f, :description,
      class:
        "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
      disabled: @limit_reached,
      placeholder:
        "z.B. Humanistisches Gymnasium mit Schwerpunkt auf Sprachen und Naturwissenschaften...",
      value: get_field_value(f, :description, @address),
      name: "address[description]",
      rows: 4
    )}
    {error_tag(f, :description, class: "mt-1 text-sm text-red-600")}
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      Eine kurze Beschreibung der Schule, ihrer Schwerpunkte und Besonderheiten.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      {label(f, :students_count, "Schülerzahl",
        class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
      )}
      {number_input(f, :students_count,
        class:
          "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
        disabled: @limit_reached,
        placeholder: "z.B. 570",
        value: get_field_value(f, :students_count, @address),
        name: "address[students_count]",
        min: 1,
        max: 10000
      )}
      {error_tag(f, :students_count, class: "mt-1 text-sm text-red-600")}
    </div>

    <div>
      {label(f, :founded_year, "Gründungsjahr",
        class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1"
      )}
      {number_input(f, :founded_year,
        class:
          "mt-1 block w-full rounded-md border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-gray-100",
        disabled: @limit_reached,
        placeholder: "z.B. 1850",
        value: get_field_value(f, :founded_year, @address),
        name: "address[founded_year]",
        min: 1200,
        max: Date.utc_today().year
      )}
      {error_tag(f, :founded_year, class: "mt-1 text-sm text-red-600")}
    </div>
  </div>

  <div class="pt-4">
    {submit(@submit_text,
      class:
        "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white #{@submit_class} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800 #{@submit_focus_class} disabled:opacity-50 disabled:cursor-not-allowed",
      disabled: @limit_reached
    )}
  </div>
<% end %>
