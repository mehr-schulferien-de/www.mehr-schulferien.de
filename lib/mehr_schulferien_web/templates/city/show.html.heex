<div class="mt-6 sm:mt-8">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4">
      <.heading level={1}>
        <span class="block">Schulferien {@city.name}</span>
        <span class="block sm:inline sm:ml-1 text-lg sm:text-2xl font-normal text-gray-600 dark:text-gray-400">
          {link(@federal_state.name,
            to: ~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}",
            class:
              "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 cursor-pointer"
          )}
        </span>
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@federal_state}
        location_type={:federal_state}
        years_with_data={@years_with_data}
        year={@current_year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <.periods_table
                periods={@periods}
                all_periods={@all_periods}
                today={@today}
                current_year={@current_year}
              />
              <.partial_data
                periods={@periods}
                federal_state={@federal_state}
                city={@city}
                year={@current_year}
              />
            <% else %>
              <.no_data
                conn={@conn}
                country={@country}
                federal_state={@federal_state}
                city={@city}
                year={@current_year}
                years_with_data={@years_with_data}
              />
            <% end %>
            <%= if @has_data do %>
              <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mt-4">
                <div>
                  <div class="text-sm font-medium text-gray-900 dark:text-gray-100 mb-1 flex items-center">
                    <svg
                      class="w-4 h-4 mr-2 text-gray-600 dark:text-gray-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    iCal Download
                  </div>
                  <.text variant="muted" class="mb-3">
                    Importieren Sie die Schulferien direkt in Ihren Kalender.
                  </.text>
                  <div class="grid grid-cols-2 gap-2">
                    <%= link to: "/api/v2.1/cities/#{@city.slug}/icalendar?vacation_types=school&year=#{@current_year}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 rounded-md transition-colors",
                        download: "schulferien-#{@city.slug}-#{@current_year}.ics" do %>
                      📅 {@current_year}
                    <% end %>
                    <%= link to: "/api/v2.1/cities/#{@city.slug}/icalendar?vacation_types=school&year=#{@current_year + 1}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 border border-gray-300 dark:border-gray-600 rounded-md transition-colors",
                        download: "schulferien-#{@city.slug}-#{@current_year + 1}.ics" do %>
                      📅 {@current_year + 1}
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </:content>
        </.card>
      </div>
      <div class="lg:w-1/3">
        <!-- Unified City Information Card -->
        <.card padding="p-0" class="overflow-hidden">
          <:content>
            <!-- Header -->
            <div class="bg-gray-50 dark:bg-gray-800 px-4 py-3 border-b border-gray-200 dark:border-gray-700">
              <.heading level={2} class="text-lg m-0">Stadtinformationen</.heading>
            </div>

            <div class="p-4 space-y-4">
              <!-- Location Information -->
              <div class="space-y-3">
                <!-- Address -->
                <div class="flex items-start">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-gray-400 dark:text-gray-500 mt-0.5 mr-3 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <div class="text-sm flex-1">
                    <div class="font-medium text-gray-900 dark:text-gray-100">{@city.name}</div>
                    <div class="text-gray-600 dark:text-gray-400">
                      <%= if Enum.any?(@city.zip_codes) do %>
                        {hd(@city.zip_codes).value} {@city.name}<br />
                      <% end %>
                      {@federal_state.name}, {@country.name}
                    </div>
                    <% map_query =
                      "#{@city.name}, #{@federal_state.name}, #{@country.name}" %>
                    <div class="flex flex-wrap gap-2 mt-1">
                      <%= link to: MehrSchulferienWeb.Helpers.UrlHelpers.google_maps_url(map_query),
                          class: "inline-flex items-center text-xs text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300",
                          target: "_blank",
                          rel: "noopener noreferrer" do %>
                        <svg
                          class="w-3 h-3 mr-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        Google Maps
                      <% end %>
                      <%= if @is_apple_device do %>
                        <%= link to: MehrSchulferienWeb.Helpers.UrlHelpers.apple_maps_url(map_query),
                            class: "inline-flex items-center text-xs text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300",
                            target: "_blank",
                            rel: "noopener noreferrer" do %>
                          <svg
                            class="w-3 h-3 mr-1"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                          </svg>
                          Apple Maps
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Key Facts (if any schools available) -->
              <%= if length(@schools) > 0 do %>
                <div class="pt-3 border-t border-gray-100 dark:border-gray-700">
                  <!-- Mobile: Just show count -->
                  <div class="text-sm text-gray-600 dark:text-gray-400 lg:hidden">
                    <a href="#faq" class="hover:text-blue-600 dark:hover:text-blue-400">
                      <span class="text-gray-500 dark:text-gray-400">
                        {Gettext.ngettext(
                          MehrSchulferienWeb.Gettext,
                          "Schule:",
                          "Schulen:",
                          length(@schools)
                        )}
                      </span>
                      <span class="font-medium">{length(@schools)}</span>
                    </a>
                  </div>
                  <!-- Desktop: Show school list -->
                  <div class="hidden lg:block">
                    <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">
                      <a href="#faq" class="hover:text-blue-600 dark:hover:text-blue-400">
                        <span class="text-gray-500 dark:text-gray-400">
                          {Gettext.ngettext(
                            MehrSchulferienWeb.Gettext,
                            "Schule:",
                            "Schulen:",
                            length(@schools)
                          )}
                        </span>
                        <span class="font-medium">{length(@schools)}</span>
                      </a>
                    </div>
                    <div
                      class="max-h-64 overflow-y-auto border border-gray-200 dark:border-gray-700 rounded-md bg-gray-50 dark:bg-gray-800 p-2"
                      style="scrollbar-width: thin; scrollbar-color: #9ca3af #f3f4f6;"
                      tabindex="0"
                      role="region"
                      aria-label="Liste der Schulen"
                    >
                      <ul class="space-y-1">
                        <%= for school <- Enum.sort_by(@schools, & &1.name) do %>
                          <li class="text-xs py-0.5">
                            <%= link to: ~p"/ferien/#{@country.slug}/schule/#{school.slug}",
                                class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 hover:underline block" do %>
                              {school.name}
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                    <!-- Scroll hint -->
                    <%= if length(@schools) > 12 do %>
                      <div class="text-xs text-gray-500 dark:text-gray-400 mt-1 text-center">
                        ↓ Scrollen für weitere Schulen
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </:content>
        </.card>
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-2">
          Kalenderansicht
        </.heading>

        <.calendar_legend />

        <.heading level={3} class="text-lg text-gray-700 dark:text-gray-300 mt-4 mb-3">
          {@current_year}
        </.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@current_year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <div class="mt-8">
        <.heading level={3} class="text-lg text-gray-700 mb-3">{@next_year}</.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@next_year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <.faq
        conn={@conn}
        country={@country}
        federal_state={@federal_state}
        city={@city}
        location={@city}
        next_schoolday={ViewHelpers.next_schoolday(@public_periods ++ @periods)}
        current_year={@current_year}
        today={@today}
        school_periods={@periods}
        public_periods={@public_periods}
        months={MehrSchulferienWeb.Helpers.MonthHelpers.months_map()}
        schools={@schools}
      />
    <% end %>

    <.schema_org_event
      periods={@periods}
      city={@city}
      federal_state={@federal_state}
      country={@country}
    />
    <!-- Developer Section -->
    <.developer_section
      location_name={@city.name}
      location_slug={@city.slug}
      location_type="city"
    />
  </div>
</div>
