<div class="mt-0 sm:mt-1">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4 mt-4 sm:mt-6">
      <.heading level={1} class="text-left">
        <span class="block">Schulferien <%= @city.name %></span>
        <span class="block sm:inline sm:ml-1 text-lg sm:text-2xl font-normal text-gray-600">
          <%= link(@federal_state.name,
            to: ~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}",
            class: "text-blue-600 hover:text-blue-800 cursor-pointer"
          ) %>
        </span>
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@federal_state}
        location_type={:federal_state}
        years_with_data={@years_with_data}
        year={@current_year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <.periods_table
                periods={@periods}
                all_periods={@all_periods}
                today={@today}
                current_year={@current_year}
              />
              <.partial_data
                periods={@periods}
                federal_state={@federal_state}
                city={@city}
                year={@current_year}
              />
            <% else %>
              <.no_data
                conn={@conn}
                country={@country}
                federal_state={@federal_state}
                city={@city}
                year={@current_year}
                years_with_data={@years_with_data}
              />
            <% end %>
            <!-- iCal Export Box -->
            <%= if @has_data do %>
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mt-4">
                <div>
                  <.heading
                    level={3}
                    class="text-sm font-medium text-gray-900 mb-1 flex items-center"
                  >
                    <svg
                      class="w-4 h-4 mr-2 text-gray-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    iCal Download
                  </.heading>
                  <.text variant="muted" class="mb-3">
                    Importieren Sie die Schulferien direkt in Ihren Kalender.
                  </.text>
                  <div class="grid grid-cols-2 gap-2">
                    <% api_version = "v2.1" %>
                    <%= link to: "/api/#{api_version}/locations/#{@city.slug}/icalendar?vacation_types=school&year=#{@current_year}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-100 border border-gray-300 rounded-md transition-colors",
                        download: "schulferien-#{@city.slug}-#{@current_year}.ics" do %>
                      📅 <%= @current_year %>
                    <% end %>
                    <%= link to: "/api/#{api_version}/locations/#{@city.slug}/icalendar?vacation_types=school&year=#{@current_year + 1}",
                        class: "flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-100 border border-gray-300 rounded-md transition-colors",
                        download: "schulferien-#{@city.slug}-#{@current_year + 1}.ics" do %>
                      📅 <%= @current_year + 1 %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </:content>
        </.card>
      </div>
      <div class="lg:w-1/3">
        <!-- Unified City Information Card -->
        <.card padding="p-0" class="overflow-hidden">
          <:content>
            <!-- Header -->
            <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
              <.heading level={2} class="text-lg m-0">Stadtinformationen</.heading>
            </div>

            <div class="p-4 space-y-4">
              <!-- Location Information -->
              <div class="space-y-3">
                <!-- Address -->
                <div class="flex items-start">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-gray-400 mt-0.5 mr-3 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <div class="text-sm flex-1">
                    <div class="font-medium text-gray-900"><%= @city.name %></div>
                    <div class="text-gray-600">
                      <%= if Enum.any?(@city.zip_codes) do %>
                        <%= hd(@city.zip_codes).value %> <%= @city.name %><br />
                      <% end %>
                      <%= @federal_state.name %>, <%= @country.name %>
                    </div>
                    <% map_query =
                      "#{@city.name}, #{@federal_state.name}, #{@country.name}" %>
                    <div class="flex flex-wrap gap-2 mt-1">
                      <%= link to: MehrSchulferienWeb.Helpers.UrlHelpers.google_maps_url(map_query),
                          class: "inline-flex items-center text-xs text-blue-600 hover:text-blue-800",
                          target: "_blank",
                          rel: "noopener noreferrer" do %>
                        <svg
                          class="w-3 h-3 mr-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        Google Maps
                      <% end %>
                      <%= if @is_apple_device do %>
                        <%= link to: MehrSchulferienWeb.Helpers.UrlHelpers.apple_maps_url(map_query),
                            class: "inline-flex items-center text-xs text-blue-600 hover:text-blue-800",
                            target: "_blank",
                            rel: "noopener noreferrer" do %>
                          <svg
                            class="w-3 h-3 mr-1"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                            />
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                            />
                          </svg>
                          Apple Maps
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Key Facts (if any schools available) -->
              <%= if length(@schools) > 0 do %>
                <div class="pt-3 border-t border-gray-100">
                  <!-- Mobile: Just show count -->
                  <div class="text-sm text-gray-600 lg:hidden">
                    <span class="text-gray-500">Schulen:</span>
                    <span class="font-medium"><%= length(@schools) %></span>
                  </div>
                  <!-- Desktop: Show school list -->
                  <div class="hidden lg:block">
                    <div class="text-sm text-gray-600 mb-2">
                      <span class="text-gray-500">Schulen:</span>
                      <span class="font-medium"><%= length(@schools) %></span>
                    </div>
                    <!-- School list sorted by name -->
                    <div
                      class="max-h-64 overflow-y-auto border border-gray-200 rounded-md bg-gray-50 p-2"
                      style="scrollbar-width: thin; scrollbar-color: #9ca3af #f3f4f6;"
                    >
                      <ul class="space-y-1">
                        <%= for school <- Enum.sort_by(@schools, & &1.name) do %>
                          <li class="text-xs py-0.5">
                            <%= link to: ~p"/ferien/#{@country.slug}/schule/#{school.slug}",
                                class: "text-blue-600 hover:text-blue-800 hover:underline block" do %>
                              <%= school.name %>
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                    <!-- Scroll hint -->
                    <%= if length(@schools) > 12 do %>
                      <div class="text-xs text-gray-500 mt-1 text-center">
                        ↓ Scrollen für weitere Schulen
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </:content>
        </.card>
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-2">
          Kalenderansicht
        </.heading>

        <.calendar_legend />

        <.heading level={3} class="text-lg text-gray-700 mt-4 mb-3">
          <%= @current_year %>
        </.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@current_year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <div class="mt-8">
        <.heading level={3} class="text-lg text-gray-700 mb-3"><%= @next_year %></.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- 1..12 do %>
            <.month_calendar
              month={month}
              year={@next_year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
            />
          <% end %>
        </div>
      </div>

      <% # Use DateCalculations helper for date calculations
      date_data = MehrSchulferienWeb.Helpers.DateCalculations.calculate_surrounding_dates(@today)
      yesterday = date_data.yesterday
      tomorrow = date_data.tomorrow
      day_after_tomorrow = date_data.day_after_tomorrow

      # Use PeriodHelpers for filtering periods
      yesterdays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, yesterday)

      todays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, @today)

      tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, tomorrow)

      day_after_tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          @periods,
          day_after_tomorrow
        )

      # Find public holiday periods for specific days
      public_holidays =
        MehrSchulferienWeb.Helpers.PeriodHelpers.public_holiday_periods(@public_periods)

      yesterdays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          yesterday
        )

      todays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, @today)

      tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, tomorrow)

      day_after_tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          day_after_tomorrow
        ) %>

      <.faq
        conn={@conn}
        country={@country}
        federal_state={@federal_state}
        city={@city}
        location={@city}
        next_schoolday={ViewHelpers.next_schoolday(@public_periods ++ @periods)}
        current_year={@current_year}
        today={@today}
        yesterday={yesterday}
        tomorrow={tomorrow}
        day_after_tomorrow={day_after_tomorrow}
        school_periods={@periods}
        public_periods={@public_periods}
        months={MehrSchulferienWeb.Helpers.MonthHelpers.months_map()}
        yesterdays_school_free_periods={yesterdays_school_free_periods}
        todays_school_free_periods={todays_school_free_periods}
        tomorrows_school_free_periods={tomorrows_school_free_periods}
        day_after_tomorrows_school_free_periods={day_after_tomorrows_school_free_periods}
        yesterdays_public_holiday_periods={yesterdays_public_holiday_periods}
        todays_public_holiday_periods={todays_public_holiday_periods}
        tomorrows_public_holiday_periods={tomorrows_public_holiday_periods}
        day_after_tomorrows_public_holiday_periods={day_after_tomorrows_public_holiday_periods}
        schools={@schools}
      />
    <% end %>

    <.schema_org_event
      periods={@periods}
      city={@city}
      federal_state={@federal_state}
      country={@country}
    />
    <!-- Developer Section -->
    <div class="mt-12 border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <.heading level={2} class="text-2xl text-center mb-8">
          Für Entwickler
        </.heading>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- WordPress Plugin Card -->
          <.card variant="enhanced" padding="p-6">
            <:content>
              <div class="flex items-start">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-blue-600 mr-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                  />
                </svg>
                <div>
                  <.heading level={3} class="text-lg mb-2">
                    WordPress Plugin
                  </.heading>
                  <.text variant="small" class="text-gray-700 mb-4">
                    Integrieren Sie die Schulferien von <%= @city.name %> direkt in Ihre WordPress-Website mit unserem kostenlosen Plugin.
                  </.text>

                  <div class="bg-gray-50 border border-gray-200 rounded-md p-3 mb-4 font-mono text-xs break-all">
                    [schulferien location_type="city" location="<%= @city.slug %>" display="table"]
                  </div>

                  <a
                    href="https://github.com/mehr-schulferien-de/mehr-schulferien-wordpress-plugin"
                    class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 mr-1"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                    Plugin auf GitHub ansehen
                  </a>
                </div>
              </div>
            </:content>
          </.card>
          <!-- API Access Card -->
          <.card variant="enhanced" padding="p-6">
            <:content>
              <div class="flex items-start">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-8 w-8 text-green-600 mr-4 flex-shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                <div>
                  <.heading level={3} class="text-lg mb-2">
                    API Zugriff
                  </.heading>
                  <.text variant="small" class="text-gray-700 mb-4">
                    Nutzen Sie unsere REST API, um Feriendaten in Ihre eigenen Anwendungen zu integrieren.
                  </.text>

                  <div class="space-y-2">
                    <div class="bg-gray-50 border border-gray-200 rounded-md p-3 font-mono text-xs break-all">
                      GET /api/v2.1/locations/<%= @city.slug %>/icalendar
                    </div>
                    <div class="bg-gray-50 border border-gray-200 rounded-md p-3 font-mono text-xs break-all">
                      GET /api/v2.1/locations/<%= @city.slug %>/periods
                    </div>
                  </div>

                  <.text variant="muted" class="mt-3">
                    Die API liefert Daten im JSON- und iCal-Format.
                  </.text>
                </div>
              </div>
            </:content>
          </.card>
        </div>
        <!-- Open Source Contribution -->
        <div class="mt-8">
          <MehrSchulferienWeb.Components.GitHubPromotionComponent.github_promotion
            locale="de"
            wrapper_class="bg-gray-50 rounded-lg px-6 py-8 sm:px-8"
          />
        </div>
      </div>
    </div>
  </div>
</div>
