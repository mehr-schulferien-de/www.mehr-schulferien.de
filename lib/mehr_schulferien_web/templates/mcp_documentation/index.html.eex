          <h3 class="text-lg font-medium text-gray-900 mb-2">Major Cities</h3>
          <ul class="space-y-1 text-sm">
            <li><code class="bg-gray-100 px-2 py-1 rounded">muenchen</code> - Munich</li>
            <li><code class="bg-gray-100 px-2 py-1 rounded">berlin</code> - Berlin</li>
