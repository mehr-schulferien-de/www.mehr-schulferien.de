        <div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">Location Types</h3>
          <ul class="space-y-1 text-sm">
            <li><code class="bg-gray-100 px-2 py-1 rounded">country</code> - Country level</li>
            <li><code class="bg-gray-100 px-2 py-1 rounded">federal_state</code> - Federal state level</li>
            <li><code class="bg-gray-100 px-2 py-1 rounded">county</code> - County level</li>
            <li><code class="bg-gray-100 px-2 py-1 rounded">city</code> - City level</li>
            <li><code class="bg-gray-100 px-2 py-1 rounded">school</code> - School level</li>
