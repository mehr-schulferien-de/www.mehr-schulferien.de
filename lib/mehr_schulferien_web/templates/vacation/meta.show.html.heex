<% # Generate SEO-optimized meta tags for vacation-specific pages

# Create date range string
date_range =
  if @vacation_period do
    "#{Calendar.strftime(@vacation_period.starts_on, "%d.%m.")}-#{Calendar.strftime(@vacation_period.ends_on, "%d.%m.%Y")}"
  else
    ""
  end

# Create duration string
duration =
  if @vacation_period do
    days = Date.diff(@vacation_period.ends_on, @vacation_period.starts_on) + 1
    "#{days} Tage"
  else
    ""
  end

# Generate vacation-specific keywords
vacation_keywords =
  case @vacation_type do
    "sommerferien" -> "Sommerurlaub, Familienurlaub, Schulferien Sommer"
    "osterferien" -> "Osterurlaub, Frühlingsferien, Osterausflug"
    "herbstferien" -> "Herbsturlaub, Wanderurlaub, Herbstausflug"
    "weihnachtsferien" -> "Weihnachtsurlaub, Winterurlaub, Silvesterurlaub"
    "winterferien" -> "Skiurlaub, Winterurlaub, Skiferien"
    "pfingstferien" -> "Pfingsturlaub, Kurzurlaub, verlängertes Wochenende"
    _ -> "Schulferien, Urlaub"
  end %>

<title>
  <%= @vacation_name %> <%= @federal_state.name %> <%= @year %> | <%= date_range %> - mehr-schulferien.de
</title>
<meta
  name="description"
  content={
    dynamic_vacation_description(
      @vacation_name,
      @year,
      @federal_state.name,
      @vacation_period,
      @today
    )
  }
/>
<meta
  name="keywords"
  content={"#{@vacation_name} #{@federal_state.name} #{@year}, #{@vacation_name} #{@federal_state.name}, #{vacation_keywords}, #{@federal_state.name} Ferien #{@year}, Ferientermine #{@federal_state.name}"}
/>

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta
  property="og:url"
  content={Routes.vacation_url(@conn, :show, @vacation_type, @federal_state.slug, @year)}
/>
<meta
  property="og:title"
  content={"#{@vacation_name} #{@federal_state.name} #{@year} - #{date_range}"}
/>
<meta
  property="og:description"
  content={"#{@vacation_name} #{@year} in #{@federal_state.name}: #{date_range} (#{duration}). Planen Sie Ihren Urlaub mit allen Ferienterminen."}
/>
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta
  property="twitter:url"
  content={Routes.vacation_url(@conn, :show, @vacation_type, @federal_state.slug, @year)}
/>
<meta property="twitter:title" content={"#{@vacation_name} #{@federal_state.name} #{@year}"} />
<meta
  property="twitter:description"
  content={"#{date_range} (#{duration}) - Alle Infos zu #{@vacation_name} #{@year} in #{@federal_state.name}."}
/>
<!-- Canonical URL to prevent duplicate content -->
<link
  rel="canonical"
  href={Routes.vacation_url(@conn, :show, @vacation_type, @federal_state.slug, @year)}
/>
<!-- Pagination for year navigation -->
<% prev_year = @year - 1 %>
<% next_year = @year + 1 %>
<%= if prev_year >= 2020 do %>
  <link
    rel="prev"
    href={Routes.vacation_url(@conn, :show, @vacation_type, @federal_state.slug, prev_year)}
  />
<% end %>
<%= if next_year <= 2030 do %>
  <link
    rel="next"
    href={Routes.vacation_url(@conn, :show, @vacation_type, @federal_state.slug, next_year)}
  />
<% end %>
<!-- Structured Data -->
<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: "Deutschland", item: "https://www.mehr-schulferien.de/ferien/d"},
    %{name: @federal_state.name, item: "https://www.mehr-schulferien.de" <> Routes.federal_state_path(@conn, :show, @country.slug, @federal_state.slug)},
    %{name: "#{@vacation_name} #{@year}", item: "https://www.mehr-schulferien.de" <> Routes.vacation_path(@conn, :show, @vacation_type, @federal_state.slug, @year)}
  ]) %>
</script>

<%= if @vacation_period do %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "<%= @vacation_name %> <%= @federal_state.name %> <%= @year %>",
      "startDate": "<%= @vacation_period.starts_on %>",
      "endDate": "<%= @vacation_period.ends_on %>",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      "location": {
        "@type": "Place",
        "name": "<%= @federal_state.name %>",
        "address": {
          "@type": "PostalAddress",
          "addressRegion": "<%= @federal_state.name %>",
          "addressCountry": "DE"
        }
      },
      "description": "<%= @vacation_name %> in <%= @federal_state.name %> vom <%= Calendar.strftime(@vacation_period.starts_on, "%d.%m.%Y") %> bis <%= Calendar.strftime(@vacation_period.ends_on, "%d.%m.%Y") %>. Schulfreie Zeit für alle Schüler in <%= @federal_state.name %>.",
      "organizer": {
        "@type": "Organization",
        "name": "Kultusministerium <%= @federal_state.name %>"
      }
    }
  </script>
<% end %>
