<% # Generate dynamic meta description
meta_description =
  MehrSchulferienWeb.VacationHelpers.dynamic_vacation_description(
    @vacation_name,
    @year,
    @federal_state.name,
    @vacation_period,
    @today
  )

# Generate handwritten image meta tags if we have vacation data
handwritten_meta_tags =
  if @vacation_period do
    MehrSchulferienWeb.Helpers.HandwrittenDateImage.meta_tags(
      @conn,
      @vacation_period,
      @vacation_name,
      @federal_state.name,
      @year,
      @all_periods
    )
  else
    []
  end %>

<title>{@page_title}</title>
<meta name="description" content={meta_description} />
<meta
  name="keywords"
  content={"#{@vacation_name} #{@year}, #{@vacation_name} #{@federal_state.name}, Schulferien #{@federal_state.name} #{@year}, Ferientermine, Kalender"}
/>
<link
  rel="canonical"
  href={"https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}"}
/>

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta
  property="og:url"
  content={"https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}"}
/>
<meta property="og:title" content={@page_title} />
<meta property="og:description" content={meta_description} />
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Handwritten Date Image -->
<%= for {name, content} <- handwritten_meta_tags do %>
  <meta property={name} content={content} />
<% end %>
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta
  property="twitter:url"
  content={"https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}"}
/>
<meta property="twitter:title" content={@page_title} />
<meta property="twitter:description" content={meta_description} />
<!-- Breadcrumb Navigation -->
<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: "Startseite", item: "https://www.mehr-schulferien.de"},
    %{name: "Ferien Deutschland", item: "https://www.mehr-schulferien.de/ferien/deutschland"},
    %{name: "#{@federal_state.name}", item: "https://www.mehr-schulferien.de/ferien/deutschland/bundesland/#{@federal_state.slug}"},
    %{name: "#{@vacation_name} #{@year}", item: "https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}"}
  ]) %>
</script>
<!-- WebPage Schema -->
<script type="application/ld+json">
  <%= Phoenix.HTML.raw(Jason.encode!(%{
    "@context" => "https://schema.org",
    "@type" => "WebPage",
    "name" => @page_title,
    "description" => meta_description,
    "url" => "https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}",
    "inLanguage" => "de-DE",
    "isPartOf" => %{
      "@type" => "WebSite",
      "name" => "mehr-schulferien.de",
      "url" => "https://www.mehr-schulferien.de"
    },
    "breadcrumb" => %{
      "@type" => "BreadcrumbList",
      "itemListElement" => [
        %{
          "@type" => "ListItem",
          "position" => 1,
          "name" => "Startseite",
          "item" => "https://www.mehr-schulferien.de"
        },
        %{
          "@type" => "ListItem",
          "position" => 2,
          "name" => "Ferien Deutschland",
          "item" => "https://www.mehr-schulferien.de/ferien/deutschland"
        },
        %{
          "@type" => "ListItem",
          "position" => 3,
          "name" => @federal_state.name,
          "item" => "https://www.mehr-schulferien.de/ferien/deutschland/bundesland/#{@federal_state.slug}"
        },
        %{
          "@type" => "ListItem",
          "position" => 4,
          "name" => "#{@vacation_name} #{@year}",
          "item" => "https://www.mehr-schulferien.de/#{@vacation_type}/#{@federal_state.slug}/#{@year}"
        }
      ]
    }
  })) %>
</script>
<!-- Event Schema for vacation period -->
<%= if @vacation_period do %>
  <script type="application/ld+json">
    <%= Phoenix.HTML.raw(Jason.encode!(%{
      "@context" => "https://schema.org",
      "@type" => "Event",
      "name" => "#{@vacation_name} #{@federal_state.name} #{@year}",
      "description" => "#{@vacation_name} in #{@federal_state.name} #{@year}",
      "startDate" => Date.to_iso8601(@vacation_period.starts_on),
      "endDate" => Date.to_iso8601(@vacation_period.ends_on),
      "eventStatus" => "https://schema.org/EventScheduled",
      "eventAttendanceMode" => "https://schema.org/OfflineEventAttendanceMode",
      "location" => %{
        "@type" => "Place",
        "name" => @federal_state.name,
        "address" => %{
          "@type" => "PostalAddress",
          "addressRegion" => @federal_state.name,
          "addressCountry" => "DE"
        }
      },
      "organizer" => %{
        "@type" => "Organization",
        "name" => "Kultusministerium #{@federal_state.name}",
        "url" => "https://www.mehr-schulferien.de"
      }
    })) %>
  </script>
<% end %>
