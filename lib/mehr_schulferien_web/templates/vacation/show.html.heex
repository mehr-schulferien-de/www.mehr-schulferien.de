<div class="mt-0 sm:mt-1">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4">
      <.heading level={1} class="text-left">
        <%= @vacation_name %> <%= @federal_state.name %> <%= @year %>
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@federal_state}
        location_type={:federal_state}
        years_with_data={@years_with_data}
        year={@year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <% # Show the specific vacation period prominently %>
              <div class="mb-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                <.heading level={2} class="text-lg text-blue-900 mb-2">
                  <%= @vacation_name %> <%= @year %>
                </.heading>
                <div class="text-xl font-bold text-blue-800">
                  <%= MehrSchulferienWeb.Formatters.DateFormatter.format_date_full(
                    @vacation_period.starts_on
                  ) %> - <%= MehrSchulferienWeb.Formatters.DateFormatter.format_date_full(
                    @vacation_period.ends_on
                  ) %>
                </div>
                <div class="text-sm text-blue-700 mt-1">
                  <%= Date.diff(@vacation_period.ends_on, @vacation_period.starts_on) + 1 %> Tage
                </div>
              </div>

              <% # Show all vacation periods for comparison %>
              <.heading level={3} class="text-lg text-gray-800 mb-3">
                Alle Schulferien <%= @federal_state.name %> <%= @year %>
              </.heading>
              <.periods_table periods={@periods} all_periods={@all_periods} today={@today} />
              <.last_updated periods={@periods} federal_state={@federal_state} />

              <% # Links to other vacation types %>
              <%= if length(@vacation_types) > 1 do %>
                <div class="mt-6 p-4 bg-gray-50 rounded-lg">
                  <.heading level={3} class="text-base text-gray-800 mb-3">
                    Weitere Ferientermine <%= @federal_state.name %>:
                  </.heading>
                  <div class="flex flex-wrap gap-2">
                    <%= for vt <- @vacation_types do %>
                      <% vacation_key = "#{vt.slug}ferien" %>
                      <%= if vacation_key != @vacation_type do %>
                        <a
                          href={"/#{vacation_key}/#{@federal_state.slug}/#{@year}"}
                          class="inline-flex items-center px-3 py-1 text-sm font-medium text-blue-700 bg-white hover:bg-blue-50 border border-blue-300 rounded-md transition-colors"
                        >
                          <%= vt.colloquial %> <%= @year %>
                        </a>
                      <% else %>
                        <span class="inline-flex items-center px-3 py-1 text-sm font-medium text-white bg-blue-600 border border-blue-600 rounded-md">
                          <%= vt.colloquial %> <%= @year %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <% # Link back to main federal state page %>
              <div class="mt-4">
                <a
                  href={~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}"}
                  class="text-blue-600 hover:text-blue-800 text-sm"
                >
                  ← Alle Ferientermine <%= @federal_state.name %> <%= @year %>
                </a>
              </div>
            <% else %>
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                <.heading level={2} class="text-lg text-blue-900 mb-3">
                  <%= @vacation_name %> <%= @year %> in <%= @federal_state.name %>
                </.heading>
                <.text class="text-gray-700 mb-4">
                  Die Termine für <%= @vacation_name %> <%= @year %> werden in der Regel
                  <%= if @year > Date.utc_today().year do %>
                    etwa 12-18 Monate im Voraus
                  <% else %>
                    in Kürze
                  <% end %>
                  vom Kultusministerium <%= @federal_state.name %> festgelegt und veröffentlicht.
                </.text>

                <% # Show previous year's dates as reference if available %>
                <% previous_year = @year - 1 %>
                <div class="bg-white rounded p-4 mb-4">
                  <.text variant="small" class="text-gray-600 mb-2">Zur Orientierung:</.text>
                  <a
                    href={~p"/#{@vacation_type}/#{@federal_state.slug}/#{previous_year}"}
                    class="text-blue-600 hover:text-blue-800 font-medium"
                  >
                    <%= @vacation_name %> <%= previous_year %> ansehen →
                  </a>
                </div>

                <div class="space-y-2">
                  <a
                    href={~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}"}
                    class="inline-flex items-center text-blue-600 hover:text-blue-800"
                  >
                    <svg
                      class="w-4 h-4 mr-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                      >
                      </path>
                    </svg>
                    Alle Ferientermine <%= @federal_state.name %> <%= @year %>
                  </a>
                </div>
              </div>
            <% end %>
          </:content>
        </.card>
      </div>

      <div class="lg:w-1/3">
        <.ical_panel
          conn={@conn}
          entity_slug={@federal_state.slug}
          entity_name={@federal_state.name}
          entity_type="federal_state"
          year={@year}
        />

        <% # Info box about vacation planning %>
        <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
          <.heading level={3} class="text-lg text-yellow-900 mb-2">
            <%= @vacation_name %> planen
          </.heading>
          <.text variant="small" class="text-yellow-800">
            <%= vacation_planning_tip(@vacation_type) %>
          </.text>
        </div>
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-4">
          Kalenderansicht <%= @vacation_name %> <%= @year %>
        </.heading>

        <.calendar_legend />

        <% # Show only the months relevant to this vacation %>
        <% relevant_months = get_relevant_months(@vacation_period) %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= for month <- relevant_months do %>
            <.month_calendar
              month={month}
              year={@year}
              periods={@periods}
              public_periods={@public_periods}
              all_periods={@all_periods}
              months={@months}
            />
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if @vacation_period do %>
      <.schema_org_event
        periods={[@vacation_period]}
        federal_state={@federal_state}
        country={@country}
      />
      <.faq_schema federal_state={@federal_state} year={@year} periods={@periods} />
    <% end %>
  </div>
</div>
