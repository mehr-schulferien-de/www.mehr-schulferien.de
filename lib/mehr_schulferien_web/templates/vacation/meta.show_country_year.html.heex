<% canonical_url = "https://www.mehr-schulferien.de/#{@vacation_type}/#{@year}"

meta_description =
  MehrSchulferienWeb.Helpers.VacationTypeHelpers.generate_meta_description(
    @vacation_db_slug,
    @year,
    @raw_states_data
  ) %>

<title>{@page_title}</title>
<meta name="description" content={meta_description} />
<meta name="keywords" content={@vacation_config.keywords} />
<link rel="canonical" href={canonical_url} />

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical_url} />
<meta property="og:title" content={@page_title} />
<meta property="og:description" content={meta_description} />
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical_url} />
<meta property="twitter:title" content={@page_title} />
<meta property="twitter:description" content={meta_description} />
<!-- Breadcrumb Navigation -->
<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: "Startseite", item: "https://www.mehr-schulferien.de"},
    %{name: @vacation_config.name, item: "https://www.mehr-schulferien.de/#{@vacation_type}"},
    %{name: "#{@vacation_config.name} #{@year}", item: canonical_url}
  ]) %>
</script>
