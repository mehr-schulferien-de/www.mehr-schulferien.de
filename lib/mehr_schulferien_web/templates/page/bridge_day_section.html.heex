<div class="max-w-6xl mx-auto px-4 py-8">
  <.heading level={2} class="text-2xl mb-6 flex items-center">
    <span class="mr-2">📅</span> Brückentage
  </.heading>
  <% teaser_data = MehrSchulferienWeb.PageView.best_bridge_day_teaser() %>
  <%= case teaser_data do %>
    <% {percent, min_leave, max_days, year, _starts_on, _ends_on} -> %>
      <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
        <.text class="text-green-800 font-semibold">
          Bis zu {percent}% mehr freie Tage möglich!
        </.text>
        <.text class="text-green-700 mt-2">
          Beispiel: Mit nur {min_leave} Urlaubstag{if min_leave > 1, do: "en", else: ""} in NRW können Sie {max_days} Tage frei machen
          (<a
            href={~p"/brueckentage/d/bundesland/nordrhein-westfalen/#{year}"}
            class="text-green-600 hover:text-green-800 underline"
          >Beispiel ansehen</a>).
        </.text>
      </div>
    <% _ -> %>
      <div></div>
  <% end %>
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
    <.text class="text-blue-800"><strong>Mehr Urlaub mit weniger Urlaubstagen!</strong></.text>
    <.text class="text-blue-700 mt-1">
      Nutzen Sie Brückentage für eine clevere Urlaubsplanung.
      <a
        href="https://de.wikipedia.org/wiki/Brückentag"
        target="_blank"
        rel="noopener"
        class="text-blue-600 hover:text-blue-800 underline"
      >
        Was ist ein Brückentag?
      </a>
    </.text>
  </div>
  <.text class="text-gray-700 mb-6">
    Unser Algorithmus zeigt nicht nur normale <a
      href="https://de.wikipedia.org/wiki/Brückentag"
      class="text-blue-600 hover:text-blue-800 underline"
    >Brückentage</a>, sondern auch
    die Variationen, in denen 2 bis 4 genommene Urlaubstage ein Vielfaches an effektivem
    Urlaub realisieren.
  </.text>
  <div class="overflow-x-auto rounded-lg border border-gray-200">
    <table class="min-w-full bg-white">
      <thead class="bg-gray-50">
        <tr class="border-b">
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">
            Bundesland
          </th>
          <%= if Enum.any?(@countries, fn country -> 
                 Enum.any?(country[:federal_states], fn federal_state -> 
                   length(federal_state.years_with_bridge_days) > 0 
                 end)
               end) do %>
            <th
              colspan={
                length(
                  @countries
                  |> hd()
                  |> get_in([:federal_states])
                  |> hd()
                  |> Map.get(:years_with_bridge_days)
                )
              }
              class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider"
            >
              Jahr
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <%= for place <- @countries do %>
          <% country = place[:country] %>
          <% federal_states = place[:federal_states] %>
          <%= for federal_state <- federal_states do %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-4 py-3 text-sm text-gray-900">{federal_state.name}</td>
              <%= if length(federal_state.years_with_bridge_days) > 0 do %>
                <%= for year <- federal_state.years_with_bridge_days do %>
                  <td class="px-4 py-3">
                    {link(year,
                      to:
                        ~p"/brueckentage/#{country.slug}/bundesland/#{federal_state.slug}/#{year}",
                      class:
                        "inline-block px-3 py-1 text-sm font-medium text-blue-600 bg-blue-50 rounded hover:bg-blue-100"
                    )}
                  </td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
