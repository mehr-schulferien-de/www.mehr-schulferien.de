<.card padding="p-6" class="mb-8" variant="basic">
  <:content>
    <div class="prose prose-lg dark:prose-invert max-w-none mx-auto">
      <.heading level={1} class="text-3xl mb-6">
        Developer Hub - Dokumentation für Entwickler
      </.heading>

      {render("developers_nav.html", current_page: :overview)}

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <!-- REST API Card -->
        <.card variant="enhanced" class="hover:shadow-lg transition-shadow">
          <:content>
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg mr-4">
                  <svg
                    class="w-6 h-6 text-blue-600 dark:text-blue-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                </div>
                <.heading level={2} class="text-xl text-gray-800 dark:text-gray-200">
                  REST API
                </.heading>
              </div>
              <p class="text-gray-600 dark:text-gray-400 mb-4">
                Zugriff auf alle Ferien- und Feiertagsdaten über unsere RESTful JSON API.
                Ideal für Web-Anwendungen und mobile Apps.
              </p>
              <ul class="space-y-2 mb-4 text-sm text-gray-600 dark:text-gray-400">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  JSON & iCalendar Formate
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  Keine Authentifizierung nötig
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  Versionierte API (v2.0 & v2.1)
                </li>
              </ul>
              <.link
                href="/developers/api"
                class="inline-flex items-center text-blue-600 dark:text-blue-400 hover:underline font-medium"
              >
                Zur API Dokumentation
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </.link>
            </div>
          </:content>
        </.card>
        
<!-- MCP Server Card -->
        <.card variant="enhanced" class="hover:shadow-lg transition-shadow">
          <:content>
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="p-3 bg-purple-100 dark:bg-purple-900/30 rounded-lg mr-4">
                  <svg
                    class="w-6 h-6 text-purple-600 dark:text-purple-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                </div>
                <.heading level={2} class="text-xl text-gray-800 dark:text-gray-200">
                  MCP Server
                </.heading>
              </div>
              <p class="text-gray-600 dark:text-gray-400 mb-4">
                Model Context Protocol Server für AI-Assistenten.
                Perfekt für Claude, ChatGPT und andere KI-Tools.
              </p>
              <ul class="space-y-2 mb-4 text-sm text-gray-600 dark:text-gray-400">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  40+ spezialisierte Tools
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  Slug-basierte Navigation
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  JSON-RPC Protokoll
                </li>
              </ul>
              <.link
                href="/developers/mcp"
                class="inline-flex items-center text-purple-600 dark:text-purple-400 hover:underline font-medium"
              >
                Zur MCP Dokumentation
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </.link>
            </div>
          </:content>
        </.card>
        
<!-- Open Source Card -->
        <.card variant="enhanced" class="hover:shadow-lg transition-shadow">
          <:content>
            <div class="p-6">
              <div class="flex items-center mb-4">
                <div class="p-3 bg-gray-100 dark:bg-gray-900/30 rounded-lg mr-4">
                  <svg
                    class="w-6 h-6 text-gray-600 dark:text-gray-400"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                </div>
                <.heading level={2} class="text-xl text-gray-800 dark:text-gray-200">
                  Open Source
                </.heading>
              </div>
              <p class="text-gray-600 dark:text-gray-400 mb-4">
                Unser Code ist Open Source (MIT Lizenz). Contributions und Feature Requests sind willkommen!
              </p>
              <ul class="space-y-2 mb-4 text-sm text-gray-600 dark:text-gray-400">
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  Elixir & Phoenix Framework
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  MIT Lizenz
                </li>
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  Pull Requests willkommen
                </li>
              </ul>
              <.link
                href="https://github.com/mehr-schulferien-de/www.mehr-schulferien.de"
                target="_blank"
                class="inline-flex items-center text-gray-600 dark:text-gray-400 hover:underline font-medium"
              >
                GitHub Repository
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </.link>
            </div>
          </:content>
        </.card>
      </div>

      <div class="mt-8">
        <.heading level={2} class="text-2xl text-gray-800 dark:text-gray-200 mb-4">
          Quick Start
        </.heading>

        <div class="grid gap-4 md:grid-cols-2">
          <div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-lg">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-2">REST API Beispiel</h3>
            <div class="relative">
              <button
                onclick="copyToClipboard(this)"
                data-content='curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/periods?year=2025'
                class="absolute top-2 right-2 px-3 py-1 text-xs bg-gray-700 hover:bg-gray-600 text-white rounded transition-colors"
                title="In Zwischenablage kopieren"
              >
                Kopieren
              </button>
              <pre
                class="bg-gray-900 text-gray-100 p-3 pr-20 rounded text-sm overflow-x-auto"
                tabindex="0"
              ><code>curl -H "Accept: application/json" \
  https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/periods?year=2025</code></pre>
            </div>
          </div>

          <div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-lg">
            <h3 class="font-semibold text-gray-800 dark:text-gray-200 mb-2">
              MCP Server Beispiel
            </h3>
            <div class="relative">
              <button
                onclick="copyToClipboard(this)"
                data-content='curl -X POST https://www.mehr-schulferien.de/mcp -H "Content-Type: application/json" -d &#39;{"jsonrpc":"2.0","method":"tools/call","params":{"name":"get_vacations","arguments":{"location_slug":"bayern","location_type":"federal_state","start_date":"2025-01-01","end_date":"2025-12-31"}},"id":1}&#39;'
                class="absolute top-2 right-2 px-3 py-1 text-xs bg-gray-700 hover:bg-gray-600 text-white rounded transition-colors"
                title="In Zwischenablage kopieren"
              >
                Kopieren
              </button>
              <pre
                class="bg-gray-900 text-gray-100 p-3 pr-20 rounded text-sm overflow-x-auto"
                tabindex="0"
              ><code><%= ~s|curl -X POST https://www.mehr-schulferien.de/mcp \
  -H "Content-Type: application/json" \
  -d '{
    "jsonrpc": "2.0",
    "method": "tools/call",
    "params": {
      "name": "get_vacations",
      "arguments": {
        "location_slug": "bayern",
        "location_type": "federal_state",
        "start_date": "2025-01-01",
        "end_date": "2025-12-31"
      }
    },
    "id": 1
  }'| %></code></pre>
            </div>
          </div>
        </div>
      </div>

      {render("developers_footer.html", assigns)}
    </div>
  </:content>
</.card>

<script>
  function copyToClipboard(button) {
    const content = button.getAttribute('data-content');
    const decodedContent = content.replace(/&#39;/g, "'");

    navigator.clipboard.writeText(decodedContent).then(function() {
      const originalText = button.textContent;
      button.textContent = 'Kopiert!';
      button.classList.add('bg-green-600');
      button.classList.remove('bg-gray-700');

      setTimeout(function() {
        button.textContent = originalText;
        button.classList.remove('bg-green-600');
        button.classList.add('bg-gray-700');
      }, 2000);
    }).catch(function(err) {
      console.error('Fehler beim Kopieren: ', err);
      button.textContent = 'Fehler!';
      setTimeout(function() {
        button.textContent = 'Kopieren';
      }, 2000);
    });
  }
</script>
