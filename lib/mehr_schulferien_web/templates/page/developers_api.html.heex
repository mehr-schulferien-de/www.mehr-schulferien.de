<.card padding="p-6" class="mb-8" variant="basic">
  <:content>
    <div class="prose prose-lg dark:prose-invert max-w-none mx-auto">
      <.heading level={1} class="text-3xl mb-6">
        REST API Dokumentation
      </.heading>

      {render("developers_nav.html", current_page: :api)}
      
<!-- Table of Contents -->
      <div class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mb-8">
        <.heading level={3} class="text-lg mb-3 mt-0">
          Inhaltsverzeichnis
        </.heading>
        <nav class="space-y-2 text-sm">
          <div>
            <a
              href="#v21-overview"
              class="text-blue-600 dark:text-blue-400 hover:underline font-medium"
            >
              API v2.1
            </a>
            <ul class="ml-5 mt-1 space-y-1 list-disc">
              <li>
                <a href="#v21-endpoints" class="text-blue-600 dark:text-blue-400 hover:underline">
                  Verfügbare Endpunkte
                </a>
              </li>
              <li>
                <a href="#v21-locations" class="text-blue-600 dark:text-blue-400 hover:underline">
                  Standorte abrufen
                </a>
              </li>
              <li>
                <a href="#v21-periods" class="text-blue-600 dark:text-blue-400 hover:underline">
                  Feriendaten abrufen
                </a>
              </li>
              <li>
                <a href="#v21-icalendar" class="text-blue-600 dark:text-blue-400 hover:underline">
                  iCalendar Export
                </a>
              </li>
              <li>
                <a href="#v21-vcard" class="text-blue-600 dark:text-blue-400 hover:underline">
                  vCard Export
                </a>
              </li>
              <li>
                <a href="#v21-pdf" class="text-blue-600 dark:text-blue-400 hover:underline">
                  PDF-Dokumente generieren
                </a>
              </li>
              <li>
                <a
                  href="#v21-bridge-days"
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Brückentage berechnen
                </a>
              </li>
              <li>
                <a
                  href="#v21-vacation-optimizer"
                  class="text-blue-600 dark:text-blue-400 hover:underline"
                >
                  Urlaubsplaner (Urlaubsoptimierung)
                </a>
              </li>
              <li>
                <a href="#v21-queries" class="text-blue-600 dark:text-blue-400 hover:underline">
                  Datum-Abfragen
                </a>
              </li>
              <li>
                <a href="#v21-response" class="text-blue-600 dark:text-blue-400 hover:underline">
                  Response Format & Parameter
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </div>

      <div id="v21-overview" class="scroll-mt-6">
        <.heading level={2} class="text-2xl text-gray-800 dark:text-gray-200 mt-8 mb-4">
          API v2.1
        </.heading>
        <p class="mb-6">
          Die API v2.1 bietet eine klare Struktur mit dedizierten Endpunkten für jeden Standorttyp. Dies verhindert Mehrdeutigkeiten, wenn mehrere Standorte denselben Slug haben (z.B. "Hessen" als Bundesland und als Stadt).
        </p>
      </div>

      <div id="v21-endpoints" class="scroll-mt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-8 mb-3">
          Verfügbare Endpunkte
        </.heading>
      </div>
      <div class="overflow-x-auto mb-6">
        <table class="min-w-full text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700">
          <thead>
            <tr class="bg-gray-100 dark:bg-gray-900">
              <th class="py-2 px-4 border-b text-left">Standorttyp</th>
              <th class="py-2 px-4 border-b text-left">Basis-URL</th>
              <th class="py-2 px-4 border-b text-left">Verfügbare Aktionen</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-2 px-4 border-b">Bundesländer</td>
              <td class="py-2 px-4 border-b font-mono">/api/v2.1/federal-states</td>
              <td class="py-2 px-4 border-b">Liste, Details, Ferien, iCalendar, Brückentage</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b">Städte</td>
              <td class="py-2 px-4 border-b font-mono">/api/v2.1/cities</td>
              <td class="py-2 px-4 border-b">Liste, Details, Ferien, iCalendar, Brückentage</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b">Landkreise</td>
              <td class="py-2 px-4 border-b font-mono">/api/v2.1/counties</td>
              <td class="py-2 px-4 border-b">Liste, Details, Ferien, iCalendar, Brückentage</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b">Schulen</td>
              <td class="py-2 px-4 border-b font-mono">/api/v2.1/schools</td>
              <td class="py-2 px-4 border-b">
                Liste, Details, Ferien, iCalendar, vCard, PDF-Dokumente
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="v21-locations" class="scroll-mt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-8 mb-3">
          Beispiele: Standorte abrufen
        </.heading>
      </div>
      <ul class="list-disc pl-5 mb-4">
        <li>
          <strong>Alle Bundesländer:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/federal-states</pre>
        </li>
        <li>
          <strong>Spezifisches Bundesland:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/federal-states/hessen</pre>
        </li>
        <li>
          <strong>Alle Städte:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/cities</pre>
        </li>
      </ul>

      <div id="v21-periods" class="scroll-mt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-8 mb-3">
          Beispiele: Feriendaten abrufen
        </.heading>
      </div>
      <ul class="list-disc pl-5 mb-4">
        <li>
          <strong>Ferien für ein Bundesland:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/periods?start_date=2024-01-01&end_date=2024-12-31</pre>
        </li>
        <li>
          <strong>Nur Schulferien für eine Stadt:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/cities/muenchen/periods?type=vacation&start_date=2024-01-01&end_date=2024-12-31</pre>
        </li>
        <li>
          <strong>Nur Feiertage für einen Landkreis:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl -H "Accept: application/json" https://www.mehr-schulferien.de/api/v2.1/counties/muenchen-landkreis/periods?type=holiday&start_date=2024-01-01&end_date=2024-12-31</pre>
        </li>
      </ul>

      <div id="v21-icalendar" class="scroll-mt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-8 mb-3">
          iCalendar Export
        </.heading>
      </div>
      <p class="mb-2">
        Exportieren Sie Feriendaten im iCalendar-Format (.ics) für die direkte Integration in Kalenderanwendungen:
      </p>
      <ul class="list-disc pl-5 mb-4">
        <li>
          <strong>Schuljahr 2024/2025 für Bayern:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/icalendar?year=2024&vacation_types=school</pre>
        </li>
        <li>
          <strong>Kalenderjahr 2024 für München (alle Ferien & Feiertage):</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl https://www.mehr-schulferien.de/api/v2.1/cities/muenchen/icalendar?year=2024&vacation_types=all&calendar_year=true</pre>
        </li>
        <li>
          <strong>Nur Schulferien für eine spezifische Schule:</strong> <br />
          <pre class="bg-gray-100 dark:bg-gray-800 p-2 mt-1 mb-2 rounded overflow-x-auto">curl https://www.mehr-schulferien.de/api/v2.1/schools/gymnasium-muenchen-nord/icalendar?year=2024&vacation_types=school</pre>
        </li>
      </ul>

      <div id="v21-vcard" class="scroll-mt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-8 mb-3">
          vCard Export (nur für Schulen)
        </.heading>
        <p class="mb-2">
          Exportieren Sie Schulkontaktdaten als vCard:
        </p>
        <pre class="bg-gray-100 dark:bg-gray-800 p-2 mb-6 rounded overflow-x-auto">curl https://www.mehr-schulferien.de/api/v2.1/schools/gymnasium-muenchen-nord/vcard</pre>
      </div>

      <div id="v21-pdf" class="scroll-mt-6 border-t border-gray-200 dark:border-gray-700 pt-6">
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-2 mb-3">
          PDF-Dokumente generieren (nur für Schulen)
        </.heading>
      </div>
      <p class="mb-4">
        Generieren Sie PDF-Dokumente wie Entschuldigungen, Beurlaubungsanträge oder Sportbefreiungen für Schulen:
      </p>

      <div class="bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mb-4">
        <.heading
          level={4}
          class="text-base font-semibold text-gray-800 dark:text-gray-200 mt-0 mb-2"
        >
          Endpunkt
        </.heading>
        <pre class="bg-white dark:bg-gray-900 p-2 rounded overflow-x-auto text-sm">POST /api/v2.1/schools/:slug/documents</pre>
      </div>

      <details class="mb-4 border border-gray-200 dark:border-gray-700 rounded-lg">
        <summary class="cursor-pointer bg-gray-50 dark:bg-gray-800/50 px-4 py-3 font-medium text-gray-800 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
          📄 Beispiel: Entschuldigung erstellen
        </summary>
        <div class="p-4">
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -X POST https://www.mehr-schulferien.de/api/v2.1/schools/gymnasium-muenchen-nord/documents \\
  -H "Content-Type: application/json" \\
  -d '{
    "type": "entschuldigung",
    "first_name": "Max",
    "last_name": "Mustermann",
    "zip_code": "80333",
    "city": "München",
    "name_of_student": "Anna Mustermann",
    "class_name": "5a",
    "reason": "krankheit",
    "start_date": "2025-01-15",
    "end_date": "2025-01-17",
    "teacher_name": "Schmidt",
    "teacher_salutation": "Frau"
  }' \\
  --output entschuldigung.pdf| %></pre>
        </div>
      </details>

      <details class="mb-4 border border-gray-200 dark:border-gray-700 rounded-lg">
        <summary class="cursor-pointer bg-gray-50 dark:bg-gray-800/50 px-4 py-3 font-medium text-gray-800 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
          📝 Beispiel: Beurlaubungsantrag erstellen
        </summary>
        <div class="p-4">
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -X POST https://www.mehr-schulferien.de/api/v2.1/schools/gymnasium-muenchen-nord/documents \\
  -H "Content-Type: application/json" \\
  -d '{
    "type": "beurlaubung",
    "first_name": "Max",
    "last_name": "Mustermann",
    "zip_code": "80333",
    "city": "München",
    "name_of_student": "Anna Mustermann",
    "class_name": "5a",
    "start_date": "2025-02-10",
    "end_date": "2025-02-14",
    "detailed_reason": "Familiäre Angelegenheiten"
  }' \\
  --output beurlaubung.pdf| %></pre>
        </div>
      </details>

      <details class="mb-4 border border-gray-200 dark:border-gray-700 rounded-lg">
        <summary class="cursor-pointer bg-gray-50 dark:bg-gray-800/50 px-4 py-3 font-medium text-gray-800 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800">
          🏃 Beispiel: Sportbefreiung erstellen
        </summary>
        <div class="p-4">
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -X POST https://www.mehr-schulferien.de/api/v2.1/schools/gymnasium-muenchen-nord/documents \\
  -H "Content-Type: application/json" \\
  -d '{
    "type": "sportbefreiung",
    "first_name": "Max",
    "last_name": "Mustermann",
    "zip_code": "80333",
    "city": "München",
    "name_of_student": "Anna Mustermann",
    "class_name": "5a",
    "duration_type": "single_lesson",
    "single_date": "2025-03-20",
    "detailed_reason": "Verletzung am Fuß",
    "medical_certificate": true
  }' \\
  --output sportbefreiung.pdf| %></pre>
        </div>
      </details>

      <.heading level={4} class="text-lg text-gray-800 dark:text-gray-200 mt-4 mb-2">
        Parameter für PDF-Dokumente
      </.heading>
      <div class="overflow-x-auto mb-6">
        <table class="min-w-full text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700">
          <thead>
            <tr class="bg-gray-100 dark:bg-gray-900">
              <th class="py-2 px-4 border-b text-left">Parameter</th>
              <th class="py-2 px-4 border-b text-left">Erforderlich</th>
              <th class="py-2 px-4 border-b text-left">Beschreibung</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-2 px-4 border-b font-mono">type</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">
                "entschuldigung", "beurlaubung" oder "sportbefreiung"
              </td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">first_name</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Vorname des Absenders</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">last_name</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Nachname des Absenders</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">zip_code</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Postleitzahl</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">city</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Stadt</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">name_of_student</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Name des Schülers/der Schülerin</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">class_name</td>
              <td class="py-2 px-4 border-b">Ja</td>
              <td class="py-2 px-4 border-b">Klassenname (z.B. "5a")</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">start_date</td>
              <td class="py-2 px-4 border-b">Abhängig vom Typ</td>
              <td class="py-2 px-4 border-b">Startdatum (ISO 8601, z.B. "2025-01-15")</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">end_date</td>
              <td class="py-2 px-4 border-b">Abhängig vom Typ</td>
              <td class="py-2 px-4 border-b">Enddatum (ISO 8601)</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">reason</td>
              <td class="py-2 px-4 border-b">Nur bei Entschuldigung</td>
              <td class="py-2 px-4 border-b">
                "krankheit", "arzttermin", "familiaere_angelegenheiten", "beerdigung" oder "religioser_feiertag"
              </td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">duration_type</td>
              <td class="py-2 px-4 border-b">Nur bei Sportbefreiung</td>
              <td class="py-2 px-4 border-b">"single_lesson" oder "multiple_days"</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">single_date</td>
              <td class="py-2 px-4 border-b">Bei single_lesson</td>
              <td class="py-2 px-4 border-b">Datum für einzelne Sportstunde (ISO 8601)</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">teacher_name</td>
              <td class="py-2 px-4 border-b">Nein</td>
              <td class="py-2 px-4 border-b">Name des Klassenlehrers/der Klassenlehrerin</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">teacher_salutation</td>
              <td class="py-2 px-4 border-b">Nein</td>
              <td class="py-2 px-4 border-b">"Herr" oder "Frau"</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">detailed_reason</td>
              <td class="py-2 px-4 border-b">Nein</td>
              <td class="py-2 px-4 border-b">Ausführliche Begründung</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-400 dark:border-green-600 p-4 mb-2">
        <p class="text-sm text-green-700 dark:text-green-300">
          <strong>Response:</strong>
          Bei erfolgreicher Generierung wird das PDF direkt als Binary mit Content-Type "application/pdf" zurückgegeben.
        </p>
      </div>
      <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 dark:border-red-600 p-4 mb-6">
        <p class="text-sm text-red-700 dark:text-red-300">
          <strong>Fehler:</strong>
          Bei Fehlern wird ein JSON-Objekt mit dem Feld "error" und einer Fehlerbeschreibung zurückgegeben (Status 400 oder 404).
        </p>
      </div>

      <div
        id="v21-bridge-days"
        class="scroll-mt-6 border-t border-gray-200 dark:border-gray-700 pt-6"
      >
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-2 mb-3">
          Brückentage berechnen
        </.heading>

        <p class="mb-4">
          Die Brückentage-Endpunkte berechnen optimale Urlaubsmöglichkeiten durch Identifizierung von Lücken zwischen Feiertagen und Wochenenden.
          Dabei werden nur Brückentage-Gelegenheiten zurückgegeben, die eine Effizienz von über 100% aufweisen (mehr freie Tage als Urlaubstage benötigt).
        </p>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Endpunkte
        </.heading>

        <div class="overflow-x-auto mb-6">
          <table class="min-w-full text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700">
            <thead>
              <tr class="bg-gray-100 dark:bg-gray-900">
                <th class="py-2 px-4 border-b text-left">Methode</th>
                <th class="py-2 px-4 border-b text-left">Endpoint</th>
                <th class="py-2 px-4 border-b text-left">Beschreibung</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="py-2 px-4 border-b font-mono text-blue-600 dark:text-blue-400">GET</td>
                <td class="py-2 px-4 border-b font-mono">
                  /api/v2.1/federal-states/:slug/bridge-days
                </td>
                <td class="py-2 px-4 border-b">Brückentage für ein Bundesland</td>
              </tr>
              <tr>
                <td class="py-2 px-4 border-b font-mono text-blue-600 dark:text-blue-400">GET</td>
                <td class="py-2 px-4 border-b font-mono">/api/v2.1/counties/:slug/bridge-days</td>
                <td class="py-2 px-4 border-b">Brückentage für einen Landkreis</td>
              </tr>
              <tr>
                <td class="py-2 px-4 border-b font-mono text-blue-600 dark:text-blue-400">GET</td>
                <td class="py-2 px-4 border-b font-mono">/api/v2.1/cities/:slug/bridge-days</td>
                <td class="py-2 px-4 border-b">Brückentage für eine Stadt</td>
              </tr>
            </tbody>
          </table>
        </div>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Query-Parameter
        </.heading>

        <ul class="ml-5 list-disc space-y-2 mb-6">
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">year</code>
            (erforderlich): Das Jahr für die Brückentage-Berechnung (aktuelles Jahr - 5 bis aktuelles Jahr + 3)
          </li>
        </ul>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Beispiel-Request
        </.heading>

        <div class="bg-gray-100 dark:bg-gray-900 rounded-lg p-4 mb-6 overflow-x-auto">
          <pre class="text-sm"><code>GET https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/bridge-days?year=2025</code></pre>
        </div>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Beispiel-Response
        </.heading>

        <pre class="bg-gray-100 dark:bg-gray-800 p-4 mb-6 rounded overflow-x-auto text-sm"><%= ~s|{
  "data": {
    "location": {
      "id": 2,
      "name": "Bayern",
      "slug": "bayern",
      "type": "federal_state"
    },
    "year": 2025,
    "summary": {
      "total_opportunities": 8,
      "total_vacation_days_needed": 12,
      "total_free_days_gained": 48,
      "overall_efficiency_percentage": 300
    },
    "bridge_days": [
      {
        "starts_on": "2025-05-02",
        "ends_on": "2025-05-02",
        "vacation_days_needed": 1,
        "total_consecutive_free_days": 4,
        "efficiency_percentage": 300,
        "category": "normal",
        "related_holidays": [
          {
            "name": "Tag der Arbeit",
            "slug": "tag-der-arbeit",
            "starts_on": "2025-05-01",
            "ends_on": "2025-05-01",
            "is_public_holiday": true
          }
        ],
        "timeline": {
          "actual_starts_on": "2025-05-01",
          "actual_ends_on": "2025-05-04",
          "includes_weekends": true
        }
      }
    ]
  },
  "meta": {
    "api_version": "2.1"
  }
}| %></pre>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Response-Felder
        </.heading>

        <ul class="ml-5 list-disc space-y-2 mb-6">
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">location</code>: Informationen über den Standort
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">year</code>: Das angefragte Jahr
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">summary</code>: Zusammenfassende Statistiken über alle Brückentage-Möglichkeiten
            <ul class="ml-5 list-disc mt-2">
              <li><code>total_opportunities</code>: Anzahl der Brückentage-Gelegenheiten</li>
              <li><code>total_vacation_days_needed</code>: Gesamt benötigte Urlaubstage</li>
              <li><code>total_free_days_gained</code>: Gesamt gewonnene freie Tage</li>
              <li><code>overall_efficiency_percentage</code>: Gesamt-Effizienz in Prozent</li>
            </ul>
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">bridge_days</code>: Liste der Brückentage-Möglichkeiten
            <ul class="ml-5 list-disc mt-2">
              <li>
                <code>starts_on</code>
                / <code>ends_on</code>: Zeitraum der zu nehmenden Urlaubstage
              </li>
              <li><code>vacation_days_needed</code>: Anzahl der benötigten Urlaubstage</li>
              <li>
                <code>total_consecutive_free_days</code>: Gesamtzahl aufeinanderfolgender freier Tage
              </li>
              <li>
                <code>efficiency_percentage</code>: Effizienz in Prozent ((freie Tage - Urlaubstage) / Urlaubstage × 100)
              </li>
              <li>
                <code>category</code>: "normal" (1 Urlaubstag) oder "super" (2+ Urlaubstage)
              </li>
              <li>
                <code>related_holidays</code>: Liste der Feiertage, die diese Brückentage-Gelegenheit schaffen
              </li>
              <li>
                <code>timeline</code>: Tatsächlicher Zeitraum der freien Tage (inkl. angrenzender Wochenenden)
                <ul class="ml-5 list-disc mt-2">
                  <li>
                    <code>actual_starts_on</code>: Tatsächlicher Beginn des freien Zeitraums
                  </li>
                  <li><code>actual_ends_on</code>: Tatsächliches Ende des freien Zeitraums</li>
                  <li><code>includes_weekends</code>: Ob Wochenenden eingeschlossen sind</li>
                </ul>
              </li>
            </ul>
          </li>
        </ul>

        <div class="bg-blue-50 dark:bg-blue-900/20 border-l-4 border-blue-400 dark:border-blue-600 p-4 mb-6">
          <p class="text-sm text-blue-700 dark:text-blue-300">
            <strong>Hinweis:</strong>
            Die Brückentage werden nach Effizienz absteigend sortiert. Es werden nur Gelegenheiten zurückgegeben,
            bei denen die Effizienz über 100% liegt (mehr freie Tage als genommene Urlaubstage).
          </p>
        </div>

        <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 dark:border-red-600 p-4 mb-6">
          <p class="text-sm text-red-700 dark:text-red-300">
            <strong>Fehler:</strong>
            Status 404 wird zurückgegeben, wenn für den angegebenen Standort und das Jahr keine Brückentage verfügbar sind.
            Status 400 wird bei ungültigen Jahr-Parameter zurückgegeben.
          </p>
        </div>
      </div>

      <div
        id="v21-vacation-optimizer"
        class="scroll-mt-6 border-t border-gray-200 dark:border-gray-700 pt-6"
      >
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-2 mb-3">
          Urlaubsplaner (Urlaubsoptimierung)
        </.heading>

        <p class="mb-4">
          Die Urlaubsplaner-Endpunkte berechnen optimale Urlaubszeiträume für eine bestimmte Anzahl von Urlaubstagen.
          Der Algorithmus findet die Zeitfenster mit der höchsten Effizienz, indem er Feiertage und Wochenenden optimal nutzt.
        </p>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Endpunkte
        </.heading>

        <div class="overflow-x-auto mb-6">
          <table class="min-w-full text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700">
            <thead>
              <tr class="bg-gray-100 dark:bg-gray-900">
                <th class="py-2 px-4 border-b text-left">Methode</th>
                <th class="py-2 px-4 border-b text-left">Endpoint</th>
                <th class="py-2 px-4 border-b text-left">Beschreibung</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="py-2 px-4 border-b font-mono text-blue-600 dark:text-blue-400">GET</td>
                <td class="py-2 px-4 border-b font-mono">
                  /api/v2.1/federal-states/:slug/vacation-optimizer
                </td>
                <td class="py-2 px-4 border-b">Optimale Urlaubsfenster (JSON)</td>
              </tr>
              <tr>
                <td class="py-2 px-4 border-b font-mono text-blue-600 dark:text-blue-400">GET</td>
                <td class="py-2 px-4 border-b font-mono">
                  /api/v2.1/federal-states/:slug/vacation-optimizer/icalendar
                </td>
                <td class="py-2 px-4 border-b">Optimale Urlaubsfenster als iCal-Download</td>
              </tr>
            </tbody>
          </table>
        </div>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Query-Parameter
        </.heading>

        <ul class="ml-5 list-disc space-y-2 mb-6">
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">year</code>
            (optional): Das Jahr für die Berechnung (Standard: aktuelles Jahr)
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">days</code>
            (erforderlich): Anzahl der Urlaubstage (1-60)
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">variant</code>
            (optional): "normal" (Standard) oder "budget" (außerhalb der Schulferien)
          </li>
          <li>
            <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">top</code>
            (optional): Anzahl der Top-Ergebnisse (Standard: 5)
          </li>
        </ul>

        <.heading level={4} class="text-lg text-gray-700 dark:text-gray-300 mt-6 mb-3">
          Beispiel-Request
        </.heading>

        <div class="bg-gray-100 dark:bg-gray-900 rounded-lg p-4 mb-6 overflow-x-auto">
          <pre class="text-sm"><code>GET https://www.mehr-schulferien.de/api/v2.1/federal-states/bayern/vacation-optimizer?year=2026&amp;days=10</code></pre>
        </div>

        <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-400 dark:border-green-600 p-4 mb-6">
          <p class="text-sm text-green-700 dark:text-green-300">
            <strong>Tipp:</strong>
            Mit <code>variant=budget</code>
            werden nur Urlaubsfenster außerhalb der Schulferien berechnet.
            Diese Zeiträume sind oft günstiger für Reisen.
          </p>
        </div>

        <p class="mb-4">
          <strong>Ausführliche Dokumentation:</strong>
          <a
            href={~p"/developers/api/vacation-optimizer"}
            class="text-blue-600 dark:text-blue-400 hover:underline"
          >
            Urlaubsplaner API-Dokumentation →
          </a>
        </p>
      </div>

      <div
        id="v21-queries"
        class="scroll-mt-6 border-t border-gray-200 dark:border-gray-700 pt-6"
      >
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-2 mb-3">
          Datum-Abfragen
        </.heading>
        <p class="mb-4">
          Die Datum-Abfrage-Endpunkte ermöglichen schnelle Antworten auf Fragen wie "Ist heute ein Feiertag?" oder "Ist das ein Schultag?".
        </p>

        <div class="mb-6">
          <.heading level={4} class="text-lg text-gray-800 dark:text-gray-200 mt-4 mb-2">
            Ist ein bestimmtes Datum ein Feiertag?
          </.heading>
          <pre class="bg-white dark:bg-gray-900 p-2 rounded overflow-x-auto text-sm">GET /api/v2.1/queries/is-public-holiday</pre>
          <p class="mt-2 mb-2"><strong>Query Parameter:</strong></p>
          <ul class="list-disc ml-5 mb-4">
            <li>
              <code>location_slug</code>
              (required): Slug des Bundeslandes (z.B. "bayern", "hessen")
            </li>
            <li><code>date</code> (required): Datum im ISO 8601 Format (z.B. "2025-12-25")</li>
          </ul>
          <p class="mb-2"><strong>Beispiel:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -H "Accept: application/json" \\
  "https://www.mehr-schulferien.de/api/v2.1/queries/is-public-holiday?location_slug=bayern&date=2025-12-25"| %></pre>
          <p class="mt-4 mb-2"><strong>Response:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|{
  "data": {
    "date": "2025-12-25",
    "location": {
      "id": 5,
      "name": "Bayern",
      "slug": "bayern",
      "code": "BY"
    },
    "is_public_holiday": true,
    "public_holiday_names": ["1. Weihnachtstag"]
  },
  "meta": {
    "api_version": "2.1"
  }
}| %></pre>
        </div>

        <div class="mb-6">
          <.heading level={4} class="text-lg text-gray-800 dark:text-gray-200 mt-4 mb-2">
            Ist ein bestimmtes Datum ein Schultag?
          </.heading>
          <pre class="bg-white dark:bg-gray-900 p-2 rounded overflow-x-auto text-sm">GET /api/v2.1/queries/is-school-day</pre>
          <p class="mt-2 mb-2"><strong>Query Parameter:</strong></p>
          <ul class="list-disc ml-5 mb-4">
            <li><code>location_slug</code> (required): Slug des Bundeslandes</li>
            <li><code>date</code> (required): Datum im ISO 8601 Format</li>
          </ul>
          <p class="mb-2"><strong>Beispiel:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -H "Accept: application/json" \\
  "https://www.mehr-schulferien.de/api/v2.1/queries/is-school-day?location_slug=bayern&date=2025-09-15"| %></pre>
          <p class="mt-4 mb-2"><strong>Response:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|{
  "data": {
    "date": "2025-09-15",
    "location": {
      "id": 5,
      "name": "Bayern",
      "slug": "bayern",
      "code": "BY"
    },
    "is_school_day": true
  },
  "meta": {
    "api_version": "2.1"
  }
}| %></pre>
        </div>

        <div class="mb-6">
          <.heading level={4} class="text-lg text-gray-800 dark:text-gray-200 mt-4 mb-2">
            Umfassende Datumsanalyse
          </.heading>
          <pre class="bg-white dark:bg-gray-900 p-2 rounded overflow-x-auto text-sm">GET /api/v2.1/queries/check-date</pre>
          <p class="mt-2 mb-2"><strong>Query Parameter:</strong></p>
          <ul class="list-disc ml-5 mb-4">
            <li><code>location_slug</code> (required): Slug des Bundeslandes</li>
            <li><code>date</code> (required): Datum im ISO 8601 Format</li>
          </ul>
          <p class="mb-4">
            Dieser Endpunkt liefert eine umfassende Analyse eines Datums, einschließlich:
          </p>
          <ul class="list-disc ml-5 mb-4">
            <li>Ob es ein Feiertag ist</li>
            <li>Ob es ein Schultag ist</li>
            <li>Ob es Schulferien sind</li>
            <li>Ob es ein Wochenende ist</li>
            <li>Listen der aktiven Feiertage und Ferienperioden</li>
            <li>Eine menschenlesbare Erklärung</li>
          </ul>
          <p class="mb-2"><strong>Beispiel:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|curl -H "Accept: application/json" \\
  "https://www.mehr-schulferien.de/api/v2.1/queries/check-date?location_slug=bayern&date=2025-08-15"| %></pre>
          <p class="mt-4 mb-2"><strong>Response:</strong></p>
          <pre class="bg-gray-100 dark:bg-gray-800 p-3 rounded overflow-x-auto text-sm"><%= ~s|{
  "data": {
    "date": "2025-08-15",
    "location": {
      "id": 5,
      "name": "Bayern",
      "slug": "bayern",
      "code": "BY"
    },
    "is_public_holiday": true,
    "is_school_day": false,
    "is_school_vacation": true,
    "is_weekend": false,
    "public_holiday_periods": [
      {
        "id": 12345,
        "name": "Mariä Himmelfahrt",
        "starts_on": "2025-08-15",
        "ends_on": "2025-08-15"
      }
    ],
    "school_vacation_periods": [
      {
        "id": 67890,
        "name": "Sommerferien",
        "colloquial": "Sommerferien",
        "starts_on": "2025-08-01",
        "ends_on": "2025-09-15"
      }
    ],
    "explanation": "Mariä Himmelfahrt und Sommerferien"
  },
  "meta": {
    "api_version": "2.1"
  }
}| %></pre>
          <p class="mt-4">
            <strong>Fehler:</strong>
            Status 404 wird zurückgegeben, wenn der Standort nicht gefunden wird.
            Status 400 wird bei ungültigem Datumsformat zurückgegeben.
          </p>
        </div>
      </div>

      <div
        id="v21-response"
        class="scroll-mt-6 border-t border-gray-200 dark:border-gray-700 pt-6"
      >
        <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-2 mb-3">
          API Response Format
        </.heading>
      </div>
      <p class="mb-2">
        Alle API v2.1 Antworten folgen einem einheitlichen JSON-Format:
      </p>
      <pre class="bg-gray-100 dark:bg-gray-800 p-2 mb-4 rounded overflow-x-auto"><%= ~s|{
  "data": [ /* Array von Objekten oder einzelnes Objekt */ ],
  "meta": {
    "api_version": "2.1"
  }
}| %></pre>

      <.heading level={3} class="text-xl text-gray-800 dark:text-gray-200 mt-6 mb-3">
        Query Parameter
      </.heading>
      <div class="overflow-x-auto mb-6">
        <table class="min-w-full text-sm bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700">
          <thead>
            <tr class="bg-gray-100 dark:bg-gray-900">
              <th class="py-2 px-4 border-b text-left">Parameter</th>
              <th class="py-2 px-4 border-b text-left">Endpunkte</th>
              <th class="py-2 px-4 border-b text-left">Beschreibung</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-2 px-4 border-b font-mono">start_date</td>
              <td class="py-2 px-4 border-b">periods</td>
              <td class="py-2 px-4 border-b">Startdatum im Format YYYY-MM-DD</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">end_date</td>
              <td class="py-2 px-4 border-b">periods</td>
              <td class="py-2 px-4 border-b">Enddatum im Format YYYY-MM-DD</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">type</td>
              <td class="py-2 px-4 border-b">periods</td>
              <td class="py-2 px-4 border-b">
                vacation (nur Ferien) oder holiday (nur Feiertage)
              </td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">year</td>
              <td class="py-2 px-4 border-b">icalendar</td>
              <td class="py-2 px-4 border-b">Jahr für den Export (Standard: aktuelles Jahr)</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">vacation_types</td>
              <td class="py-2 px-4 border-b">icalendar</td>
              <td class="py-2 px-4 border-b">school (nur Schulferien) oder all (alle)</td>
            </tr>
            <tr>
              <td class="py-2 px-4 border-b font-mono">calendar_year</td>
              <td class="py-2 px-4 border-b">icalendar</td>
              <td class="py-2 px-4 border-b">true für Kalenderjahr, sonst Schuljahr</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="mb-4">
        <strong>Vollständige API v2.1 Dokumentation:</strong>
        <.link
          href="https://github.com/mehr-schulferien-de/www.mehr-schulferien.de/blob/master/docs/api_v2.1.md"
          variant="primary"
          target="_blank"
        >
          API v2.1 Referenz auf GitHub
        </.link>
      </p>

      {render("developers_footer.html", assigns)}
    </div>
  </:content>
</.card>
