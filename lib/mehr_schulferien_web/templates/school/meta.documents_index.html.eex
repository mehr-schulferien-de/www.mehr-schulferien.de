<title><%= @page_title %></title>
<meta name="description" content="Erstellen Sie kostenlos Entschuldigungsschreiben, Beurlaubungen und Sportbefreiungen für <%= @school.name %>. Einfache Formulare, professionelle PDFs zum Download.">
<meta name="keywords" content="<%= @school.name %>, Entschuldigung, Beurlaubung, Sportbefreiung, Schulbriefe, <%= @city.name %>, <%= @federal_state.name %>">

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website">
<meta property="og:url" content="<%= Routes.school_url(@conn, :documents_index, @school.slug) %>">
<meta property="og:title" content="<%= @page_title %>">
<meta property="og:description" content="Erstellen Sie kostenlos Entschuldigungsschreiben, Beurlaubungen und Sportbefreiungen für <%= @school.name %>. Einfache Formulare, professionelle PDFs zum Download.">
<meta property="og:image" content="<%= Routes.static_url(@conn, "/images/entschuldigung-dummy.png") %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="mehr-schulferien.de">
<meta property="og:locale" content="de_DE">

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content="<%= Routes.school_url(@conn, :documents_index, @school.slug) %>">
<meta property="twitter:title" content="<%= @page_title %>">
<meta property="twitter:description" content="Erstellen Sie kostenlos Entschuldigungsschreiben, Beurlaubungen und Sportbefreiungen für <%= @school.name %>.">
<meta property="twitter:image" content="<%= Routes.static_url(@conn, "/images/entschuldigung-dummy.png") %>">