<div class="mt-0 sm:mt-1">
  <div>
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4">
      <.heading level={1} class="text-left">
        Schulferien
        <%= if String.contains?(@school.name, @city.name) do %>
          <% # Remove city name from school name and trim
          school_name_without_city = String.trim(String.replace(@school.name, @city.name, ""))
          # Determine if we need a comma
          needs_comma =
            school_name_without_city != "" and
              not String.ends_with?(school_name_without_city, ",") %>
          <%= school_name_without_city %><%= if needs_comma, do: ",", else: "" %> <%= link(
            @city.name,
            to: ~p"/ferien/#{@country.slug}/stadt/#{@city.slug}/#{@year}",
            class: "text-blue-600 hover:text-blue-800 cursor-pointer"
          ) %>
        <% else %>
          <%= @school.name %>, <%= link(@city.name,
            to: ~p"/ferien/#{@country.slug}/stadt/#{@city.slug}/#{@year}",
            class: "text-blue-600 hover:text-blue-800 cursor-pointer"
          ) %>
        <% end %>
      </.heading>

      <.pagination
        conn={@conn}
        country={@country}
        location={@school}
        location_type={:school}
        years_with_data={@years_with_data}
        year={@year}
      />
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
      <div class="lg:w-2/3">
        <.card padding="p-4">
          <:content>
            <%= if @has_data do %>
              <.periods_table periods={@periods} all_periods={@all_periods} today={@today} />
            <% else %>
              <.no_data
                conn={@conn}
                country={@country}
                federal_state={@federal_state}
                city={@city}
                school={@school}
                year={@year}
                years_with_data={@years_with_data}
              />
            <% end %>
            <!-- Bewegliche Ferientage Info Box -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mt-6">
              <.heading level={3} class="text-lg text-blue-900 mb-2 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  >
                  </path>
                </svg>
                Bewegliche Ferientage
              </.heading>
              <.text variant="small" class="text-blue-800 mb-3">
                Schulen können zusätzliche freie Tage selbst festlegen. Diese beweglichen Ferientage sind oft noch nicht in den offiziellen Ferienkalendern enthalten.
              </.text>
              <%= link to: "/wiki/schools/#{@school.slug}#bewegliche-ferientage",
                class: "inline-flex items-center px-3 py-2 text-sm font-medium text-blue-700 bg-white hover:bg-blue-100 border border-blue-300 rounded-md transition-colors" do %>
                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                  >
                  </path>
                </svg>
                Bewegliche Ferientage hinzufügen
              <% end %>
              <p class="text-xs text-blue-700 mt-2">
                Helfen Sie anderen Eltern und Schülern, indem Sie die beweglichen Ferientage dieser Schule eintragen.
              </p>
            </div>
          </:content>
        </.card>
      </div>
      <div class="lg:w-1/3">
        <.ical_panel
          conn={@conn}
          entity_slug={@school.slug}
          entity_name={@school.name}
          year={@year}
        />

        <.card padding="p-4" class="mt-6 relative">
          <:content>
            <.heading level={2} class="text-xl mb-3">Kontaktdaten</.heading>
            <%= if @school.address do %>
              <!-- Bearbeiten Button (top-right) -->
              <%= link to: "/wiki/schools/#{@school.slug}",
                  class: "absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-colors",
                  title: "Bearbeiten" do %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                  />
                </svg>
              <% end %>
              <!-- Address & Contact Info -->
              <div class="bg-gray-50 p-3 rounded-md border-l-4 border-blue-500 mb-3">
                <div class="font-semibold text-gray-900 text-sm mb-1">
                  <%= @school.name %>
                </div>
                <div class="text-sm text-gray-700 mb-2">
                  <%= @school.address.street %><br />
                  <%= @school.address.zip_code %> <%= link(@school.address.city,
                    to: ~p"/ferien/#{@country.slug}/stadt/#{@city.slug}/#{@year}",
                    class: "text-blue-600 hover:text-blue-800 cursor-pointer font-medium"
                  ) %>
                </div>
                <!-- Compact Contact Info -->
                <div class="space-y-1">
                  <%= if @school.address.email_address do %>
                    <div class="flex items-center text-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3 text-blue-600 mr-2"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        aria-hidden="true"
                        role="img"
                      >
                        <title>E-Mail</title>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        />
                      </svg>
                      <% email = @school.address.email_address %>
                      <a
                        href={"mailto:" <> email}
                        class="text-blue-600 hover:text-blue-800 cursor-pointer break-words"
                      >
                        <%= email %>
                      </a>
                    </div>
                  <% end %>
                  <%= if @school.address.phone_number do %>
                    <div class="flex items-center text-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3 text-green-600 mr-2"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        aria-hidden="true"
                        role="img"
                      >
                        <title>Telefon</title>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        />
                      </svg>
                      <% phone = @school.address.phone_number %>
                      <% tel_link =
                        MehrSchulferienWeb.Helpers.PhoneFormatterHelpers.format_tel_link(phone) %>
                      <% formatted_phone =
                        MehrSchulferienWeb.Helpers.PhoneFormatterHelpers.format_phone_number(
                          phone
                        ) %>
                      <a href={tel_link} class="text-blue-600 hover:text-blue-800 cursor-pointer">
                        <%= formatted_phone %>
                      </a>
                    </div>
                  <% end %>
                  <%= if @school.address.homepage_url do %>
                    <div class="flex items-center text-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3 w-3 text-blue-500 mr-2"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4v16m8-8H4"
                        />
                      </svg>
                      <% homepage_url = @school.address.homepage_url %>
                      <a
                        href={homepage_url}
                        class="text-blue-600 hover:text-blue-800 cursor-pointer break-all"
                        title={homepage_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <%= homepage_url %>
                      </a>
                    </div>
                  <% end %>
                  <!-- vCard Download Button as a small icon in the bottom-right corner -->
                </div>
                <div class="flex justify-end mt-1">
                  <%= link to: ~p"/ferien/#{@country.slug}/schule/#{@school.slug}/vcard",
                      class: "inline-flex items-center gap-1 p-1 rounded-full text-blue-500 hover:text-blue-700 hover:bg-blue-100 transition-colors text-xs font-medium",
                      title: "vCard herunterladen" do %>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      />
                    </svg>
                    vCard
                  <% end %>
                </div>
              </div>
              <!-- Links Section: Only Wikipedia if present -->
              <div class="grid grid-cols-2 gap-3 mt-4">
                <!-- Maps Column -->
                <div>
                  <.heading
                    level={3}
                    class="text-sm text-gray-500 uppercase tracking-wide mb-2 flex items-center"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 mr-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                      />
                    </svg>
                    Karten
                  </.heading>
                  <% map_query =
                    "#{@school.name}, #{@school.address.street}, #{@school.address.zip_code} #{@school.address.city}" %>
                  <ul class="space-y-1 list-disc pl-6 text-sm">
                    <li>
                      <a
                        href={MehrSchulferienWeb.Helpers.UrlHelpers.google_maps_url(map_query)}
                        class="text-blue-600 hover:text-blue-800 hover:underline cursor-pointer"
                      >
                        Google Maps
                      </a>
                    </li>
                    <li>
                      <a
                        href={MehrSchulferienWeb.Helpers.UrlHelpers.openstreetmap_url(map_query)}
                        class="text-blue-600 hover:text-blue-800 hover:underline cursor-pointer"
                      >
                        OpenStreetMap
                      </a>
                    </li>
                    <li>
                      <a
                        href={MehrSchulferienWeb.Helpers.UrlHelpers.apple_maps_url(map_query)}
                        class="text-blue-600 hover:text-blue-800 hover:underline cursor-pointer"
                      >
                        Apple Maps
                      </a>
                    </li>
                  </ul>
                </div>
                <!-- Wikipedia Link Only if present -->
                <%= if @school.address.wikipedia_url do %>
                  <div>
                    <.heading
                      level={3}
                      class="text-sm text-gray-500 uppercase tracking-wide mb-2 flex items-center"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 mr-1"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                        />
                      </svg>
                      Links
                    </.heading>
                    <ul class="space-y-1 list-disc pl-6 text-sm">
                      <li>
                        <a
                          href={@school.address.wikipedia_url}
                          class="text-blue-600 hover:text-blue-800 hover:underline cursor-pointer"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Wikipedia-Artikel
                        </a>
                      </li>
                    </ul>
                  </div>
                <% end %>
              </div>
            <% else %>
              <!-- Compact No Contact Data -->
              <div class="text-center py-4">
                <div class="w-8 h-8 mx-auto mb-2 bg-gray-100 rounded-full flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                </div>
                <p class="text-xs text-gray-500 mb-3">Keine Kontaktdaten verfügbar</p>
                <%= link to: "/wiki/schools/#{@school.slug}", 
                   class: "inline-flex items-center px-3 py-1 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded transition-colors cursor-pointer" do %>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3 w-3 mr-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Hinzufügen
                <% end %>
              </div>
            <% end %>
          </:content>
        </.card>
        <!-- Own Card for Entschuldigung schreiben and future links -->
        <.card padding="p-4" class="mt-4">
          <:content>
            <.heading level={3} class="text-lg mb-3 flex items-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 mr-2 text-teal-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16.5 3.5a2.121 2.121 0 013 3L7 19.5 3 21l1.5-4L16.5 3.5z"
                />
              </svg>
              Schreiben & Bescheinigungen
            </.heading>
            <div class="flex flex-col gap-2">
              <%= link to: "/briefe/#{@school.slug}/entschuldigung",
                 class: "flex items-center justify-center px-3 py-2 text-xs font-medium text-white bg-teal-600 hover:bg-teal-700 border border-teal-600 rounded transition-colors cursor-pointer shadow-sm w-full sm:w-auto" do %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3 mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 20h9"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16.5 3.5a2.121 2.121 0 013 3L7 19.5 3 21l1.5-4L16.5 3.5z"
                  />
                </svg>
                Entschuldigung schreiben
              <% end %>
              <%= link to: "/briefe/#{@school.slug}/beurlaubung",
                 class: "flex items-center justify-center px-3 py-2 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 border border-blue-600 rounded transition-colors cursor-pointer shadow-sm w-full sm:w-auto" do %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3 mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                  />
                </svg>
                Beurlaubung beantragen
              <% end %>
              <%= link to: "/briefe/#{@school.slug}/sportbefreiung",
                 class: "flex items-center justify-center px-3 py-2 text-xs font-medium text-white bg-purple-600 hover:bg-purple-700 border border-purple-600 rounded transition-colors cursor-pointer shadow-sm w-full sm:w-auto" do %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-3 w-3 mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  />
                </svg>
                Sportbefreiung beantragen
              <% end %>
            </div>
          </:content>
        </.card>
      </div>
    </div>

    <%= if @has_data do %>
      <div class="mt-8">
        <.heading level={2} class="text-xl sm:text-2xl mb-4">Kalenderansicht</.heading>

        <.calendar_legend />

        <% # Find the latest period end date
        latest_period_end_date =
          Enum.reduce(@periods, ~D[2000-01-01], fn period, latest ->
            if Date.compare(period.ends_on, latest) == :gt, do: period.ends_on, else: latest
          end)

        # Determine which months and years to show
        current_year = @year
        latest_year = latest_period_end_date.year
        latest_month = latest_period_end_date.month

        # Generate a list of all {year, month} pairs to display
        months_to_show =
          for year <- current_year..latest_year,
              month <- 1..12,
              year < latest_year || month <= latest_month,
              do: {year, month}

        # Group months by year for display
        months_by_year = Enum.group_by(months_to_show, fn {year, _month} -> year end) %>

        <%= for {year, year_months} <- Enum.sort_by(months_by_year, fn {year, _} -> year end) do %>
          <.heading level={3} class="text-lg text-gray-800 mb-4 mt-6">
            <%= year %><%= if year != current_year && year == latest_year,
              do: " (Januar bis #{@months[latest_month]})" %>
          </.heading>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
            <%= for {_, month} <- Enum.sort_by(year_months, fn {_, month} -> month end) do %>
              <.month_calendar
                month={month}
                year={year}
                periods={@periods}
                public_periods={@public_periods}
                all_periods={@all_periods}
              />
            <% end %>
          </div>
        <% end %>
      </div>

      <% # Use DateCalculations helper for date calculations
      date_data = MehrSchulferienWeb.Helpers.DateCalculations.calculate_surrounding_dates(@today)
      yesterday = date_data.yesterday
      tomorrow = date_data.tomorrow
      day_after_tomorrow = date_data.day_after_tomorrow

      # Use PeriodHelpers for filtering periods
      yesterdays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, yesterday)

      todays_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, @today)

      tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(@periods, tomorrow)

      day_after_tomorrows_school_free_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          @periods,
          day_after_tomorrow
        )

      # Find public holiday periods for specific days
      public_holidays =
        MehrSchulferienWeb.Helpers.PeriodHelpers.public_holiday_periods(@public_periods)

      yesterdays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          yesterday
        )

      todays_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, @today)

      tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(public_holidays, tomorrow)

      day_after_tomorrows_public_holiday_periods =
        MehrSchulferienWeb.Helpers.PeriodHelpers.periods_active_on_date(
          public_holidays,
          day_after_tomorrow
        ) %>

      <%= if @today.year == @year do %>
        <.faq
          conn={@conn}
          country={@country}
          federal_state={@federal_state}
          city={@city}
          school={@school}
          location={@school}
          next_schoolday={ViewHelpers.next_schoolday(@public_periods ++ @periods)}
          current_year={@year}
          today={@today}
          yesterday={yesterday}
          tomorrow={tomorrow}
          day_after_tomorrow={day_after_tomorrow}
          school_periods={@periods}
          public_periods={@public_periods}
          months={@months}
          yesterdays_school_free_periods={yesterdays_school_free_periods}
          todays_school_free_periods={todays_school_free_periods}
          tomorrows_school_free_periods={tomorrows_school_free_periods}
          day_after_tomorrows_school_free_periods={day_after_tomorrows_school_free_periods}
          yesterdays_public_holiday_periods={yesterdays_public_holiday_periods}
          todays_public_holiday_periods={todays_public_holiday_periods}
          tomorrows_public_holiday_periods={tomorrows_public_holiday_periods}
          day_after_tomorrows_public_holiday_periods={day_after_tomorrows_public_holiday_periods}
          nearby_schools={@nearby_schools}
        />
      <% end %>
    <% end %>

    <.schema_org_school
      school={@school}
      city={@city}
      federal_state={@federal_state}
      country={@country}
    />

    <.schema_org_event
      periods={@periods}
      school={@school}
      city={@city}
      federal_state={@federal_state}
      country={@country}
    />
  </div>
</div>
