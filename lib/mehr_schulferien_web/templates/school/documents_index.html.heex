<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="flex mb-4" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <!-- Home - Always visible -->
        <li class="inline-flex items-center">
          <%= link to: "/", class: "text-gray-700 hover:text-blue-600" do %>
            <svg
              class="w-4 h-4"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z">
              </path>
            </svg>
          <% end %>
        </li>
        <!-- Country - Hidden on mobile -->
        <li class="hidden md:inline-flex">
          <div class="flex items-center">
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <%= link to: Routes.country_path(@conn, :show, @country.slug), class: "ml-1 text-gray-700 hover:text-blue-600 md:ml-2" do %>
              <%= @country.name %>
            <% end %>
          </div>
        </li>
        <!-- Federal State - Hidden on mobile -->
        <li class="hidden md:inline-flex">
          <div class="flex items-center">
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <%= link to: Routes.federal_state_path(@conn, :show, @country.slug, @federal_state.slug), class: "ml-1 text-gray-700 hover:text-blue-600 md:ml-2" do %>
              <%= @federal_state.name %>
            <% end %>
          </div>
        </li>
        <!-- City - Hidden on mobile -->
        <li class="hidden md:inline-flex">
          <div class="flex items-center">
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <%= link to: Routes.city_path(@conn, :show_year, @country.slug, @city.slug, @current_year), class: "ml-1 text-gray-700 hover:text-blue-600 md:ml-2" do %>
              <%= @city.name %>
            <% end %>
          </div>
        </li>
        <!-- School - Always visible, truncated on mobile -->
        <li>
          <div class="flex items-center">
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <%= link to: Routes.school_path(@conn, :show_year, @country.slug, @school.slug, @current_year), class: "ml-1 text-gray-700 hover:text-blue-600 md:ml-2 truncate max-w-[120px] md:max-w-none", title: @school.name do %>
              <%= @school.name %>
            <% end %>
          </div>
        </li>
        <!-- Current page - Always visible -->
        <li aria-current="page">
          <div class="flex items-center">
            <svg
              class="w-6 h-6 text-gray-400"
              fill="currentColor"
              viewBox="0 0 20 20"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                clip-rule="evenodd"
              >
              </path>
            </svg>
            <span class="ml-1 text-gray-500 md:ml-2">Schreiben</span>
          </div>
        </li>
      </ol>
    </nav>

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 text-left">
        Schreiben für <%= @school.name %>
      </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- School Information Card -->
      <div class="lg:col-span-1">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 relative">
          <div class="flex items-start justify-between">
            <h2 class="hidden lg:block text-xl font-bold text-gray-900 mb-4">
              Schulinformationen
            </h2>
            <%= link to: "/wiki/schools/#{@school.slug}", 
                     class: "absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors",
                     title: "Schulinformationen bearbeiten" do %>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                />
              </svg>
            <% end %>
          </div>
          <%= if @school.address do %>
            <div class="space-y-4">
              <div class="flex items-start">
                <div class="flex-shrink-0">
                  <svg
                    class="h-6 w-6 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-gray-900"><%= @school.name %></p>
                  <p class="text-sm text-gray-500">
                    <%= @school.address.street %><br />
                    <%= @school.address.zip_code %> <%= @school.address.city %>
                  </p>
                </div>
              </div>
              <%= if @school.address.phone_number do %>
                <div class="flex items-center">
                  <svg
                    class="h-5 w-5 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    />
                  </svg>
                  <a
                    href={"tel:" <> String.replace(@school.address.phone_number, " ", "")}
                    class="ml-3 text-sm text-gray-500 hover:text-blue-600"
                  >
                    <%= @school.address.phone_number %>
                  </a>
                </div>
              <% end %>
              <%= if @school.address.email_address do %>
                <div class="flex items-center">
                  <svg
                    class="h-5 w-5 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                  <a
                    href={"mailto:" <> @school.address.email_address}
                    class="ml-3 text-sm text-gray-500 hover:text-blue-600"
                  >
                    <%= @school.address.email_address %>
                  </a>
                </div>
              <% end %>
              <%= if @school.address.homepage_url do %>
                <div class="flex items-center">
                  <svg
                    class="h-5 w-5 text-gray-400"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                    />
                  </svg>
                  <a
                    href={@school.address.homepage_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-3 text-sm text-gray-500 hover:text-blue-600"
                  >
                    <%= URI.parse(@school.address.homepage_url).host ||
                      @school.address.homepage_url %>
                  </a>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <!-- Vacation Calendar Card - Desktop position -->
        <div class="mt-6 hidden lg:block">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Ferienkalender</h3>

            <%= if @vacation_periods != [] do %>
              <div class="space-y-3 mb-4">
                <%= for period <- @vacation_periods do %>
                  <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                    <div>
                      <p class="text-sm font-medium text-gray-900">
                        <%= period.holiday_or_vacation_type.colloquial ||
                          period.holiday_or_vacation_type.name %>
                      </p>
                      <p class="text-sm text-gray-500">
                        <%= ViewHelpers.format_date_range(period.starts_on, period.ends_on, nil) %>
                      </p>
                    </div>
                    <div class="text-right">
                      <% days_until = Date.diff(period.starts_on, @today) %>
                      <%= if days_until > 0 do %>
                        <span class="text-sm text-gray-600">
                          in <%= days_until %> <%= if days_until == 1, do: "Tag", else: "Tagen" %>
                        </span>
                      <% else %>
                        <% days_remaining = Date.diff(period.ends_on, @today) %>
                        <%= if days_remaining >= 0 do %>
                          <span class="text-sm text-green-600 font-medium">
                            läuft gerade
                          </span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-gray-500 mb-4">
                Keine Ferien in den nächsten 6 Monaten.
              </p>
            <% end %>

            <%= link to: "/ferien/#{@country.slug}/schule/#{@school.slug}/#{@current_year}", 
                     class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-teal-700 bg-teal-100 hover:bg-teal-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500" do %>
              <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              Kompletten Ferienkalender anzeigen
            <% end %>
          </div>
        </div>
      </div>
      <!-- Available Documents -->
      <div class="lg:col-span-2">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Verfügbare Briefe</h2>
          <div class="space-y-4">
            <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex items-start">
                  <div class="flex-shrink-0">
                    <svg
                      class="h-8 w-8 text-teal-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                      />
                    </svg>
                  </div>
                  <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Entschuldigung</h3>
                    <p class="mt-1 text-sm text-gray-500">
                      Formular für die Entschuldigung von Fehlzeiten nach Krankheit oder anderen Gründen
                    </p>
                  </div>
                </div>
              </div>
              <div class="mt-4">
                <%= link to: "/briefe/#{@school.slug}/entschuldigung", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500" do %>
                  <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Schreiben erstellen
                <% end %>
              </div>
            </div>
            <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex items-start">
                  <div class="flex-shrink-0">
                    <svg
                      class="h-8 w-8 text-blue-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                  </div>
                  <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Beurlaubung</h3>
                    <p class="mt-1 text-sm text-gray-500">
                      Antrag auf Beurlaubung vom Unterricht für besondere Anlässe (vorab einzureichen)
                    </p>
                  </div>
                </div>
              </div>
              <div class="mt-4">
                <%= link to: "/briefe/#{@school.slug}/beurlaubung", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" do %>
                  <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Schreiben erstellen
                <% end %>
              </div>
            </div>
            <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between">
                <div class="flex items-start">
                  <div class="flex-shrink-0">
                    <svg
                      class="h-8 w-8 text-purple-600"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"
                      />
                    </svg>
                  </div>
                  <div class="ml-4">
                    <h3 class="text-lg font-medium text-gray-900">Sportbefreiung</h3>
                    <p class="mt-1 text-sm text-gray-500">
                      Antrag auf Befreiung vom Sportunterricht aus gesundheitlichen Gründen
                    </p>
                  </div>
                </div>
              </div>
              <div class="mt-4">
                <%= link to: "/briefe/#{@school.slug}/sportbefreiung", class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500" do %>
                  <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Schreiben erstellen
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <!-- Vacation Calendar Card - Mobile position -->
        <div class="mt-6 lg:hidden">
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Ferienkalender</h3>

            <%= if @vacation_periods != [] do %>
              <div class="space-y-3 mb-4">
                <%= for period <- @vacation_periods do %>
                  <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                    <div>
                      <p class="text-sm font-medium text-gray-900">
                        <%= period.holiday_or_vacation_type.colloquial ||
                          period.holiday_or_vacation_type.name %>
                      </p>
                      <p class="text-sm text-gray-500">
                        <%= ViewHelpers.format_date_range(period.starts_on, period.ends_on, nil) %>
                      </p>
                    </div>
                    <div class="text-right">
                      <% days_until = Date.diff(period.starts_on, @today) %>
                      <%= if days_until > 0 do %>
                        <span class="text-sm text-gray-600">
                          in <%= days_until %> <%= if days_until == 1, do: "Tag", else: "Tagen" %>
                        </span>
                      <% else %>
                        <% days_remaining = Date.diff(period.ends_on, @today) %>
                        <%= if days_remaining >= 0 do %>
                          <span class="text-sm text-green-600 font-medium">
                            läuft gerade
                          </span>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-gray-500 mb-4">
                Keine Ferien in den nächsten 6 Monaten.
              </p>
            <% end %>

            <%= link to: "/ferien/#{@country.slug}/schule/#{@school.slug}/#{@current_year}", 
                     class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-teal-700 bg-teal-100 hover:bg-teal-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500" do %>
              <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              Kompletten Ferienkalender anzeigen
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <!-- Open Source & Participation Card -->
    <MehrSchulferienWeb.Components.GitHubPromotionComponent.github_promotion
      locale="de"
      framework="bootstrap"
    />
  </div>
</div>
