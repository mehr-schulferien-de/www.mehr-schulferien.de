<title>
  Schulferien <%= @school.name %> <%= @year %> (<%= @city.name %>, <%= @federal_state.name %>)
</title>
<meta
  name="description"
  content={"Ferientermine und gesetzliche Feiertage #{@year} bis Juli #{@year + 1} für #{@school.name} in #{@city.name} (#{@federal_state.name})."}
/>

<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: @country.name, item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}"},
    %{name: "Ferientermine #{@federal_state.name}", item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}"},
    %{name: @city.name, item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/stadt/#{@city.slug}"},
    %{name: "#{@school.name} #{@year}", item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/schule/#{@school.slug}/#{@year}"}
  ]) %>
</script>
