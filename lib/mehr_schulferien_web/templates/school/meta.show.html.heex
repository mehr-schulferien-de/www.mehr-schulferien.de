<% # Navigational searchers type the school's name; the title leads with
# it and the description leads with the concrete benefit (the next
# vacation dates) to earn the click.
truncated_name = MehrSchulferienWeb.Helpers.SeoTitleHelper.truncate_school_name(@school.name, 50)

next_vacation =
  @periods
  |> Enum.filter(fn p ->
    p.holiday_or_vacation_type.default_is_school_vacation &&
      Date.compare(p.ends_on, @today) != :lt
  end)
  |> Enum.sort_by(& &1.starts_on, Date)
  |> List.first()

next_vacation_sentence =
  case next_vacation do
    nil ->
      nil

    period ->
      name = period.holiday_or_vacation_type.colloquial || period.holiday_or_vacation_type.name

      if Date.compare(period.starts_on, @today) == :gt do
        "Nächste Ferien: #{name} vom #{Calendar.strftime(period.starts_on, "%d.%m.")} bis #{Calendar.strftime(period.ends_on, "%d.%m.%Y")}."
      else
        "Aktuelle Ferien: #{name} bis #{Calendar.strftime(period.ends_on, "%d.%m.%Y")}."
      end
  end

meta_description =
  [
    next_vacation_sentence,
    "Alle Ferientermine, Feiertage und bewegliche Ferientage für #{@school.name} in #{@city.name} (#{@federal_state.name}) im Schuljahr #{@display_school_year}/#{@display_school_year + 1}."
  ]
  |> Enum.reject(&is_nil/1)
  |> Enum.join(" ") %>

<title>
  {truncated_name}: Ferien & freie Tage {@display_school_year}/{@display_school_year + 1}
</title>
<meta name="description" content={meta_description} />
<meta
  name="keywords"
  content={"Schulferien, #{@school.name}, #{@city.name}, #{@federal_state.name}, Ferientermine, #{@display_school_year}, Ferien"}
/>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={url(~p"/ferien/#{@country.slug}/schule/#{@school.slug}")} />
<meta
  property="og:title"
  content={"Schulferien #{@school.name} #{@display_school_year}/#{@display_school_year + 1}"}
/>
<meta
  property="og:description"
  content={"Aktuelle Schulferien und Ferientermine für #{@school.name} in #{@city.name} (#{@federal_state.name})."}
/>
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={url(~p"/ferien/#{@country.slug}/schule/#{@school.slug}")} />
<meta
  property="twitter:title"
  content={"Schulferien #{@school.name} #{@display_school_year}/#{@display_school_year + 1}"}
/>
<meta
  property="twitter:description"
  content={"Aktuelle Schulferien und Ferientermine für #{@school.name} in #{@city.name} (#{@federal_state.name})."}
/>

<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: @country.name, item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}"},
    %{name: "Ferientermine #{@federal_state.name}", item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}"},
    %{name: @city.name, item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/stadt/#{@city.slug}"},
    %{name: @school.name, item: "https://www.mehr-schulferien.de" <> ~p"/ferien/#{@country.slug}/schule/#{@school.slug}"}
  ]) %>
</script>
