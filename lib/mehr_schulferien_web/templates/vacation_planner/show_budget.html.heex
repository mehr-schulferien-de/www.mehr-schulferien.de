<div class="mt-6 sm:mt-8">
  <div class="mb-6">
    <.heading level={1}>
      {@days} Urlaubstage {@year} in {@federal_state.name} optimal planen
    </.heading>
    <%= if length(@optimal_windows) > 0 do %>
      <% best = hd(@optimal_windows) %>
      <.text variant="lead" class="mt-2 text-green-700 dark:text-green-400">
        Mit {@days} Urlaubstagen bis zu {best.total_free_days} freie Tage am Stück – außerhalb der Schulferien!
      </.text>
    <% else %>
      <.text variant="lead" class="mt-2 text-green-700 dark:text-green-400">
        Optimieren Sie Ihren Urlaub mit {@days} Tagen – außerhalb der Schulferien.
      </.text>
    <% end %>
  </div>
  
<!-- Variant Toggle -->
  <div class="inline-flex rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 p-1 mb-6">
    <a
      href={~p"/urlaubsplaner/#{@federal_state.slug}/#{format_days_url(@days)}/#{@year}"}
      class="px-4 py-2 text-sm font-medium rounded-md text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700"
    >
      Maximale Freizeit
    </a>
    <a
      href={~p"/urlaubsplaner-guenstig/#{@federal_state.slug}/#{format_days_url(@days)}/#{@year}"}
      class="px-4 py-2 text-sm font-medium rounded-md bg-green-600 text-white shadow-sm"
    >
      Außerhalb Schulferien (günstiger)
    </a>
  </div>
  
<!-- Results Section with Calendar View -->
  <%= if length(@distinct_results) > 0 do %>
    <.heading level={2} class="mb-4">Top Urlaubszeiträume (außerhalb Schulferien)</.heading>

    <.vacation_planner_legend />

    <%= for result <- @distinct_results do %>
      <div class={"mb-8 rounded-lg border p-4 #{if result.rank == 1, do: "bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border-green-200 dark:border-green-800", else: "bg-white dark:bg-gray-800 border-gray-200 dark:border-gray-700"}"}>
        <!-- Result Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class={"inline-flex items-center justify-center w-10 h-10 rounded-full text-lg font-bold #{if result.rank == 1, do: "bg-green-600 text-white", else: "bg-gray-200 dark:bg-gray-600 text-gray-700 dark:text-gray-200"}"}>
              {result.rank}
            </span>
            <div>
              <.heading level={4}>
                {format_date_range(result.start_date, result.end_date)}
              </.heading>
              <span class="text-sm text-gray-600 dark:text-gray-400">
                {calendar_days(result)} Kalendertage
              </span>
            </div>
          </div>
          <div class="flex items-center gap-2 mt-2 sm:mt-0">
            <span class="px-2 py-1 rounded text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300">
              Außerhalb Schulferien
            </span>
            <span class={"px-3 py-1 rounded-full text-sm font-medium #{efficiency_badge_class(result.efficiency_percentage)}"}>
              {format_efficiency(result.efficiency_percentage)} Effizienz
            </span>
            <%= if is_christmas_window?(result) do %>
              <span class="inline-flex items-center px-2 py-1 rounded text-xs bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                🎄 Weihnachten
              </span>
            <% end %>
          </div>
        </div>
        
<!-- Calendar Grid -->
        <.vacation_planner_calendar
          result={result}
          public_periods={@public_periods}
          vacation_dates={result.vacation_dates}
          school_vacation_periods={@school_vacation_periods}
        />
        
<!-- Stats Summary -->
        <div class="mt-4 pt-4 border-t dark:border-gray-600">
          <div class="flex flex-wrap gap-4 text-sm">
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-yellow-200 dark:bg-yellow-900 rounded"></div>
              <span><strong>{result.vacation_days_used}</strong> Urlaubstage</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-blue-200 dark:bg-blue-900 rounded"></div>
              <span><strong>{result.holiday_days}</strong> Feiertage</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-4 h-4 bg-gray-100 dark:bg-gray-800 rounded border border-gray-200 dark:border-gray-700">
              </div>
              <span><strong>{result.weekend_days}</strong> Wochenendtage</span>
            </div>
            <div class="flex items-center gap-2 ml-auto">
              <span class="text-gray-900 dark:text-white font-medium">→</span>
              <span class="font-bold text-green-600 dark:text-green-400 text-lg">
                {result.total_free_days} freie Tage
              </span>
            </div>
          </div>

          <%= if result.related_holidays && length(result.related_holidays) > 0 do %>
            <div class="mt-2 text-xs text-gray-500 dark:text-gray-400">
              Enthält: {format_holidays(result.related_holidays)}
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 rounded-lg p-4">
      <.text variant="base" class="text-yellow-800 dark:text-yellow-200">
        Für {@year} wurden keine Urlaubszeiträume außerhalb der Schulferien gefunden.
        Versuchen Sie die
        <a
          href={~p"/urlaubsplaner/#{@federal_state.slug}/#{format_days_url(@days)}/#{@year}"}
          class="underline"
        >
          normale Variante
        </a>
        für mehr Optionen.
      </.text>
    </div>
  <% end %>
  
<!-- Days and Year Navigation -->
  <div class="mt-8 border-t dark:border-gray-700 pt-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Days Selection -->
      <div>
        <.heading level={3}>Urlaubstage ändern</.heading>
        <div class="flex flex-wrap gap-2 mt-4">
          <%= for days <- quick_day_options() do %>
            <a
              href={
                ~p"/urlaubsplaner-guenstig/#{@federal_state.slug}/#{format_days_url(days)}/#{@year}"
              }
              class={"px-3 py-1 rounded font-medium #{if @days == days, do: "bg-green-600 text-white", else: "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600"}"}
            >
              {days} Tage
            </a>
          <% end %>
        </div>

        <details class="mt-4">
          <summary class="cursor-pointer text-green-600 dark:text-green-400 hover:underline">
            Alle Tage anzeigen (1-60)
          </summary>
          <div class="mt-2 grid grid-cols-10 gap-1 text-sm">
            <%= for days <- 1..60 do %>
              <a
                href={
                  ~p"/urlaubsplaner-guenstig/#{@federal_state.slug}/#{format_days_url(days)}/#{@year}"
                }
                class={"px-2 py-1 text-center rounded #{if @days == days, do: "bg-green-600 text-white", else: "bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600"}"}
              >
                {days}
              </a>
            <% end %>
          </div>
        </details>
      </div>
      
<!-- Year Selection -->
      <div>
        <.heading level={3}>Jahr ändern</.heading>
        <% current_year = Date.utc_today().year %>
        <% year_range = (current_year - 1)..(current_year + 3) %>
        <div class="flex flex-wrap gap-2 mt-4">
          <%= for year <- year_range do %>
            <a
              href={
                ~p"/urlaubsplaner-guenstig/#{@federal_state.slug}/#{format_days_url(@days)}/#{year}"
              }
              class={"px-3 py-1 rounded font-medium #{if @year == year, do: "bg-green-600 text-white", else: "bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-gray-600"}"}
            >
              {year}
            </a>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  
<!-- Related Links -->
  <div class="mt-12 border-t dark:border-gray-700 pt-8">
    <.heading level={3}>Weitere Informationen für {@federal_state.name}</.heading>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
      <a
        href={~p"/ferien/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}"}
        class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-md border border-gray-200 dark:border-gray-700"
      >
        <strong class="text-gray-900 dark:text-white">Schulferien {@year}</strong>
        <p class="text-sm text-gray-600 dark:text-gray-400">Alle Ferientermine im Überblick</p>
      </a>
      <a
        href={~p"/brueckentage/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}"}
        class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-md border border-gray-200 dark:border-gray-700"
      >
        <strong class="text-gray-900 dark:text-white">Brückentage {@year}</strong>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Kurze Urlaubsoptimierung (1-4 Tage)
        </p>
      </a>
      <a
        href={~p"/urlaubsplaner/#{@federal_state.slug}/#{format_days_url(@days)}/#{@year}"}
        class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow hover:shadow-md border border-gray-200 dark:border-gray-700"
      >
        <strong class="text-gray-900 dark:text-white">Normal-Variante</strong>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Maximale Freizeit (inkl. Schulferien)
        </p>
      </a>
    </div>
    
<!-- Other Federal States -->
    <details class="mt-6">
      <summary class="cursor-pointer text-green-600 dark:text-green-400 hover:underline">
        Urlaubsplaner für andere Bundesländer
      </summary>
      <div class="mt-2 grid grid-cols-2 md:grid-cols-4 gap-2">
        <%= for state <- @all_federal_states do %>
          <a
            href={~p"/urlaubsplaner-guenstig/#{state.slug}/#{format_days_url(@days)}/#{@year}"}
            class="text-sm text-green-600 dark:text-green-400 hover:underline"
          >
            {state.name}
          </a>
        <% end %>
      </div>
    </details>
  </div>
  
<!-- Explanation Section -->
  <div class="mt-12 border-t dark:border-gray-700 pt-8">
    <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg p-4">
      <.heading level={3} class="text-green-800 dark:text-green-300">
        So funktioniert der Urlaubsplaner (Günstig-Variante)
      </.heading>
      <.text variant="base" class="mt-2 text-green-700 dark:text-green-200">
        Diese Variante zeigt optimale Urlaubszeiträume, die <strong>nicht in die Schulferien fallen</strong>.
        Hotels und Flüge sind dann oft deutlich günstiger, da weniger Familien verreisen.
        Ideal für kinderlose Paare und flexible Arbeitnehmer.
      </.text>
      <ul class="list-disc ml-5 mt-2 text-green-700 dark:text-green-200 text-sm">
        <li><strong>Günstiger</strong>: Reisen außerhalb der Hochsaison</li>
        <li><strong>Weniger Touristen</strong>: Beliebte Ziele sind leerer</li>
        <li>
          <strong>Feiertage nutzen</strong>: Wochenenden und Feiertage für maximale Effizienz
        </li>
      </ul>
    </div>
  </div>
</div>
