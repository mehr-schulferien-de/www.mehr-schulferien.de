<% canonical_url =
  "https://www.mehr-schulferien.de/feiertage/#{@country.slug}/bundesland/#{@federal_state.slug}/#{@year}"

page_title = "Feiertage #{@federal_state.name} #{@year}: alle gesetzlichen Feiertage"

meta_description =
  if @has_data do
    "Feiertage #{@federal_state.name} #{@year}: #{length(@holidays)} gesetzliche Feiertage mit Datum und Wochentag – inklusive Brückentage-Tipps und Schulferien."
  else
    "Feiertage #{@federal_state.name} #{@year}: alle gesetzlichen Feiertage mit Datum und Wochentag."
  end %>

<title>{page_title}</title>
<meta name="description" content={meta_description} />
<meta
  name="keywords"
  content={"Feiertage #{@federal_state.name} #{@year}, gesetzliche Feiertage #{@federal_state.name}, Feiertage #{@year}"}
/>
<link rel="canonical" href={canonical_url} />

<%= if assigns[:noindex] do %>
  <meta name="robots" content="noindex,nofollow" />
<% end %>
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical_url} />
<meta property="og:title" content={page_title} />
<meta property="og:description" content={meta_description} />
<meta property="og:site_name" content="mehr-schulferien.de" />
<meta property="og:locale" content="de_DE" />
<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical_url} />
<meta property="twitter:title" content={page_title} />
<meta property="twitter:description" content={meta_description} />
<!-- Breadcrumb Navigation -->
<script type="application/ld+json">
  <%= MehrSchulferienWeb.ViewHelpers.jsonld_breadcrumb([
    %{name: "Startseite", item: "https://www.mehr-schulferien.de"},
    %{name: "Feiertage Deutschland", item: "https://www.mehr-schulferien.de/feiertage/#{@country.slug}"},
    %{name: "Feiertage #{@federal_state.name}", item: "https://www.mehr-schulferien.de/feiertage/#{@country.slug}/bundesland/#{@federal_state.slug}"},
    %{name: "Feiertage #{@federal_state.name} #{@year}", item: canonical_url}
  ]) %>
</script>
