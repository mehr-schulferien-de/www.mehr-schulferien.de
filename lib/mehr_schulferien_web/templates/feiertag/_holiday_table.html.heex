<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
    <thead>
      <tr>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
          Datum
        </th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
          Wochentag
        </th>
        <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
          Feiertag
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <%= for period <- @holidays do %>
        <tr>
          <td class="px-3 py-2 text-sm font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">
            {Calendar.strftime(period.starts_on, "%d.%m.%Y")}
          </td>
          <td class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300">
            {weekday_name(period.starts_on)}
            <%= if weekend?(period.starts_on) do %>
              <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                Wochenende
              </span>
            <% end %>
          </td>
          <td class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300">
            {period.holiday_or_vacation_type.name}
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
