<div class="mt-6 sm:mt-8">
  <.heading level={1} class="mb-4">Feiertage in Deutschland</.heading>

  <%= if @has_data do %>
    <.text class="text-gray-700 dark:text-gray-300 mb-6">
      Alle gesetzlichen Feiertage {@current_year} und {@next_year} – bundesweit und je Bundesland.
    </.text>

    <%= for {year, rows} <- @holidays_by_year do %>
      <%= if rows != [] do %>
        <section class="mb-8">
          <div class="flex items-center justify-between mb-3">
            <.heading level={2} class="text-xl">Feiertage {year}</.heading>
            <a
              href={~p"/feiertage/#{@country.slug}/#{year}"}
              class="text-sm text-blue-600 hover:text-blue-800"
            >
              Alle Details {year} →
            </a>
          </div>
          <.card padding="p-4">
            <:content>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                  <thead>
                    <tr>
                      <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Datum
                      </th>
                      <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Feiertag
                      </th>
                      <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                        Gilt in
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    <%= for row <- rows do %>
                      <tr>
                        <td class="px-3 py-2 text-sm font-medium text-gray-900 dark:text-gray-100 whitespace-nowrap">
                          {Calendar.strftime(row.period.starts_on, "%d.%m.%Y")} ({weekday_name(
                            row.period.starts_on
                          )})
                        </td>
                        <td class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300">
                          {row.period.holiday_or_vacation_type.name}
                        </td>
                        <td class="px-3 py-2 text-sm text-gray-700 dark:text-gray-300">
                          <%= if row.states == :all do %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300">
                              bundesweit
                            </span>
                          <% else %>
                            {states_label(row.states)}
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </:content>
          </.card>
        </section>
      <% end %>
    <% end %>

    <section class="mt-8">
      <.heading level={2} class="text-xl mb-4">Feiertage nach Bundesland</.heading>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <%= for state <- @states do %>
          <a
            href={~p"/feiertage/#{@country.slug}/bundesland/#{state.slug}"}
            class="text-sm text-blue-600 hover:text-blue-800 hover:underline"
          >
            Feiertage {state.name}
          </a>
        <% end %>
      </div>
    </section>
  <% else %>
    <.card padding="p-6">
      <:content>
        <.text class="text-gray-700 dark:text-gray-300">
          Aktuell liegen keine Feiertagstermine vor.
        </.text>
      </:content>
    </.card>
  <% end %>
</div>
