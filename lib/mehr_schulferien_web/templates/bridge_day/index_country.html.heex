<div class="mt-6 sm:mt-8">
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">
    Brückentage {@year} in Deutschland
  </h1>
  <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-3xl">
    Mit wenigen gezielt gesetzten Urlaubstagen werden aus Feiertagen lange
    Wochenenden. Hier finden Sie die Brückentage {@year} für alle {length(@states_with_counts)} Bundesländer: Bundesland auswählen und die
    Termine samt Urlaubstage-Rechnung ansehen.
  </p>

  <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%= for {federal_state, count} <- @states_with_counts do %>
      <%= if count > 0 do %>
        <a
          href={~p"/brueckentage/#{@country.slug}/bundesland/#{federal_state.slug}/#{@year}"}
          class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-sm transition"
        >
          <div class="font-semibold text-gray-900 dark:text-gray-100">
            {federal_state.name}
          </div>
          <div class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            {count} {if count == 1, do: "Chance", else: "Chancen"} auf ein langes Wochenende
          </div>
        </a>
      <% else %>
        <div class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/50 p-4">
          <div class="font-semibold text-gray-400 dark:text-gray-500">
            {federal_state.name}
          </div>
          <div class="mt-1 text-sm text-gray-400 dark:text-gray-500">
            Noch keine Termine für {@year}
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
