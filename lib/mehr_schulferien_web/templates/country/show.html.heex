<!-- Breadcrumb navigation -->
<nav class="bg-white shadow-sm mb-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center space-x-2 py-3 text-sm">
      <%= link to: ~p"/", class: "text-gray-500 hover:text-gray-700 transition-colors duration-200" do %>
        <span>Start</span>
      <% end %>
      <span class="text-gray-400">/</span>
      <span class="text-gray-700 font-semibold">{@country.name}</span>
    </div>
  </div>
</nav>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <.heading level={1}>
      Schulferien {@current_year}
    </.heading>
  </div>

  <.card padding="p-4 sm:p-6">
    <:content>
      {render(MehrSchulferienWeb.PartialView, "_country_periods_table.html", assigns)}
    </:content>
  </.card>
</div>
