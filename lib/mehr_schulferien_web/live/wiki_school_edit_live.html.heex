<div class="max-w-6xl mx-auto py-6">
  <!-- Flash messages -->
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
      <p class="text-green-800 dark:text-green-300">
        {Phoenix.Flash.get(@flash, :info)}
      </p>
    </div>
  <% end %>

  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
      <p class="text-red-800 dark:text-red-300">
        {Phoenix.Flash.get(@flash, :error)}
      </p>
    </div>
  <% end %>
  
<!-- Header with Navigation -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
      Schul-Wiki: {@school.name}
    </h1>
    <p class="text-gray-600 dark:text-gray-400 mb-4">
      Bearbeiten Sie die Adressdaten dieser Schule. Alle Änderungen werden protokolliert.
    </p>
    <!-- Navigation Tabs -->
    <div class="border-b border-gray-200 dark:border-gray-700">
      <nav class="-mb-px flex space-x-8">
        <span class="border-b-2 border-blue-500 py-2 px-1 text-sm font-medium text-blue-600 dark:text-blue-400">
          Stammdaten
        </span>
        {link("Bewegliche Ferientage",
          to: ~p"/wiki/schools/#{@school.slug}/ferientage",
          class:
            "border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600"
        )}
      </nav>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Edit Form - Left Column -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
          Adressdaten bearbeiten
        </h2>

        <%= if @limit_reached do %>
          <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
            <p class="text-red-800 dark:text-red-300 text-sm">
              <strong>Tageslimit erreicht:</strong>
              Es können heute keine weiteren Änderungen vorgenommen werden.
              Versuchen Sie es morgen erneut.
            </p>
          </div>
        <% end %>

        <%= if @show_new_school_hint do %>
          <div
            id="new-school-hint"
            class="mb-4 p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-300 dark:border-amber-700 rounded-lg"
          >
            <div class="flex">
              <div class="flex-shrink-0">
                <svg
                  class="h-5 w-5 text-amber-400"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-amber-800 dark:text-amber-200">
                  Möchten Sie eine neue Schule anlegen?
                </h3>
                <div class="mt-2 text-sm text-amber-700 dark:text-amber-300">
                  <p>
                    Sie haben die Postleitzahl geändert. Wenn Sie eine
                    <strong>andere Schule</strong>
                    hinzufügen möchten, nutzen Sie bitte die Funktion "Neue Schule anlegen".
                  </p>
                  <p class="mt-2">
                    <a
                      href={~p"/wiki/schools/new"}
                      class="font-medium text-amber-800 dark:text-amber-200 underline hover:text-amber-900 dark:hover:text-amber-100"
                    >
                      Hier klicken, um eine neue Schule anzulegen →
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        {Phoenix.View.render(MehrSchulferienWeb.WikiView, "_school_form.html",
          changeset: @changeset,
          limit_reached: @limit_reached,
          school_name: Map.get(@changeset.data, :name) || @school.name || "",
          address: @school.address,
          disable_zip_code: false,
          submit_text: "Änderungen speichern",
          submit_class: "bg-blue-600 hover:bg-blue-700",
          submit_focus_class: "focus:ring-blue-500",
          existing_schools: [],
          zip_code_valid: nil
        )}
      </div>
    </div>
    
<!-- Version History Timeline - Right Column -->
    <div class="space-y-6">
      <!-- Add New School Button - Prominent placement -->
      <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-4">
        <h3 class="text-sm font-semibold text-blue-900 dark:text-blue-100 mb-2">
          Schule nicht gefunden?
        </h3>
        <p class="text-sm text-blue-700 dark:text-blue-300 mb-3">
          Wenn Sie eine neue Schule hinzufügen möchten (anstatt diese zu bearbeiten), nutzen Sie bitte die Funktion "Neue Schule anlegen".
        </p>
        <a
          href={~p"/wiki/schools/new"}
          class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 6v6m0 0v6m0-6h6m-6 0H6"
            />
          </svg>
          Neue Schule anlegen
        </a>
      </div>
      
<!-- Delete School Button (Gefahrenzone) -->
      <div class="bg-white dark:bg-gray-800 shadow-sm border border-red-200 dark:border-red-700 rounded-lg p-6">
        <h3 class="text-lg font-semibold text-red-900 dark:text-red-100 mb-2">
          Gefahrenzone
        </h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          Diese Aktion kann nicht rückgängig gemacht werden.
        </p>
        <button
          phx-click="show_delete_confirmation"
          class="inline-flex items-center px-4 py-2 border border-red-300 dark:border-red-600 rounded-md shadow-sm text-sm font-medium text-red-700 dark:text-red-300 bg-white dark:bg-gray-700 hover:bg-red-50 dark:hover:bg-red-900/20 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
        >
          <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
            />
          </svg>
          Schule löschen
        </button>
      </div>
      
<!-- Version History Timeline -->
      <div class="bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
        <div class="p-6 border-b border-gray-200 dark:border-gray-700">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
            Versionshistorie
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
            {length(@versions)} Änderungen
          </p>
        </div>

        <%= if @versions == [] do %>
          <div class="p-6 text-center text-gray-500 dark:text-gray-400">
            Noch keine Änderungen vorhanden.
          </div>
        <% else %>
          <!-- Timeline -->
          <div class="p-6">
            <div class="relative">
              <!-- Timeline Line -->
              <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700">
              </div>
              
<!-- Timeline Items -->
              <div class="space-y-6">
                <%= for {version, index} <- Enum.with_index(@versions) do %>
                  <div class="relative flex items-start">
                    <!-- Timeline Dot -->
                    <div class={"absolute left-2.5 w-3 h-3 rounded-full border-2 #{if index == 0, do: "bg-blue-500 border-blue-500", else: "bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-600"}"}>
                    </div>
                    
<!-- Content -->
                    <div class="ml-10 flex-1">
                      <div class="bg-gray-50 dark:bg-gray-900 rounded-lg p-4 hover:shadow-md transition-shadow">
                        <!-- Header -->
                        <div class="flex items-start justify-between mb-2">
                          <div>
                            <h4 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
                              {version.description || "Änderung"}
                            </h4>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                              {MehrSchulferienWeb.Formatters.DateFormatter.format_datetime(
                                version.inserted_at
                              )}
                            </p>
                          </div>

                          <%= if not @limit_reached and version.snapshot do %>
                            <button
                              phx-click="show_rollback_preview"
                              phx-value-version_id={version.id}
                              class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-900/50 transition-colors"
                            >
                              <svg
                                class="w-3 h-3 mr-1"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                                >
                                </path>
                              </svg>
                              Wiederherstellen
                            </button>
                          <% end %>
                        </div>
                        
<!-- Changed Fields -->
                        <%= if map_size(version.changes) > 0 do %>
                          <div class="mt-2 flex flex-wrap gap-1">
                            <%= for {field, _value} <- version.changes do %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
                                {field}
                              </span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
      
<!-- Daily Limit Info -->
      {Phoenix.View.render(MehrSchulferienWeb.WikiView, "_daily_limit_info.html",
        daily_changes: @daily_changes
      )}
    </div>
  </div>
  
<!-- Back to School Link -->
  <div class="mt-8 text-center">
    <a
      href={~p"/ferien/d/schule/#{@school.slug}"}
      class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
    >
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>
      Zurück zur Schulseite
    </a>
  </div>
</div>

<!-- Rollback Preview Modal -->
<%= if @show_rollback_preview && @rollback_version do %>
  <div
    class="fixed z-50 inset-0 overflow-y-auto"
    aria-labelledby="modal-title"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <!-- Background overlay -->
      <div
        class="fixed inset-0 bg-gray-500 dark:bg-gray-800 bg-opacity-75 dark:bg-opacity-75 transition-opacity"
        aria-hidden="true"
      >
      </div>
      
<!-- This element is to trick the browser into centering the modal contents. -->
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">
        &#8203;
      </span>
      
<!-- Modal panel -->
      <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-3xl sm:w-full">
        <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-yellow-100 dark:bg-yellow-900/30 sm:mx-0 sm:h-10 sm:w-10">
              <svg
                class="h-6 w-6 text-yellow-600 dark:text-yellow-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                >
                </path>
              </svg>
            </div>
            <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-grow">
              <h3
                class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-100"
                id="modal-title"
              >
                Version wiederherstellen
              </h3>
              <div class="mt-2">
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  Möchten Sie zu dieser Version zurückkehren?
                </p>
              </div>

              <%= if @rollback_version.snapshot do %>
                <div class="mt-4">
                  <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
                    Vorschau der Änderungen:
                  </h4>

                  <div class="space-y-4">
                    <!-- Compare Current vs Rollback -->
                    <div class="grid grid-cols-2 gap-4">
                      <!-- Current State -->
                      <div class="bg-red-50 dark:bg-red-900/20 rounded-lg p-3">
                        <h5 class="text-xs font-semibold text-red-700 dark:text-red-300 mb-2">
                          Aktueller Zustand
                        </h5>
                        <dl class="space-y-1">
                          <div>
                            <dt class="text-xs text-gray-600 dark:text-gray-400">Schulname:</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">
                              {@school.name}
                            </dd>
                          </div>
                          <%= if @school.address do %>
                            <%= if @school.address.street do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Straße:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {@school.address.street}
                                </dd>
                              </div>
                            <% end %>
                            <%= if @school.address.zip_code || @school.address.city do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Ort:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {@school.address.zip_code || ""} {@school.address.city || ""}
                                </dd>
                              </div>
                            <% end %>
                            <%= if @school.address.phone_number do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Telefon:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {@school.address.phone_number}
                                </dd>
                              </div>
                            <% end %>
                            <%= if @school.address.homepage_url do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">
                                  Homepage:
                                </dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100 truncate">
                                  {@school.address.homepage_url}
                                </dd>
                              </div>
                            <% end %>
                            <%= if @school.address.schuelerzeitung_url do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">
                                  Schülerzeitung:
                                </dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100 truncate">
                                  {@school.address.schuelerzeitung_url}
                                </dd>
                              </div>
                            <% end %>
                          <% end %>
                        </dl>
                      </div>
                      
<!-- Rollback State -->
                      <div class="bg-green-50 dark:bg-green-900/20 rounded-lg p-3">
                        <h5 class="text-xs font-semibold text-green-700 dark:text-green-300 mb-2">
                          Nach Wiederherstellung
                        </h5>
                        <dl class="space-y-1">
                          <div>
                            <dt class="text-xs text-gray-600 dark:text-gray-400">Schulname:</dt>
                            <dd class="text-sm font-medium text-gray-900 dark:text-gray-100">
                              {Map.get(@rollback_version.snapshot, "name", "")}
                            </dd>
                          </div>
                          <%= if Map.get(@rollback_version.snapshot, "address") do %>
                            <% address = Map.get(@rollback_version.snapshot, "address") %>
                            <%= if Map.get(address, "street") do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Straße:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {Map.get(address, "street")}
                                </dd>
                              </div>
                            <% end %>
                            <%= if Map.get(address, "zip_code") || Map.get(address, "city") do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Ort:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {Map.get(address, "zip_code", "")} {Map.get(address, "city", "")}
                                </dd>
                              </div>
                            <% end %>
                            <%= if Map.get(address, "phone_number") do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">Telefon:</dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100">
                                  {Map.get(address, "phone_number")}
                                </dd>
                              </div>
                            <% end %>
                            <%= if Map.get(address, "homepage_url") do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">
                                  Homepage:
                                </dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100 truncate">
                                  {Map.get(address, "homepage_url")}
                                </dd>
                              </div>
                            <% end %>
                            <%= if Map.get(address, "schuelerzeitung_url") do %>
                              <div>
                                <dt class="text-xs text-gray-600 dark:text-gray-400">
                                  Schülerzeitung:
                                </dt>
                                <dd class="text-sm text-gray-900 dark:text-gray-100 truncate">
                                  {Map.get(address, "schuelerzeitung_url")}
                                </dd>
                              </div>
                            <% end %>
                          <% end %>
                        </dl>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
          <button
            type="button"
            phx-click="confirm_rollback"
            phx-value-version_id={@rollback_version.id}
            class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-yellow-600 dark:bg-yellow-500 text-base font-medium text-white hover:bg-yellow-700 dark:hover:bg-yellow-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 sm:ml-3 sm:w-auto sm:text-sm"
          >
            Wiederherstellen
          </button>
          <button
            type="button"
            phx-click="cancel_rollback"
            class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
          >
            Abbrechen
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Delete Confirmation Modal -->
<%= if @show_delete_confirmation do %>
  <div
    class="fixed z-50 inset-0 overflow-y-auto"
    aria-labelledby="delete-modal-title"
    role="dialog"
    aria-modal="true"
  >
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
      <!-- Background overlay -->
      <div
        class="fixed inset-0 bg-gray-500 dark:bg-gray-800 bg-opacity-75 dark:bg-opacity-75 transition-opacity"
        aria-hidden="true"
      >
      </div>
      
<!-- This element is to trick the browser into centering the modal contents. -->
      <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">
        &#8203;
      </span>
      
<!-- Modal panel -->
      <div class="inline-block align-bottom bg-white dark:bg-gray-800 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
        <form phx-submit="confirm_delete">
          <div class="bg-white dark:bg-gray-800 px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <div class="sm:flex sm:items-start">
              <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 dark:bg-red-900/30 sm:mx-0 sm:h-10 sm:w-10">
                <svg
                  class="h-6 w-6 text-red-600 dark:text-red-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  >
                  </path>
                </svg>
              </div>
              <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left flex-grow">
                <h3
                  class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-100"
                  id="delete-modal-title"
                >
                  Schule löschen
                </h3>
                <div class="mt-2">
                  <p class="text-sm text-gray-500 dark:text-gray-400">
                    Sind Sie sicher, dass Sie die Schule <strong>{@school.name}</strong>
                    löschen möchten?
                  </p>
                  <p class="text-sm text-red-600 dark:text-red-400 mt-2">
                    <strong>Warnung:</strong> Diese Aktion kann nicht rückgängig gemacht werden!
                  </p>
                </div>
                
<!-- Security Question -->
                <div class="mt-4">
                  <label
                    for="zip_code_confirmation"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                  >
                    Zur Bestätigung geben Sie bitte die Postleitzahl der Schule ein:
                  </label>
                  <%= if @school.address && @school.address.zip_code do %>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                      (Hinweis: {@school.address.zip_code})
                    </p>
                  <% end %>
                  <input
                    type="text"
                    name="zip_code_confirmation"
                    id="zip_code_confirmation"
                    required
                    class="mt-2 block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-700 focus:outline-none focus:ring-red-500 focus:border-red-500 sm:text-sm"
                    placeholder="PLZ eingeben"
                  />
                  <%= if @delete_error do %>
                    <p class="mt-2 text-sm text-red-600 dark:text-red-400">
                      {@delete_error}
                    </p>
                  <% end %>
                </div>
                
<!-- Deletion Reason -->
                <div class="mt-4">
                  <label
                    for="deletion_reason"
                    class="block text-sm font-medium text-gray-700 dark:text-gray-300"
                  >
                    Grund für die Löschung (optional):
                  </label>
                  <textarea
                    name="deletion_reason"
                    id="deletion_reason"
                    rows="3"
                    class="mt-2 block w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm text-gray-900 dark:text-gray-100 bg-white dark:bg-gray-700 focus:outline-none focus:ring-red-500 focus:border-red-500 sm:text-sm"
                    placeholder="z.B. Schule wurde geschlossen, Duplikat, etc."
                  ></textarea>
                </div>
              </div>
            </div>
          </div>
          <div class="bg-gray-50 dark:bg-gray-700 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
            <button
              type="submit"
              class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 dark:bg-red-500 text-base font-medium text-white hover:bg-red-700 dark:hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm"
            >
              Endgültig löschen
            </button>
            <button
              type="button"
              phx-click="cancel_delete"
              class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm"
            >
              Abbrechen
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>
