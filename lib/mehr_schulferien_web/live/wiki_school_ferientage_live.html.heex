<div
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8"
  id="ferientage-container"
  phx-hook="ScrollToTop"
>
  <!-- Flash messages -->
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div class="mb-4 p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
      <p class="text-green-800 dark:text-green-300">
        {Phoenix.Flash.get(@flash, :info)}
      </p>
    </div>
  <% end %>

  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div class="mb-4 p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
      <p class="text-red-800 dark:text-red-300">
        {Phoenix.Flash.get(@flash, :error)}
      </p>
    </div>
  <% end %>
  <!-- Header with Navigation -->
  <div class="mb-6 sm:mb-8">
    <div class="mb-4 sm:mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        Schul-Wiki: <span class="text-blue-600 dark:text-blue-400">{@school.name}</span>
      </h1>
      <p class="text-sm sm:text-base text-gray-600 dark:text-gray-400">
        Verwalten Sie die beweglichen Ferientage dieser Schule.
      </p>
    </div>
    <!-- Navigation Tabs -->
    <div class="border-b border-gray-200 dark:border-gray-700 -mx-4 sm:mx-0">
      <nav class="-mb-px flex space-x-4 sm:space-x-8 px-4 sm:px-0">
        {link("Stammdaten",
          to: ~p"/wiki/schools/#{@school.slug}/edit",
          class:
            "whitespace-nowrap border-b-2 border-transparent py-3 px-1 text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
        )}
        <span class="whitespace-nowrap border-b-2 border-blue-500 py-3 px-1 text-sm font-medium text-blue-600 dark:text-blue-400">
          Bewegliche Ferientage
        </span>
      </nav>
    </div>
  </div>
  <!-- Check if federal state allows bewegliche Ferientage at all -->
  <%= if length(@school_years_data) == 0 do %>
    <div class="max-w-3xl mx-auto">
      <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 text-center">
        <svg
          class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500 mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <h2 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-2">
          Keine beweglichen Ferientage verfügbar
        </h2>
        <p class="text-gray-600 dark:text-gray-400">
          <%= if @federal_state do %>
            Im Bundesland {@federal_state.name} sind keine beweglichen Ferientage vorgesehen.
          <% else %>
            Für diese Schule sind keine beweglichen Ferientage verfügbar.
          <% end %>
        </p>
        <div class="mt-6">
          <a
            href={~p"/ferien/d/schule/#{@school.slug}"}
            class="inline-flex items-center px-4 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all hover:shadow-md"
          >
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Zurück zur Schulseite
          </a>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Normal content when bewegliche Ferientage are allowed -->
    <!-- School Year Selector -->
    <div class="mb-6">
      <div class="flex flex-col gap-4">
        <!-- Year Navigation -->
        <div class="flex justify-center">
          <div class="inline-flex items-center bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm">
            <!-- Previous Year Button -->
            <button
              type="button"
              phx-click="navigate_year"
              phx-value-direction="prev"
              disabled={Enum.at(@school_years_data, 0).school_year == @selected_school_year}
              class={[
                "px-2 sm:px-3 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-l-lg transition-colors border-r border-gray-300 dark:border-gray-600",
                if(Enum.at(@school_years_data, 0).school_year == @selected_school_year,
                  do: "opacity-50 cursor-not-allowed",
                  else: ""
                )
              ]}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </button>
            <!-- Year Buttons -->
            <%= for {year_data, index} <- Enum.with_index(@school_years_data) do %>
              <% [start_year, end_year] = String.split(year_data.school_year, "/") %>
              <button
                type="button"
                phx-click="select_school_year"
                phx-value-school_year={year_data.school_year}
                class={[
                  "px-3 sm:px-6 py-2 font-medium transition-colors whitespace-nowrap",
                  if(index > 0, do: "border-l border-gray-300 dark:border-gray-600", else: ""),
                  if(year_data.school_year == @selected_school_year,
                    do: "bg-blue-600 dark:bg-blue-500 text-white",
                    else:
                      "text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700"
                  )
                ]}
              >
                <span class="sm:hidden">
                  {String.slice(start_year, -2..-1)}/{String.slice(end_year, -2..-1)}
                </span>
                <span class="hidden sm:inline">{year_data.school_year}</span>
              </button>
            <% end %>
            <!-- Next Year Button -->
            <button
              type="button"
              phx-click="navigate_year"
              phx-value-direction="next"
              disabled={List.last(@school_years_data).school_year == @selected_school_year}
              class={[
                "px-2 sm:px-3 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-700 rounded-r-lg transition-colors border-l border-gray-300 dark:border-gray-600",
                if(List.last(@school_years_data).school_year == @selected_school_year,
                  do: "opacity-50 cursor-not-allowed",
                  else: ""
                )
              ]}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          </div>
        </div>
        <!-- Status Display -->
        <div class="text-center">
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <%= if @ferientage_limit do %>
              <%= if @ferientage_limit.max_bewegliche_ferientage == 0 do %>
                <span class="text-red-600 dark:text-red-400 font-medium">
                  Keine beweglichen Ferientage im Schuljahr {@selected_school_year}
                </span>
              <% else %>
                <span>
                  <strong class="text-gray-900 dark:text-gray-100">
                    {@current_ferientage_count}
                  </strong>
                  <span class="text-gray-500 dark:text-gray-400">von</span>
                  <strong class="text-gray-900 dark:text-gray-100">
                    {@ferientage_limit.max_bewegliche_ferientage}
                  </strong>
                  <span class="text-gray-500 dark:text-gray-400">
                    beweglichen Ferientagen angelegt
                  </span>
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-500 dark:text-gray-400 italic">
                Keine Limite-Information für Schuljahr {@selected_school_year} verfügbar
              </span>
            <% end %>
          </p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
      <!-- Main Content - Bewegliche Ferientage -->
      <div class="lg:col-span-2 space-y-4 sm:space-y-6">
        <!-- Info Section -->
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 sm:p-5 shadow-sm">
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <svg
                class="h-5 w-5 sm:h-6 sm:w-6 text-blue-500 dark:text-blue-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-semibold text-blue-900 dark:text-blue-200 mb-1">
                Was sind bewegliche Ferientage?
              </h3>
              <p class="text-xs sm:text-sm text-blue-800 dark:text-blue-300 leading-relaxed">
                Bewegliche Ferientage sind zusätzliche freie Tage, die Schulen eigenständig festlegen können.
                Diese Tage werden oft für pädagogische Konferenzen, Brückentage oder andere schulische Zwecke genutzt.
              </p>
            </div>
          </div>
        </div>
        <!-- Federal State Limit Info - Only for selected year -->
        <%= if @federal_state && @ferientage_limit do %>
          <div class="bg-gradient-to-r from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 border border-purple-200 dark:border-purple-800 rounded-xl p-4 sm:p-5 shadow-sm">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <svg
                  class="h-5 w-5 sm:h-6 sm:w-6 text-purple-500 dark:text-purple-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
                  />
                </svg>
              </div>
              <div class="ml-3 flex-1">
                <h3 class="text-sm font-semibold text-purple-900 dark:text-purple-200 mb-2">
                  Bewegliche Ferientage in {@federal_state.name} - Schuljahr {@selected_school_year}
                </h3>
                <%= if @ferientage_limit.max_bewegliche_ferientage == 0 do %>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Keine beweglichen Ferientage vorgesehen
                  </p>
                <% else %>
                  <div class="grid grid-cols-3 gap-4">
                    <div>
                      <p class="text-xs text-gray-600 dark:text-gray-400">Maximum</p>
                      <p class="text-lg font-bold text-purple-900 dark:text-purple-200">
                        {@ferientage_limit.max_bewegliche_ferientage}
                      </p>
                    </div>
                    <div>
                      <p class="text-xs text-gray-600">Angelegt</p>
                      <p class="text-lg font-bold text-purple-900 dark:text-purple-200">
                        {@current_ferientage_count}
                      </p>
                    </div>
                    <div>
                      <p class="text-xs text-gray-600">Verfügbar</p>
                      <p class={[
                        "text-lg font-bold",
                        cond do
                          @remaining_ferientage == 0 -> "text-red-700"
                          @remaining_ferientage && @remaining_ferientage > 0 -> "text-green-700"
                          true -> "text-purple-900"
                        end
                      ]}>
                        {@remaining_ferientage || 0}
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <%= if @limit_reached do %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-4 shadow-sm">
            <div class="flex items-start">
              <svg
                class="h-5 w-5 text-red-400 mr-3 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <div>
                <p class="text-red-800 text-sm">
                  <strong>Tageslimit erreicht:</strong>
                  Es können heute keine weiteren Änderungen vorgenommen werden.
                  Versuchen Sie es morgen erneut.
                </p>
              </div>
            </div>
          </div>
        <% end %>
        <!-- Add New Ferientag Form -->
        <%= if not @limit_reached do %>
          <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-4 sm:p-6">
            <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4">
              Neuen beweglichen Ferientag hinzufügen
            </h2>
            <!-- Form Mode Toggle -->
            <div class="mb-4 sm:mb-6">
              <div class="flex rounded-lg border border-gray-200 bg-gray-50 p-1">
                <button
                  type="button"
                  phx-click="toggle_form_mode"
                  class={
                    if @simple_form_mode,
                      do:
                        "flex-1 px-3 py-2 text-xs sm:text-sm font-medium text-gray-900 bg-white rounded-md shadow-sm transition-all",
                      else:
                        "flex-1 px-3 py-2 text-xs sm:text-sm font-medium text-gray-600 hover:text-gray-900 transition-all"
                  }
                  disabled={@simple_form_mode}
                >
                  Einzelner Tag
                </button>
                <button
                  type="button"
                  phx-click="toggle_form_mode"
                  class={
                    if not @simple_form_mode,
                      do:
                        "flex-1 px-3 py-2 text-xs sm:text-sm font-medium text-gray-900 bg-white rounded-md shadow-sm transition-all",
                      else:
                        "flex-1 px-3 py-2 text-xs sm:text-sm font-medium text-gray-600 hover:text-gray-900 transition-all"
                  }
                  disabled={not @simple_form_mode}
                >
                  <span class="inline sm:hidden">Mehrere Tage</span>
                  <span class="hidden sm:inline">Mehrere Tage (Power User)</span>
                </button>
              </div>
            </div>

            <%= if @simple_form_mode do %>
              <!-- Simple Form Mode -->
              <form phx-submit="add_single_ferientag" class="space-y-4">
                <div>
                  <label for="ferientag_date" class="block text-sm font-medium text-gray-700 mb-1">
                    Datum *
                  </label>
                  <input
                    type="date"
                    id="ferientag_date"
                    name="ferientag[date]"
                    required
                    min={Date.utc_today() |> Date.to_iso8601()}
                    class="mt-1 block w-full rounded-lg border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm sm:text-sm px-3 py-2.5 transition-colors"
                    disabled={@limit_reached}
                  />
                </div>

                <div>
                  <label
                    for="ferientag_memo_simple"
                    class="block text-sm font-medium text-gray-700 mb-1"
                  >
                    Bemerkung/Grund
                  </label>
                  <input
                    type="text"
                    id="ferientag_memo_simple"
                    name="ferientag[memo]"
                    placeholder="z.B. Pädagogischer Tag, Lehrerfortbildung, Brückentag"
                    maxlength="255"
                    class="mt-1 block w-full rounded-lg border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm sm:text-sm px-3 py-2.5 placeholder-gray-400 transition-colors"
                    disabled={@limit_reached}
                  />
                  <p class="mt-1 text-xs text-gray-500">
                    Eine kurze Beschreibung hilft Eltern und Schülern, den Grund für den freien Tag zu verstehen.
                  </p>
                  <%= if @ferientage_limit && @ferientage_limit.max_bewegliche_ferientage > 0 && @remaining_ferientage && @remaining_ferientage <= 0 do %>
                    <p class="mt-2 text-xs text-red-600 font-medium">
                      <svg
                        class="inline w-4 h-4 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        />
                      </svg>
                      Limit für dieses Schuljahr erreicht!
                    </p>
                  <% end %>
                </div>

                <div class="flex justify-between items-center pt-2">
                  <button
                    type="submit"
                    class="inline-flex items-center px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:bg-gray-400 disabled:cursor-not-allowed shadow-sm transition-all hover:shadow-md"
                    disabled={@limit_reached}
                  >
                    <svg
                      class="w-4 h-4 mr-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                      />
                    </svg>
                    Ferientag hinzufügen
                  </button>
                </div>
              </form>
            <% else %>
              <!-- Advanced Form Mode -->
              <form phx-submit="add_beweglicher_ferientag" class="space-y-4">
                <div>
                  <label
                    for="ferientag_dates"
                    class="block text-sm font-medium text-gray-700 mb-1"
                  >
                    Datum/Daten *
                  </label>
                  <input
                    type="text"
                    id="ferientag_dates"
                    name="ferientag[dates]"
                    required
                    placeholder="z.B. 16.02.2026 oder 16.-20.02.2026 oder 16.02.2026, 18.03.2026"
                    class="mt-1 block w-full rounded-lg border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm sm:text-sm px-3 py-2.5 placeholder-gray-400 transition-colors"
                    disabled={@limit_reached}
                  />
                  <div class="mt-2 text-xs text-gray-600 space-y-1">
                    <p><strong>Eingabeformate:</strong></p>
                    <p>• Einzeltag: <code class="bg-gray-100 px-1 rounded">16.02.2026</code></p>
                    <p>
                      • Zeitraum: <code class="bg-gray-100 px-1 rounded">16.-20.02.2026</code>
                    </p>
                    <p>
                      • Mehrere Tage:
                      <code class="bg-gray-100 px-1 rounded">16.02.2026, 18.03.2026</code>
                    </p>
                    <p>
                      • Kombiniert:
                      <code class="bg-gray-100 px-1 rounded">16.-17.02.2026, 20.03.2026</code>
                    </p>
                  </div>
                </div>

                <div>
                  <label for="ferientag_memo" class="block text-sm font-medium text-gray-700 mb-1">
                    Bemerkung/Grund
                  </label>
                  <input
                    type="text"
                    id="ferientag_memo"
                    name="ferientag[memo]"
                    placeholder="z.B. Pädagogischer Tag, Lehrerfortbildung, Brückentag"
                    maxlength="255"
                    class="mt-1 block w-full rounded-lg border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm sm:text-sm px-3 py-2.5 placeholder-gray-400 transition-colors"
                    disabled={@limit_reached}
                  />
                  <p class="mt-1 text-xs text-gray-500">
                    Eine kurze Beschreibung hilft Eltern und Schülern, den Grund für den freien Tag zu verstehen.
                  </p>
                  <%= if @ferientage_limit && @ferientage_limit.max_bewegliche_ferientage > 0 && @remaining_ferientage && @remaining_ferientage <= 0 do %>
                    <p class="mt-2 text-xs text-red-600 font-medium">
                      <svg
                        class="inline w-4 h-4 mr-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                        />
                      </svg>
                      Limit für dieses Schuljahr erreicht!
                    </p>
                  <% end %>
                </div>

                <div class="pt-2">
                  <button
                    type="submit"
                    class="inline-flex items-center px-4 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:bg-gray-400 disabled:cursor-not-allowed shadow-sm transition-all hover:shadow-md"
                    disabled={@limit_reached}
                  >
                    <svg
                      class="w-4 h-4 mr-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                      />
                    </svg>
                    Ferientag(e) hinzufügen
                  </button>
                </div>
              </form>
            <% end %>
          </div>
        <% end %>
        <!-- Quick Copy from Other Schools -->
        <%= if @bewegliche_ferientage == [] && @other_schools_ferientage != [] do %>
          <div class="bg-gradient-to-r from-blue-50 to-cyan-50 border border-blue-200 rounded-xl p-4 sm:p-6 shadow-sm">
            <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-3 flex items-start sm:items-center">
              <svg
                class="w-5 h-5 mr-2 text-blue-600 flex-shrink-0 mt-0.5 sm:mt-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span class="leading-tight">
                Bewegliche Ferientage von anderen Schulen übernehmen
              </span>
            </h3>
            <p class="text-xs sm:text-sm mb-4 text-gray-700">
              Oft haben Schulen im selben Postleitzahlenbereich die gleichen beweglichen Ferientage.
            </p>

            <div class="space-y-2 mb-4">
              <%= for period <- @other_schools_ferientage do %>
                <label class="flex items-start p-3 bg-white rounded-lg border border-blue-100 hover:border-blue-300 cursor-pointer transition-colors">
                  <input
                    type="checkbox"
                    phx-click="toggle_quick_copy_selection"
                    phx-value-date={period.starts_on |> Date.to_iso8601()}
                    phx-value-memo={period.memo || ""}
                    checked={
                      MapSet.member?(
                        @quick_copy_ferientage,
                        {period.starts_on |> Date.to_iso8601(), period.memo || ""}
                      )
                    }
                    class="mt-1 mr-3 h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                  />
                  <div class="flex-1">
                    <div class="flex items-center">
                      <span class="font-medium text-gray-900">
                        {DateFormatter.format_date_full(period.starts_on)}
                      </span>
                      <%= if Date.compare(period.starts_on, Date.utc_today()) == :lt do %>
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                          Vergangen
                        </span>
                      <% end %>
                    </div>
                    <%= if period.memo do %>
                      <p class="text-sm text-gray-600 mt-0.5">
                        {period.memo}
                      </p>
                    <% end %>
                    <p class="text-xs text-gray-500 mt-1">
                      von: {period.school_name}
                    </p>
                  </div>
                </label>
              <% end %>
            </div>

            <%= if MapSet.size(@quick_copy_ferientage) > 0 do %>
              <div class="flex items-center justify-between pt-4 border-t border-blue-200">
                <span class="text-sm text-blue-800">
                  {MapSet.size(@quick_copy_ferientage)} Ferientag{if MapSet.size(
                                                                       @quick_copy_ferientage
                                                                     ) != 1,
                                                                     do: "e"} ausgewählt
                </span>
                <button
                  type="button"
                  phx-click="quick_copy_ferientage"
                  class="inline-flex items-center px-3 sm:px-4 py-2 sm:py-2.5 bg-blue-600 text-white text-xs sm:text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 shadow-sm transition-all hover:shadow-md"
                >
                  <svg
                    class="w-4 h-4 mr-1.5 sm:mr-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                    />
                  </svg>
                  Ausgewählte Ferientage übernehmen
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
        <!-- List of Bewegliche Ferientage -->
        <%= if @ferientage_limit && @ferientage_limit.max_bewegliche_ferientage > 0 do %>
          <div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
            <div class="p-4 sm:p-6 border-b border-gray-200 bg-gray-50">
              <h2 class="text-lg sm:text-xl font-semibold text-gray-900">
                Bewegliche Ferientage - Schuljahr {@selected_school_year}
              </h2>
            </div>

            <div class="p-4 sm:p-6">
              <%= if @filtered_ferientage == [] do %>
                <div class="text-center py-6 sm:py-8">
                  <svg
                    class="mx-auto h-10 w-10 sm:h-12 sm:w-12 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                  <p class="mt-2 text-sm sm:text-base text-gray-500">
                    Für diese Schule sind noch keine beweglichen Ferientage eingetragen.
                  </p>
                  <%= if not @limit_reached do %>
                    <p class="mt-1 text-xs sm:text-sm text-gray-400">
                      Fügen Sie oben die ersten Ferientage hinzu.
                    </p>
                  <% end %>
                </div>
              <% else %>
                <div class="space-y-2 sm:space-y-3">
                  <%= for ferientag <- @filtered_ferientage do %>
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between p-3 sm:p-4 bg-gray-50 border border-gray-200 rounded-lg hover:shadow-sm transition-shadow">
                      <div class="flex-1">
                        <div class="flex items-start sm:items-center">
                          <svg
                            class="w-4 h-4 sm:w-5 sm:h-5 text-blue-500 mr-2 flex-shrink-0 mt-0.5 sm:mt-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                            >
                            </path>
                          </svg>
                          <div class="flex-1">
                            <span class="font-semibold text-sm sm:text-base text-gray-900">
                              {DateFormatter.format_date_full(ferientag.starts_on)}
                            </span>
                            <%= if Date.compare(ferientag.starts_on, Date.utc_today()) == :lt do %>
                              <span class="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                                Vergangen
                              </span>
                            <% end %>
                            <%= if ferientag.memo do %>
                              <p class="text-xs sm:text-sm text-gray-600 mt-0.5">
                                {ferientag.memo}
                              </p>
                            <% end %>
                          </div>
                        </div>
                      </div>

                      <%= if not @limit_reached do %>
                        <button
                          phx-click="delete_beweglicher_ferientag"
                          phx-value-id={ferientag.id}
                          data-confirm="Möchten Sie diesen beweglichen Ferientag wirklich löschen?"
                          class="mt-2 sm:mt-0 sm:ml-4 inline-flex items-center px-2.5 sm:px-3 py-1.5 border border-gray-300 text-xs sm:text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 hover:border-red-300 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors w-full sm:w-auto justify-center"
                        >
                          <svg
                            class="w-4 h-4 mr-1.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                            >
                            </path>
                          </svg>
                          Löschen
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        <!-- Copy Ferientage Section -->
        <%= if length(@filtered_ferientage) > 0 and not @limit_reached do %>
          <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-4 sm:p-6">
            <div class="mb-4">
              <h3 class="text-base sm:text-lg font-semibold text-gray-900 flex items-start sm:items-center">
                <svg
                  class="w-5 h-5 mr-2 text-blue-600 flex-shrink-0 mt-0.5 sm:mt-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2m-6 0h8a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9a2 2 0 00-2 2v2"
                  />
                </svg>
                <span class="leading-tight">
                  Bewegliche Ferientage auf andere Schulen übertragen
                </span>
              </h3>
              <p class="mt-1 text-xs sm:text-sm text-gray-600">
                Kopieren Sie ausgewählte bewegliche Ferientage dieser Schule auf andere Schulen in der Umgebung.
              </p>
            </div>
            <!-- Ferientage Selection -->
            <div class="mb-4 sm:mb-6">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 space-y-2 sm:space-y-0">
                <h4 class="text-xs sm:text-sm font-medium text-gray-900">
                  1. Wählen Sie die zu kopierenden Ferientage
                </h4>
                <div class="flex space-x-2">
                  <button
                    type="button"
                    phx-click="select_all_ferientage"
                    class="text-xs text-blue-600 hover:text-blue-800 transition-colors"
                  >
                    Alle auswählen
                  </button>
                  <button
                    type="button"
                    phx-click="deselect_all_ferientage"
                    class="text-xs text-blue-600 hover:text-blue-800 transition-colors"
                  >
                    Keine auswählen
                  </button>
                </div>
              </div>

              <div class="space-y-2 p-3 bg-gray-50 rounded-lg border border-gray-200">
                <%= for ferientag <- @filtered_ferientage do %>
                  <label class="flex items-start p-2 hover:bg-white rounded cursor-pointer">
                    <input
                      type="checkbox"
                      phx-click="toggle_ferientag_selection"
                      phx-value-ferientag-id={ferientag.id}
                      checked={MapSet.member?(@selected_ferientage, ferientag.id)}
                      class="mr-3 mt-1"
                    />
                    <div class="flex-1">
                      <div class="text-sm font-medium text-gray-900">
                        {DateFormatter.format_date_full(ferientag.starts_on)}
                      </div>
                      <%= if ferientag.memo do %>
                        <div class="text-xs text-gray-500 mt-0.5">
                          {ferientag.memo}
                        </div>
                      <% end %>
                    </div>
                  </label>
                <% end %>
              </div>

              <%= if MapSet.size(@selected_ferientage) > 0 do %>
                <p class="mt-2 text-xs text-gray-600">
                  {MapSet.size(@selected_ferientage)} Ferientag{if MapSet.size(
                                                                     @selected_ferientage
                                                                   ) != 1,
                                                                   do: "e"} ausgewählt
                </p>
              <% end %>
            </div>
            <!-- Search Form -->
            <h4 class="text-xs sm:text-sm font-medium text-gray-900 mb-3">
              2. Zielschulen suchen
            </h4>
            <form phx-change="update_search_params" class="space-y-4 mb-4 sm:mb-6">
              <div>
                <label class="text-xs sm:text-sm font-medium text-gray-700">Suchkriterium</label>
                <div class="mt-2 space-y-2">
                  <label class="flex items-center">
                    <input
                      type="radio"
                      name="search[search_type]"
                      value="zip_code"
                      checked={@search_params["search_type"] == "zip_code"}
                      class="mr-2"
                    />
                    <span class="text-xs sm:text-sm">
                      Gleiche Postleitzahl
                      <%= if @school.address && @school.address.zip_code do %>
                        <span class="text-gray-500">({@school.address.zip_code})</span>
                      <% end %>
                    </span>
                  </label>
                  <label class="flex items-center">
                    <input
                      type="radio"
                      name="search[search_type]"
                      value="same_city"
                      checked={@search_params["search_type"] == "same_city"}
                      class="mr-2"
                    />
                    <span class="text-xs sm:text-sm">Gleiche Stadt</span>
                  </label>
                  <label class="flex items-center">
                    <input
                      type="radio"
                      name="search[search_type]"
                      value="radius"
                      checked={@search_params["search_type"] == "radius"}
                      class="mr-2"
                    />
                    <span class="text-xs sm:text-sm">
                      Im Umkreis von
                      <input
                        type="number"
                        name="search[radius]"
                        value={@search_params["radius"]}
                        min="1"
                        max="50"
                        step="1"
                        class="mx-1 w-14 sm:w-16 px-1.5 sm:px-2 py-1 text-xs sm:text-sm border border-gray-300 rounded"
                      /> km
                    </span>
                  </label>
                  <label class="flex items-start">
                    <input
                      type="radio"
                      name="search[search_type]"
                      value="name_radius"
                      checked={@search_params["search_type"] == "name_radius"}
                      class="mr-2 mt-1"
                    />
                    <div class="text-xs sm:text-sm">
                      Nach Name im <span class="font-medium">{@search_params["radius"]}km</span>
                      Umkreis:
                      <input
                        type="text"
                        name="search[name_pattern]"
                        value={@search_params["name_pattern"]}
                        placeholder="z.B. Gymnasium"
                        class="mt-1 block w-full px-2 sm:px-3 py-1.5 text-xs sm:text-sm border border-gray-300 rounded-md"
                      />
                    </div>
                  </label>
                </div>
              </div>
            </form>
            <!-- Search Results -->
            <%= if length(@search_results) > 0 do %>
              <div class="border-t border-gray-200 pt-4">
                <h4 class="text-xs sm:text-sm font-medium text-gray-900 mb-3">
                  3. Zielschulen auswählen
                </h4>
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-3 space-y-2 sm:space-y-0">
                  <span class="text-xs sm:text-sm text-gray-600">
                    <span class="font-semibold">{length(@search_results)}</span>
                    Schule{if length(@search_results) != 1,
                      do: "n"} gefunden
                  </span>
                  <div class="flex space-x-2">
                    <button
                      type="button"
                      phx-click="select_all_schools"
                      class="text-xs text-blue-600 hover:text-blue-800 transition-colors"
                    >
                      Alle auswählen
                    </button>
                    <button
                      type="button"
                      phx-click="deselect_all_schools"
                      class="text-xs text-blue-600 hover:text-blue-800 transition-colors"
                    >
                      Keine auswählen
                    </button>
                  </div>
                </div>

                <div class="space-y-1.5 sm:space-y-2 max-h-48 sm:max-h-64 overflow-y-auto border border-gray-200 rounded-lg p-2">
                  <%= for school <- @search_results do %>
                    <label class={[
                      "flex items-start p-2 rounded",
                      if(Map.get(school, :has_all_selected_dates, false),
                        do: "bg-gray-100 cursor-not-allowed",
                        else: "hover:bg-gray-50 cursor-pointer"
                      )
                    ]}>
                      <input
                        type="checkbox"
                        phx-click="toggle_school_selection"
                        phx-value-school-id={school.id}
                        checked={MapSet.member?(@selected_schools, school.id)}
                        disabled={Map.get(school, :has_all_selected_dates, false)}
                        class={[
                          "mr-3 mt-1",
                          if(Map.get(school, :has_all_selected_dates, false), do: "opacity-50")
                        ]}
                      />
                      <div class="flex-1">
                        <div class={[
                          "text-xs sm:text-sm font-medium",
                          if(Map.get(school, :has_all_selected_dates, false),
                            do: "text-gray-500",
                            else: "text-gray-900"
                          )
                        ]}>
                          {school.name}
                        </div>
                        <%= if school.address do %>
                          <div class="text-xs text-gray-500">
                            {school.address.zip_code} {school.address.city}
                            <%= if Map.get(school, :distance_km) do %>
                              <span class="text-gray-400">•</span> {Float.round(
                                school.distance_km,
                                1
                              )} km
                            <% end %>
                          </div>
                        <% end %>
                        <%= if Map.get(school, :existing_ferientage_dates, []) != [] do %>
                          <div class="mt-1">
                            <%= if Map.get(school, :has_all_selected_dates, false) do %>
                              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                  <path
                                    fill-rule="evenodd"
                                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                    clip-rule="evenodd"
                                  />
                                </svg>
                                Hat bereits alle ausgewählten Ferientage
                              </span>
                            <% else %>
                              <span class="text-xs text-orange-600">
                                Hat bereits Ferientage am: {Enum.map_join(
                                  Map.get(school, :existing_ferientage_dates, []),
                                  ", ",
                                  &DateFormatter.format_date_short/1
                                )}
                              </span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </label>
                  <% end %>
                </div>

                <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-3 sm:space-y-0 pt-4 border-t border-gray-200">
                  <span class="text-xs sm:text-sm text-gray-600 text-center sm:text-left">
                    <span class="font-semibold">{MapSet.size(@selected_schools)}</span>
                    Schule{if MapSet.size(@selected_schools) != 1, do: "n"} ausgewählt
                  </span>
                  <button
                    type="button"
                    phx-click="show_copy_confirmation"
                    disabled={@copy_in_progress || MapSet.size(@selected_schools) == 0}
                    class={[
                      "inline-flex items-center justify-center px-4 py-2.5 text-sm font-medium rounded-lg transition-all w-full sm:w-auto",
                      if(MapSet.size(@selected_schools) == 0,
                        do: "bg-gray-300 text-gray-500 cursor-not-allowed",
                        else:
                          "bg-green-600 text-white hover:bg-green-700 disabled:bg-gray-400 disabled:cursor-not-allowed shadow-sm hover:shadow-md"
                      )
                    ]}
                  >
                    <%= if @copy_in_progress do %>
                      <svg
                        class="animate-spin -ml-1 mr-2 h-4 w-4 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <circle
                          class="opacity-25"
                          cx="12"
                          cy="12"
                          r="10"
                          stroke="currentColor"
                          stroke-width="4"
                        >
                        </circle>
                        <path
                          class="opacity-75"
                          fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                        >
                        </path>
                      </svg>
                      Kopiere...
                    <% else %>
                      <svg
                        class="w-4 h-4 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                        />
                      </svg>
                      Ferientage kopieren
                    <% end %>
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <!-- Sidebar -->
      <div class="lg:col-span-1">
        <div class="space-y-4 sm:space-y-6">
          <!-- Daily Limit Info -->
          {Phoenix.View.render(MehrSchulferienWeb.WikiView, "_daily_limit_info.html",
            daily_changes: @daily_changes
          )}
          <!-- Statistics -->
          <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-4">
            <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
              <svg
                class="w-4 h-4 mr-2 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                />
              </svg>
              Statistik
            </h3>
            <dl class="space-y-3 text-sm">
              <div class="flex justify-between items-center">
                <dt class="text-gray-600">Schuljahr {@selected_school_year}:</dt>
                <dd class="font-semibold text-gray-900 bg-gray-100 px-2 py-1 rounded">
                  {length(@filtered_ferientage)}
                </dd>
              </div>
              <div class="flex justify-between items-center">
                <dt class="text-gray-600">Davon zukünftig:</dt>
                <dd class="font-semibold text-gray-900 bg-green-100 px-2 py-1 rounded text-green-800">
                  {Enum.count(@filtered_ferientage, fn ft ->
                    Date.compare(ft.starts_on, Date.utc_today()) != :lt
                  end)}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
    <!-- Back to School Link -->
    <div class="mt-6 sm:mt-8 text-center border-t border-gray-200 pt-6 sm:pt-8">
      <a
        href={~p"/ferien/d/schule/#{@school.slug}"}
        class="inline-flex items-center px-4 py-2.5 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all hover:shadow-md"
      >
        <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          />
        </svg>
        Zurück zur Schulseite
      </a>
    </div>
    <!-- Copy Confirmation Modal -->
    <%= if @show_copy_confirmation_modal do %>
      <div
        class="fixed inset-0 z-50 overflow-y-auto"
        aria-labelledby="modal-title"
        role="dialog"
        aria-modal="true"
      >
        <div class="flex items-end justify-center min-h-screen pt-4 px-2 pb-20 text-center sm:block sm:p-0">
          <!-- Background overlay -->
          <div
            class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"
            phx-click="close_copy_confirmation"
            aria-hidden="true"
          >
          </div>
          <!-- Modal panel -->
          <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">
            &#8203;
          </span>
          <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all w-full max-w-lg mx-auto sm:my-8 sm:align-middle">
            <div class="bg-white px-3 pt-4 pb-3 sm:p-6 sm:pb-4">
              <div class="sm:flex sm:items-start">
                <div class={[
                  "mx-auto flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full sm:mx-0 sm:h-10 sm:w-10",
                  if(assigns[:would_exceed_limit], do: "bg-red-100", else: "bg-blue-100")
                ]}>
                  <%= if assigns[:would_exceed_limit] do %>
                    <svg
                      class="h-5 w-5 text-red-600 sm:h-6 sm:w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      />
                    </svg>
                  <% else %>
                    <svg
                      class="h-5 w-5 text-blue-600 sm:h-6 sm:w-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2m-6 0h8a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9a2 2 0 00-2 2v2"
                      />
                    </svg>
                  <% end %>
                </div>
                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                  <h3
                    class="text-base sm:text-lg leading-6 font-medium text-gray-900"
                    id="modal-title"
                  >
                    Bewegliche Ferientage kopieren
                  </h3>
                  <div class="mt-2">
                    <%= if assigns[:would_exceed_limit] do %>
                      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg">
                        <p class="text-sm text-red-800 font-medium">
                          Diese Aktion würde das tägliche Limit überschreiten.
                        </p>
                        <p class="text-xs text-red-700 mt-1">
                          Erforderliche Änderungen: {assigns[:required_changes] || 0}<br />
                          Verbleibendes Kontingent: {assigns[:remaining_quota] || 0}<br />
                          Tägliches Limit: {Config.daily_change_limit()}
                        </p>
                      </div>
                    <% else %>
                      <p class="text-xs sm:text-sm text-gray-500">
                        Sie sind dabei, bewegliche Ferientage zu kopieren. Bitte überprüfen Sie die Details:
                      </p>
                    <% end %>

                    <div class="mt-3 space-y-2 sm:mt-4 sm:space-y-3">
                      <!-- Selected Ferientage -->
                      <div class="bg-gray-50 p-2 sm:p-3 rounded-lg">
                        <h4 class="text-xs sm:text-sm font-medium text-gray-900 mb-1 sm:mb-2">
                          Ausgewählte Ferientage ({MapSet.size(@selected_ferientage)}):
                        </h4>
                        <ul class="text-xs sm:text-sm text-gray-600 space-y-0.5 sm:space-y-1">
                          <%= for ferientag <- @bewegliche_ferientage |> Enum.filter(& MapSet.member?(@selected_ferientage, &1.id)) |> Enum.take(3) do %>
                            <li class="flex items-start">
                              <svg
                                class="w-3 h-3 sm:w-4 sm:h-4 mr-1.5 sm:mr-2 mt-0.5 text-blue-500 flex-shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                />
                              </svg>
                              <span class="break-words">
                                {DateFormatter.format_date_full(ferientag.starts_on)}
                                <%= if ferientag.memo do %>
                                  <span class="text-gray-500 block sm:inline sm:ml-1">
                                    - {ferientag.memo}
                                  </span>
                                <% end %>
                              </span>
                            </li>
                          <% end %>
                          <%= if MapSet.size(@selected_ferientage) > 3 do %>
                            <li class="text-gray-400 italic text-xs">
                              und {MapSet.size(@selected_ferientage) - 3} weitere...
                            </li>
                          <% end %>
                        </ul>
                      </div>
                      <!-- Target Schools -->
                      <div class="bg-gray-50 p-2 sm:p-3 rounded-lg">
                        <h4 class="text-xs sm:text-sm font-medium text-gray-900 mb-1 sm:mb-2">
                          Zielschulen ({MapSet.size(@selected_schools)}):
                        </h4>
                        <ul class="text-xs sm:text-sm text-gray-600 space-y-0.5 sm:space-y-1">
                          <%= for school <- @search_results |> Enum.filter(& MapSet.member?(@selected_schools, &1.id)) |> Enum.take(3) do %>
                            <li class="flex items-start">
                              <svg
                                class="w-3 h-3 sm:w-4 sm:h-4 mr-1.5 sm:mr-2 mt-0.5 text-green-500 flex-shrink-0"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                />
                              </svg>
                              <div class="min-w-0">
                                <div class="truncate">{school.name}</div>
                                <%= if school.address do %>
                                  <span class="text-xs text-gray-500 block">
                                    {school.address.zip_code} {school.address.city}
                                  </span>
                                <% end %>
                              </div>
                            </li>
                          <% end %>
                          <%= if MapSet.size(@selected_schools) > 3 do %>
                            <li class="text-gray-400 italic text-xs">
                              und {MapSet.size(@selected_schools) - 3} weitere...
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>

                    <%= unless assigns[:would_exceed_limit] do %>
                      <div class="mt-3 sm:mt-4 p-2 sm:p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                        <div class="flex">
                          <svg
                            class="h-4 w-4 sm:h-5 sm:w-5 text-yellow-400 flex-shrink-0"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            />
                          </svg>
                          <p class="ml-2 sm:ml-3 text-xs sm:text-sm text-yellow-700">
                            <strong>Hinweis:</strong>
                            Bereits vorhandene bewegliche Ferientage werden übersprungen.
                          </p>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 px-3 py-2 sm:px-6 sm:py-3 flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
              <button
                type="button"
                phx-click="close_copy_confirmation"
                class="w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-3 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:w-auto"
              >
                {if assigns[:would_exceed_limit], do: "Schließen", else: "Abbrechen"}
              </button>
              <%= unless assigns[:would_exceed_limit] do %>
                <button
                  type="button"
                  phx-click="copy_ferientage"
                  class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-3 py-2 bg-green-600 text-sm font-medium text-white hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 sm:w-auto"
                >
                  Ferientage kopieren
                </button>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
