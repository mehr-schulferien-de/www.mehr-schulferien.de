<div class="max-w-4xl mx-auto py-6" id="ferientage-container" phx-hook="ScrollToTop">
  <!-- Flash messages -->
  <%= if Phoenix.Flash.get(@flash, :info) do %>
    <div class="mb-4 p-4 bg-green-50 border border-green-200 rounded-lg">
      <p class="text-green-800">
        <%= Phoenix.Flash.get(@flash, :info) %>
      </p>
    </div>
  <% end %>

  <%= if Phoenix.Flash.get(@flash, :error) do %>
    <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
      <p class="text-red-800">
        <%= Phoenix.Flash.get(@flash, :error) %>
      </p>
    </div>
  <% end %>
  <!-- Header with Navigation -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">
      Schul-Wiki: <%= @school.name %>
    </h1>
    <p class="text-gray-600 mb-4">
      Verwalten Sie die beweglichen Ferientage dieser Schule.
    </p>
    <!-- Navigation Tabs -->
    <div class="border-b border-gray-200">
      <nav class="-mb-px flex space-x-8">
        <%= link("Stammdaten",
          to: ~p"/wiki/schools/#{@school.slug}/edit",
          class:
            "border-b-2 border-transparent py-2 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300"
        ) %>
        <span class="border-b-2 border-blue-500 py-2 px-1 text-sm font-medium text-blue-600">
          Bewegliche Ferientage
        </span>
      </nav>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content - Bewegliche Ferientage -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Info Section -->
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="text-sm font-medium text-blue-900 mb-1">Was sind bewegliche Ferientage?</h3>
        <p class="text-sm text-blue-800">
          Bewegliche Ferientage sind zusätzliche freie Tage, die Schulen eigenständig festlegen können.
          Diese Tage werden oft für pädagogische Konferenzen, Brückentage oder andere schulische Zwecke genutzt.
        </p>
      </div>

      <%= if @limit_reached do %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <p class="text-red-800 text-sm">
            <strong>Tageslimit erreicht:</strong>
            Es können heute keine weiteren Änderungen vorgenommen werden.
            Versuchen Sie es morgen erneut.
          </p>
        </div>
      <% end %>
      <!-- Add New Ferientag Form -->
      <%= if not @limit_reached do %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">
            Neuen beweglichen Ferientag hinzufügen
          </h2>
          <!-- Form Mode Toggle -->
          <div class="mb-6">
            <div class="flex rounded-lg border border-gray-200 bg-gray-50 p-1">
              <button
                type="button"
                phx-click="toggle_form_mode"
                class={
                  if @simple_form_mode,
                    do:
                      "flex-1 px-4 py-2 text-sm font-medium text-gray-900 bg-white rounded-md shadow-sm",
                    else: "flex-1 px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900"
                }
                disabled={@simple_form_mode}
              >
                Einzelner Tag
              </button>
              <button
                type="button"
                phx-click="toggle_form_mode"
                class={
                  if not @simple_form_mode,
                    do:
                      "flex-1 px-4 py-2 text-sm font-medium text-gray-900 bg-white rounded-md shadow-sm",
                    else: "flex-1 px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-900"
                }
                disabled={not @simple_form_mode}
              >
                Mehrere Tage (Power User)
              </button>
            </div>
          </div>

          <%= if @simple_form_mode do %>
            <!-- Simple Form Mode -->
            <form phx-submit="add_single_ferientag" class="space-y-4">
              <div>
                <label for="ferientag_date" class="block text-sm font-medium text-gray-700 mb-1">
                  Datum *
                </label>
                <input
                  type="date"
                  id="ferientag_date"
                  name="ferientag[date]"
                  required
                  min={Date.utc_today() |> Date.to_iso8601()}
                  class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2"
                  disabled={@limit_reached}
                />
              </div>

              <div>
                <label
                  for="ferientag_memo_simple"
                  class="block text-sm font-medium text-gray-700 mb-1"
                >
                  Bemerkung/Grund
                </label>
                <input
                  type="text"
                  id="ferientag_memo_simple"
                  name="ferientag[memo]"
                  placeholder="z.B. Pädagogischer Tag, Lehrerfortbildung, Brückentag"
                  maxlength="255"
                  class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
                  disabled={@limit_reached}
                />
                <p class="mt-1 text-xs text-gray-500">
                  Eine kurze Beschreibung hilft Eltern und Schülern, den Grund für den freien Tag zu verstehen.
                </p>
              </div>

              <div class="flex justify-between items-center pt-2">
                <button
                  type="submit"
                  class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:bg-gray-400 disabled:cursor-not-allowed"
                  disabled={@limit_reached}
                >
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Ferientag hinzufügen
                </button>
              </div>
            </form>
          <% else %>
            <!-- Advanced Form Mode -->
            <form phx-submit="add_beweglicher_ferientag" class="space-y-4">
              <div>
                <label for="ferientag_dates" class="block text-sm font-medium text-gray-700 mb-1">
                  Datum/Daten *
                </label>
                <input
                  type="text"
                  id="ferientag_dates"
                  name="ferientag[dates]"
                  required
                  placeholder="z.B. 16.02.2026 oder 16.-20.02.2026 oder 16.02.2026, 18.03.2026"
                  class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
                  disabled={@limit_reached}
                />
                <div class="mt-2 text-xs text-gray-600 space-y-1">
                  <p><strong>Eingabeformate:</strong></p>
                  <p>• Einzeltag: <code class="bg-gray-100 px-1 rounded">16.02.2026</code></p>
                  <p>
                    • Zeitraum: <code class="bg-gray-100 px-1 rounded">16.-20.02.2026</code>
                  </p>
                  <p>
                    • Mehrere Tage:
                    <code class="bg-gray-100 px-1 rounded">16.02.2026, 18.03.2026</code>
                  </p>
                  <p>
                    • Kombiniert:
                    <code class="bg-gray-100 px-1 rounded">16.-17.02.2026, 20.03.2026</code>
                  </p>
                </div>
              </div>

              <div>
                <label for="ferientag_memo" class="block text-sm font-medium text-gray-700 mb-1">
                  Bemerkung/Grund
                </label>
                <input
                  type="text"
                  id="ferientag_memo"
                  name="ferientag[memo]"
                  placeholder="z.B. Pädagogischer Tag, Lehrerfortbildung, Brückentag"
                  maxlength="255"
                  class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
                  disabled={@limit_reached}
                />
                <p class="mt-1 text-xs text-gray-500">
                  Eine kurze Beschreibung hilft Eltern und Schülern, den Grund für den freien Tag zu verstehen.
                </p>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:bg-gray-400 disabled:cursor-not-allowed"
                  disabled={@limit_reached}
                >
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                    />
                  </svg>
                  Ferientag(e) hinzufügen
                </button>
              </div>
            </form>
          <% end %>
        </div>
      <% end %>
      <!-- List of Bewegliche Ferientage -->
      <div class="bg-white shadow-sm border border-gray-200 rounded-lg">
        <div class="p-6 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900">
            Aktuelle bewegliche Ferientage
          </h2>
        </div>

        <div class="p-6">
          <%= if @bewegliche_ferientage == [] do %>
            <div class="text-center py-8">
              <svg
                class="mx-auto h-12 w-12 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              <p class="mt-2 text-gray-500">
                Für diese Schule sind noch keine beweglichen Ferientage eingetragen.
              </p>
              <%= if not @limit_reached do %>
                <p class="mt-1 text-sm text-gray-400">
                  Fügen Sie oben die ersten Ferientage hinzu.
                </p>
              <% end %>
            </div>
          <% else %>
            <div class="space-y-3">
              <%= for ferientag <- @bewegliche_ferientage do %>
                <div class="flex items-center justify-between p-4 bg-gray-50 border border-gray-200 rounded-lg hover:shadow-sm transition-shadow">
                  <div class="flex-1">
                    <div class="flex items-center">
                      <svg
                        class="w-5 h-5 text-blue-500 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        >
                        </path>
                      </svg>
                      <span class="font-semibold text-gray-900">
                        <%= DateFormatter.format_date_full(ferientag.starts_on) %>
                      </span>
                      <%= if Date.compare(ferientag.starts_on, Date.utc_today()) == :lt do %>
                        <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
                          Vergangen
                        </span>
                      <% end %>
                    </div>
                    <%= if ferientag.memo do %>
                      <p class="mt-1 text-sm text-gray-600 ml-7">
                        <%= ferientag.memo %>
                      </p>
                    <% end %>
                  </div>

                  <%= if not @limit_reached do %>
                    <button
                      phx-click="delete_beweglicher_ferientag"
                      phx-value-id={ferientag.id}
                      data-confirm="Möchten Sie diesen beweglichen Ferientag wirklich löschen?"
                      class="ml-4 inline-flex items-center px-3 py-1.5 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 hover:border-red-300 hover:text-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors"
                    >
                      <svg
                        class="w-4 h-4 mr-1.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        >
                        </path>
                      </svg>
                      Löschen
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <!-- Copy Button at the end of the list -->
            <%= if length(@bewegliche_ferientage) > 0 and not @limit_reached do %>
              <div class="mt-6 pt-6 border-t border-gray-200">
                <button
                  type="button"
                  phx-click="toggle_copy_mode"
                  class={[
                    "w-full inline-flex items-center justify-center px-4 py-3 text-sm font-medium rounded-md transition-colors",
                    if(@copy_mode,
                      do: "bg-blue-600 text-white hover:bg-blue-700",
                      else: "border border-gray-300 text-gray-700 bg-white hover:bg-gray-50"
                    )
                  ]}
                >
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                    />
                  </svg>
                  Bewegliche Ferientage auf andere Schulen übertragen
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 7l5 5m0 0l-5 5m5-5H6"
                    />
                  </svg>
                </button>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <!-- Copy Ferientage Section -->
      <%= if @copy_mode and length(@bewegliche_ferientage) > 0 do %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-6">
          <div class="mb-4">
            <h3 class="text-lg font-semibold text-gray-900 flex items-center">
              <svg
                class="w-5 h-5 mr-2 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2m-6 0h8a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9a2 2 0 00-2 2v2"
                />
              </svg>
              Bewegliche Ferientage auf andere Schulen übertragen
            </h3>
            <p class="mt-1 text-sm text-gray-600">
              Kopieren Sie ausgewählte bewegliche Ferientage dieser Schule auf andere Schulen in der Umgebung.
            </p>
          </div>
          <!-- Ferientage Selection -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-3">
              <h4 class="text-sm font-medium text-gray-900">
                1. Wählen Sie die zu kopierenden Ferientage
              </h4>
              <div class="space-x-2">
                <button
                  type="button"
                  phx-click="select_all_ferientage"
                  class="text-xs text-blue-600 hover:text-blue-800"
                >
                  Alle auswählen
                </button>
                <button
                  type="button"
                  phx-click="deselect_all_ferientage"
                  class="text-xs text-blue-600 hover:text-blue-800"
                >
                  Keine auswählen
                </button>
              </div>
            </div>

            <div class="space-y-2 p-3 bg-gray-50 rounded-lg border border-gray-200">
              <%= for ferientag <- @bewegliche_ferientage do %>
                <label class="flex items-start p-2 hover:bg-white rounded cursor-pointer">
                  <input
                    type="checkbox"
                    phx-click="toggle_ferientag_selection"
                    phx-value-ferientag-id={ferientag.id}
                    checked={MapSet.member?(@selected_ferientage, ferientag.id)}
                    class="mr-3 mt-1"
                  />
                  <div class="flex-1">
                    <div class="text-sm font-medium text-gray-900">
                      <%= DateFormatter.format_date_full(ferientag.starts_on) %>
                    </div>
                    <%= if ferientag.memo do %>
                      <div class="text-xs text-gray-500 mt-0.5">
                        <%= ferientag.memo %>
                      </div>
                    <% end %>
                  </div>
                </label>
              <% end %>
            </div>

            <%= if MapSet.size(@selected_ferientage) > 0 do %>
              <p class="mt-2 text-xs text-gray-600">
                <%= MapSet.size(@selected_ferientage) %> Ferientag<%= if MapSet.size(
                                                                           @selected_ferientage
                                                                         ) != 1,
                                                                         do: "e" %> ausgewählt
              </p>
            <% end %>
          </div>
          <!-- Search Form -->
          <h4 class="text-sm font-medium text-gray-900 mb-3">
            2. Zielschulen suchen
          </h4>
          <form phx-submit="search_schools" class="space-y-4 mb-6">
            <div>
              <label class="text-sm font-medium text-gray-700">Suchkriterium</label>
              <div class="mt-2 space-y-2">
                <label class="flex items-center">
                  <input
                    type="radio"
                    name="search[search_type]"
                    value="zip_code"
                    checked={@search_params["search_type"] == "zip_code"}
                    class="mr-2"
                  />
                  <span class="text-sm">
                    Gleiche Postleitzahl
                    <%= if @school.address && @school.address.zip_code do %>
                      (<%= @school.address.zip_code %>)
                    <% end %>
                  </span>
                </label>
                <label class="flex items-center">
                  <input
                    type="radio"
                    name="search[search_type]"
                    value="same_city"
                    checked={@search_params["search_type"] == "same_city"}
                    class="mr-2"
                  />
                  <span class="text-sm">Gleiche Stadt</span>
                </label>
                <label class="flex items-center">
                  <input
                    type="radio"
                    name="search[search_type]"
                    value="radius"
                    checked={@search_params["search_type"] == "radius"}
                    class="mr-2"
                  />
                  <span class="text-sm">
                    Im Umkreis von
                    <input
                      type="number"
                      name="search[radius]"
                      value={@search_params["radius"]}
                      min="1"
                      max="50"
                      step="1"
                      class="mx-1 w-16 px-2 py-1 text-sm border border-gray-300 rounded"
                    /> km
                  </span>
                </label>
                <label class="flex items-start">
                  <input
                    type="radio"
                    name="search[search_type]"
                    value="name_radius"
                    checked={@search_params["search_type"] == "name_radius"}
                    class="mr-2 mt-1"
                  />
                  <div class="text-sm">
                    Nach Name im 50km Umkreis:
                    <input
                      type="text"
                      name="search[name_pattern]"
                      value={@search_params["name_pattern"]}
                      placeholder="z.B. Gymnasium"
                      class="mt-1 block w-full px-3 py-1 text-sm border border-gray-300 rounded"
                    />
                  </div>
                </label>
              </div>
            </div>

            <button
              type="submit"
              class="inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700"
            >
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                />
              </svg>
              Schulen suchen
            </button>
          </form>
          <!-- Search Results -->
          <%= if length(@search_results) > 0 do %>
            <div class="border-t border-gray-200 pt-4">
              <h4 class="text-sm font-medium text-gray-900 mb-3">
                3. Zielschulen auswählen
              </h4>
              <div class="flex items-center justify-between mb-3">
                <span class="text-sm text-gray-600">
                  <%= length(@search_results) %> Schule<%= if length(@search_results) != 1,
                    do: "n" %> gefunden
                </span>
                <div class="space-x-2">
                  <button
                    type="button"
                    phx-click="select_all_schools"
                    class="text-sm text-blue-600 hover:text-blue-800"
                  >
                    Alle auswählen
                  </button>
                  <button
                    type="button"
                    phx-click="deselect_all_schools"
                    class="text-sm text-blue-600 hover:text-blue-800"
                  >
                    Keine auswählen
                  </button>
                </div>
              </div>

              <div class="space-y-2 max-h-64 overflow-y-auto border border-gray-200 rounded p-2">
                <%= for school <- @search_results do %>
                  <label class={[
                    "flex items-start p-2 rounded",
                    if(Map.get(school, :has_all_selected_dates, false),
                      do: "bg-gray-100 cursor-not-allowed",
                      else: "hover:bg-gray-50 cursor-pointer"
                    )
                  ]}>
                    <input
                      type="checkbox"
                      phx-click="toggle_school_selection"
                      phx-value-school-id={school.id}
                      checked={MapSet.member?(@selected_schools, school.id)}
                      disabled={Map.get(school, :has_all_selected_dates, false)}
                      class={[
                        "mr-3 mt-1",
                        if(Map.get(school, :has_all_selected_dates, false), do: "opacity-50")
                      ]}
                    />
                    <div class="flex-1">
                      <div class={[
                        "text-sm font-medium",
                        if(Map.get(school, :has_all_selected_dates, false),
                          do: "text-gray-500",
                          else: "text-gray-900"
                        )
                      ]}>
                        <%= school.name %>
                      </div>
                      <%= if school.address do %>
                        <div class="text-xs text-gray-500">
                          <%= school.address.zip_code %> <%= school.address.city %>
                          <%= if Map.get(school, :distance_km) do %>
                            • <%= Float.round(school.distance_km, 1) %> km
                          <% end %>
                        </div>
                      <% end %>
                      <%= if Map.get(school, :existing_ferientage_dates, []) != [] do %>
                        <div class="mt-1">
                          <%= if Map.get(school, :has_all_selected_dates, false) do %>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                  fill-rule="evenodd"
                                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                  clip-rule="evenodd"
                                />
                              </svg>
                              Hat bereits alle ausgewählten Ferientage
                            </span>
                          <% else %>
                            <span class="text-xs text-orange-600">
                              Hat bereits Ferientage am: <%= Enum.map_join(
                                Map.get(school, :existing_ferientage_dates, []),
                                ", ",
                                &DateFormatter.format_date_short/1
                              ) %>
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </label>
                <% end %>
              </div>

              <%= if MapSet.size(@selected_schools) > 0 do %>
                <div class="mt-4 flex items-center justify-between">
                  <span class="text-sm text-gray-600">
                    <%= MapSet.size(@selected_schools) %> Schule(n) ausgewählt
                  </span>
                  <button
                    type="button"
                    phx-click="copy_ferientage"
                    disabled={@copy_in_progress}
                    class="inline-flex items-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md hover:bg-green-700 disabled:bg-gray-400 disabled:cursor-not-allowed"
                  >
                    <%= if @copy_in_progress do %>
                      <svg
                        class="animate-spin -ml-1 mr-2 h-4 w-4 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                      >
                        <circle
                          class="opacity-25"
                          cx="12"
                          cy="12"
                          r="10"
                          stroke="currentColor"
                          stroke-width="4"
                        >
                        </circle>
                        <path
                          class="opacity-75"
                          fill="currentColor"
                          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                        >
                        </path>
                      </svg>
                      Kopiere...
                    <% else %>
                      <svg
                        class="w-4 h-4 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                        />
                      </svg>
                      Ferientage kopieren
                    <% end %>
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Daily Limit Info -->
      <%= Phoenix.View.render(MehrSchulferienWeb.WikiView, "_daily_limit_info.html",
        daily_changes: @daily_changes
      ) %>
      <!-- Statistics -->
      <div class="bg-white shadow-sm border border-gray-200 rounded-lg p-4">
        <h3 class="text-sm font-medium text-gray-900 mb-2">Statistik</h3>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between">
            <dt class="text-gray-600">Ferientage gesamt:</dt>
            <dd class="font-medium text-gray-900"><%= length(@bewegliche_ferientage) %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-600">Zukünftige Tage:</dt>
            <dd class="font-medium text-gray-900">
              <%= Enum.count(@bewegliche_ferientage, fn ft ->
                Date.compare(ft.starts_on, Date.utc_today()) != :lt
              end) %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
  <!-- Back to School Link -->
  <div class="mt-8 text-center">
    <a
      href={~p"/ferien/d/schule/#{@school.slug}"}
      class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
    >
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 19l-7-7m0 0l7-7m-7 7h18"
        />
      </svg>
      Zurück zur Schulseite
    </a>
  </div>
</div>
