<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <a href="/" class="hover:text-gray-700">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
      </svg>
    </a>
    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"
      />
    </svg>
    <a href="/briefe" class="hover:text-gray-700">Schule suchen</a>
    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"
      />
    </svg>
    <span class="text-gray-700">Neue Schule anlegen</span>
  </nav>

  <h1 class="text-3xl font-bold text-gray-900 mb-8">Neue Schule anlegen</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">Schuldaten</h2>

        <form phx-submit="save" phx-change="validate" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
              Schulname *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              value={@school_name}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. Max-Mustermann-Gymnasium"
              autofocus
              required
            />
          </div>

          <div>
            <label for="street" class="block text-sm font-medium text-gray-700 mb-1">
              Straße *
            </label>
            <input
              type="text"
              id="street"
              name="address[street]"
              value={@changeset.data.street || @changeset.changes[:street] || ""}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. Musterstraße 123"
              required
            />
            <%= if @changeset.action && @changeset.errors[:street] do %>
              <p class="mt-1 text-sm text-red-600">
                {elem(@changeset.errors[:street], 0)}
              </p>
            <% end %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="zip_code" class="text-sm font-medium text-gray-700">
                  PLZ *
                </label>
                <%= if length(@existing_schools) > 0 do %>
                  <a
                    href="#existing-schools"
                    class="text-xs text-amber-600 hover:text-amber-700 flex items-center gap-1"
                  >
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {length(@existing_schools)} {if length(@existing_schools) == 1,
                      do: "Schule vorhanden",
                      else: "Schulen vorhanden"}
                  </a>
                <% end %>
              </div>
              <input
                type="text"
                id="zip_code"
                name="address[zip_code]"
                value={@changeset.data.zip_code || @changeset.changes[:zip_code] || ""}
                class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
                disabled={@limit_reached}
                placeholder="z.B. 12345"
                required
                pattern="[0-9]{5}"
                title="Bitte geben Sie eine gültige 5-stellige deutsche Postleitzahl ein"
              />
              <%= if @changeset.action && @changeset.errors[:zip_code] do %>
                <p class="mt-1 text-sm text-red-600">
                  {elem(@changeset.errors[:zip_code], 0)}
                </p>
              <% end %>
              <%= if @zip_code_valid == false do %>
                <p class="mt-1 text-sm text-red-600">Diese Postleitzahl wurde nicht gefunden.</p>
              <% end %>
            </div>

            <div>
              <label for="city" class="block text-sm font-medium text-gray-700 mb-1">
                Stadt *
              </label>
              <input
                type="text"
                id="city"
                name="address[city]"
                value={
                  @changeset.changes[:city] ||
                    if(@city_from_zip, do: @city_from_zip.name, else: @changeset.data.city || "")
                }
                class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
                disabled={@limit_reached}
                placeholder="z.B. Berlin"
                required
              />
              <%= if @changeset.action && @changeset.errors[:city] do %>
                <p class="mt-1 text-sm text-red-600">
                  {elem(@changeset.errors[:city], 0)}
                </p>
              <% end %>
            </div>
          </div>

          <div>
            <label for="email_address" class="block text-sm font-medium text-gray-700 mb-1">
              E-Mail
            </label>
            <input
              type="email"
              id="email_address"
              name="address[email_address]"
              value={@changeset.data.email_address || @changeset.changes[:email_address] || ""}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. info@schule.de"
            />
            <%= if @changeset.action && @changeset.errors[:email_address] do %>
              <p class="mt-1 text-sm text-red-600">
                {elem(@changeset.errors[:email_address], 0)}
              </p>
            <% end %>
          </div>

          <div>
            <label for="phone_number" class="block text-sm font-medium text-gray-700 mb-1">
              Telefon
            </label>
            <input
              type="text"
              id="phone_number"
              name="address[phone_number]"
              value={@changeset.data.phone_number || @changeset.changes[:phone_number] || ""}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. +49 30 123456789"
            />
            <%= if @changeset.action && @changeset.errors[:phone_number] do %>
              <p class="mt-1 text-sm text-red-600">
                {elem(@changeset.errors[:phone_number], 0)}
              </p>
            <% end %>
          </div>

          <div>
            <label for="homepage_url" class="block text-sm font-medium text-gray-700 mb-1">
              Homepage
            </label>
            <input
              type="url"
              id="homepage_url"
              name="address[homepage_url]"
              value={@changeset.data.homepage_url || @changeset.changes[:homepage_url] || ""}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. https://www.schule.de (optional)"
            />
            <%= if @changeset.action && @changeset.errors[:homepage_url] do %>
              <p class="mt-1 text-sm text-red-600">
                {elem(@changeset.errors[:homepage_url], 0)}
              </p>
            <% end %>
          </div>

          <div>
            <label for="wikipedia_url" class="block text-sm font-medium text-gray-700 mb-1">
              Wikipedia
            </label>
            <input
              type="url"
              id="wikipedia_url"
              name="address[wikipedia_url]"
              value={@changeset.data.wikipedia_url || @changeset.changes[:wikipedia_url] || ""}
              class="mt-1 block w-full rounded-md border-2 border-gray-300 bg-white shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm px-3 py-2 placeholder-gray-400"
              disabled={@limit_reached}
              placeholder="z.B. https://de.wikipedia.org/wiki/Beispiel-Schule"
            />
            <%= if @changeset.action && @changeset.errors[:wikipedia_url] do %>
              <p class="mt-1 text-sm text-red-600">
                {elem(@changeset.errors[:wikipedia_url], 0)}
              </p>
            <% end %>
          </div>

          <div class="pt-4">
            <button
              type="submit"
              class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed"
              disabled={@limit_reached}
            >
              Schule anlegen
            </button>
          </div>
        </form>
      </div>
    </div>

    <div>
      <%= if length(@existing_schools) > 0 do %>
        <div
          id="existing-schools"
          class="bg-amber-50 border border-amber-200 rounded-lg overflow-hidden"
        >
          <div class="bg-amber-100 px-4 py-3 border-b border-amber-200">
            <h3 class="text-sm font-semibold text-amber-900">
              Existierende Schulen ({length(@existing_schools)})
            </h3>
          </div>
          <div class="p-4">
            <p class="text-xs text-amber-700 mb-3">
              Bitte prüfen Sie, ob Ihre Schule bereits vorhanden ist:
            </p>
            <div class="space-y-2">
              <%= for school <- @existing_schools do %>
                <a
                  href={"/briefe/#{school.slug}"}
                  class="block bg-white rounded border border-amber-200 p-3 hover:border-amber-300 hover:shadow-sm transition-all"
                  target="_blank"
                >
                  <div class="font-medium text-sm text-gray-900">
                    {school.name}
                  </div>
                  <%= if school.address do %>
                    <div class="mt-1 text-xs text-gray-600 flex items-start">
                      <svg
                        class="w-3 h-3 text-gray-400 mr-1 mt-0.5 flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      <div>
                        <%= if school.address.street do %>
                          <div>{school.address.street}</div>
                        <% end %>
                        <div>
                          {school.address.zip_code || ""}
                          {school.address.city || school.parent_location.name}
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <div class="mt-1 text-xs text-gray-500 flex items-start">
                      <%= if school.parent_location do %>
                        <svg
                          class="w-3 h-3 text-gray-400 mr-1 mt-0.5 flex-shrink-0"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        <span>{school.parent_location.name}</span>
                      <% end %>
                    </div>
                  <% end %>
                </a>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
          <h3 class="text-lg font-medium text-gray-900 mb-3">Hinweise</h3>
          <p class="text-sm text-gray-700 flex items-start">
            <svg
              class="h-5 w-5 text-gray-400 mr-2 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
            <span>Alle mit * markierten Felder sind Pflichtfelder.</span>
          </p>
        </div>
      <% end %>

      <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 mt-4">
        <h3 class="text-lg font-medium text-gray-900 mb-3">Tageslimit</h3>
        <div class="space-y-2 text-sm">
          <p class="text-gray-700">
            Zum Schutz vor Missbrauch gibt es ein Tageslimit von 20 Änderungen.
          </p>
          <div class="flex items-center justify-between">
            <span class="text-gray-600">Heutige Änderungen:</span>
            <span class="font-semibold text-gray-900">
              {@daily_changes} / 20
            </span>
          </div>
          <div class="mt-2">
            <div class="bg-gray-200 rounded-full h-2">
              <div
                class={"h-2 rounded-full #{if @limit_reached, do: "bg-red-600", else: "bg-green-600"}"}
                style={"width: #{min(@daily_changes / 20 * 100, 100)}%"}
              >
              </div>
            </div>
          </div>
          <%= if @limit_reached do %>
            <p class="text-red-600 text-sm mt-2">
              Das Tageslimit wurde erreicht. Bitte versuchen Sie es morgen erneut.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
