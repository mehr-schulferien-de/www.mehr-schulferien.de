<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <nav
    class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400 mb-6"
    aria-label="Breadcrumb"
  >
    <a href="/" class="hover:text-gray-700 dark:hover:text-gray-200">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
      </svg>
    </a>
    <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 20 20">
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"
      />
    </svg>
    <a href="/briefe" class="hover:text-gray-700 dark:hover:text-gray-200">Schule suchen</a>
    <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="currentColor" viewBox="0 0 20 20">
      <path
        fill-rule="evenodd"
        d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
        clip-rule="evenodd"
      />
    </svg>
    <span class="text-gray-700 dark:text-gray-300">Neue Schule anlegen</span>
  </nav>

  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-8">Neue Schule anlegen</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2">
      <div class="bg-white dark:bg-gray-800 shadow-sm rounded-lg p-6">
        <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-6">Schuldaten</h2>

        {Phoenix.View.render(MehrSchulferienWeb.WikiView, "_school_form.html",
          changeset: @changeset,
          limit_reached: @limit_reached,
          school_name: @school_name,
          address: nil,
          disable_zip_code: false,
          submit_text: "Schule anlegen",
          submit_class: "bg-blue-600 hover:bg-blue-700",
          submit_focus_class: "focus:ring-blue-500",
          submit_event: "save",
          existing_schools: @existing_schools,
          zip_code_valid: @zip_code_valid,
          city_from_zip: @city_from_zip
        )}
      </div>
    </div>

    <div>
      <%= if length(@existing_schools) > 0 do %>
        <div
          id="existing-schools"
          class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg overflow-hidden"
        >
          <div class="bg-amber-100 dark:bg-amber-900/30 px-4 py-3 border-b border-amber-200 dark:border-amber-800">
            <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">
              Existierende Schulen ({length(@existing_schools)})
            </h3>
          </div>
          <div class="p-4">
            <p class="text-xs text-amber-700 dark:text-amber-300 mb-3">
              Bitte prüfen Sie, ob Ihre Schule bereits vorhanden ist:
            </p>
            <div class="space-y-2">
              <%= for school <- @existing_schools do %>
                <a
                  href={"/briefe/#{school.slug}"}
                  class="block bg-white dark:bg-gray-800 rounded border border-amber-200 dark:border-amber-700 p-3 hover:border-amber-300 dark:hover:border-amber-600 hover:shadow-sm transition-all"
                  target="_blank"
                >
                  <div class="font-medium text-sm text-gray-900 dark:text-gray-100">
                    {school.name}
                  </div>
                  <%= if school.address do %>
                    <div class="mt-1 text-xs text-gray-600 dark:text-gray-400 flex items-start">
                      <svg
                        class="w-3 h-3 text-gray-400 dark:text-gray-500 mr-1 mt-0.5 flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        />
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        />
                      </svg>
                      <div>
                        <%= if school.address.street do %>
                          <div>{school.address.street}</div>
                        <% end %>
                        <div>
                          {school.address.zip_code || ""}
                          {school.address.city || school.parent_location.name}
                        </div>
                      </div>
                    </div>
                  <% else %>
                    <div class="mt-1 text-xs text-gray-500 dark:text-gray-400 flex items-start">
                      <%= if school.parent_location do %>
                        <svg
                          class="w-3 h-3 text-gray-400 dark:text-gray-500 mr-1 mt-0.5 flex-shrink-0"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        <span>{school.parent_location.name}</span>
                      <% end %>
                    </div>
                  <% end %>
                </a>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6">
          <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-3">Hinweise</h3>
          <p class="text-sm text-gray-700 dark:text-gray-300 flex items-start">
            <svg
              class="h-5 w-5 text-gray-400 dark:text-gray-500 mr-2 mt-0.5 flex-shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"
              />
            </svg>
            <span>Alle mit * markierten Felder sind Pflichtfelder.</span>
          </p>
        </div>
      <% end %>

      <div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 mt-4">
        <h3 class="text-lg font-medium text-gray-900 dark:text-gray-100 mb-3">Tageslimit</h3>
        <div class="space-y-2 text-sm">
          <p class="text-gray-700 dark:text-gray-300">
            Zum Schutz vor Missbrauch gibt es ein Tageslimit von 20 Änderungen.
          </p>
          <div class="flex items-center justify-between">
            <span class="text-gray-600 dark:text-gray-400">Heutige Änderungen:</span>
            <span class="font-semibold text-gray-900 dark:text-gray-100">
              {@daily_changes} / 20
            </span>
          </div>
          <div class="mt-2">
            <div class="bg-gray-200 dark:bg-gray-700 rounded-full h-2">
              <div
                class={"h-2 rounded-full #{if @limit_reached, do: "bg-red-600", else: "bg-green-600"}"}
                style={"width: #{min(@daily_changes / 20 * 100, 100)}%"}
              >
              </div>
            </div>
          </div>
          <%= if @limit_reached do %>
            <p class="text-red-600 text-sm mt-2">
              Das Tageslimit wurde erreicht. Bitte versuchen Sie es morgen erneut.
            </p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
