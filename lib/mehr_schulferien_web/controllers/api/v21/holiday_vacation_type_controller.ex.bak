defmodule MehrSchulferienWeb.Api.V21.HolidayVacationTypeController do
  @moduledoc """
  API v2.1 controller for holiday and vacation types.
  
  Provides endpoints for:
  - Listing all holiday/vacation types
  - Getting a specific type by ID
  """
  use MehrSchulferienWeb.Api.V21.BaseController

  alias MehrSchulferien.Calendars.HolidayOrVacationType

  def index(conn, params) do
    pagination = parse_pagination(params)
    
    query = build_index_query(params)
    result = paginate_query(query, pagination.page, pagination.per_page)
    
    types = Enum.map(result.entries, &format_holiday_vacation_type/1)
    
    render_paginated(conn, types, %{
      page: result.page,
      per_page: result.per_page,
      total_pages: result.total_pages,
      total_entries: result.total_entries
    })
  end

  def show(conn, %{"id" => id}) do
    with {:ok, type} <- get_holiday_vacation_type_by_id(id) do
      render_json(conn, format_holiday_vacation_type(type))
    end
  end

  # Private functions

  defp build_index_query(params) do
    query = from h in HolidayOrVacationType,
      order_by: [asc: h.name]
    
    case params["country_id"] do
      nil -> query
      country_id ->
        from h in query,
          where: h.country_location_id == ^country_id
    end
  end

  defp get_holiday_vacation_type_by_id(id) do
    case Repo.get(HolidayOrVacationType, id) do
      nil -> {:error, :not_found}
      type -> {:ok, type}
    end
  end

  defp format_holiday_vacation_type(type) do
    %{
      id: type.id,
      name: type.name,
      slug: type.slug,
      colloquial: type.colloquial,
      wikipedia_url: type.wikipedia_url,
      default_html_class: type.default_html_class,
      default_is_public_holiday: type.default_is_public_holiday,
      default_is_school_vacation: type.default_is_school_vacation,
      default_is_valid_for_students: type.default_is_valid_for_students,
      default_is_valid_for_everybody: type.default_is_valid_for_everybody,
      country_location_id: type.country_location_id
    }
  end
end