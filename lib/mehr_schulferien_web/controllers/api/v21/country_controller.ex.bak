defmodule MehrSchulferienWeb.Api.V21.CountryController do
  @moduledoc """
  API v2.1 controller for countries.
  
  Provides endpoints for:
  - Listing all countries
  - Getting a specific country by slug
  - Getting federal states for a country
  """
  use MehrSchulferienWeb.Api.V21.BaseController

  def index(conn, params) do
    pagination = parse_pagination(params)
    
    query = from l in Location,
      where: l.is_country == true,
      order_by: [asc: l.name]
    
    result = paginate_query(query, pagination.page, pagination.per_page)
    
    countries = Enum.map(result.entries, &format_location/1)
    
    render_paginated(conn, countries, %{
      page: result.page,
      per_page: result.per_page,
      total_pages: result.total_pages,
      total_entries: result.total_entries
    })
  end

  def show(conn, %{"slug" => slug}) do
    with {:ok, country} <- get_country_by_slug(slug) do
      render_json(conn, format_location(country))
    end
  end

  def federal_states(conn, %{"slug" => slug} = params) do
    with {:ok, country} <- get_country_by_slug(slug) do
      pagination = parse_pagination(params)
      
      query = from l in Location,
        where: l.parent_location_id == ^country.id and l.is_federal_state == true,
        order_by: [asc: l.name]
      
      result = paginate_query(query, pagination.page, pagination.per_page)
      
      federal_states = Enum.map(result.entries, &format_location/1)
      
      render_paginated(conn, federal_states, %{
        page: result.page,
        per_page: result.per_page,
        total_pages: result.total_pages,
        total_entries: result.total_entries,
        country: format_location(country)
      })
    end
  end

  # Private functions

  defp get_country_by_slug(slug) do
    query = from l in Location,
      where: l.slug == ^slug and l.is_country == true
    
    case Repo.one(query) do
      nil -> {:error, :not_found}
      country -> {:ok, country}
    end
  end
end