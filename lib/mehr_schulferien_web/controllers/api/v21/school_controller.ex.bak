defmodule MehrSchulferienWeb.Api.V21.SchoolController do
  @moduledoc """
  API v2.1 controller for schools.
  
  Provides endpoints for:
  - Listing all schools
  - Getting a specific school by slug
  - Getting periods for a school
  - Generating iCalendar for a school
  - Generating vCard for a school
  """
  use MehrSchulferienWeb.Api.V21.BaseController

  alias MehrSchulferien.Calendars.CustomICal
  alias MehrSchulferien.Maps

  def index(conn, params) do
    pagination = parse_pagination(params)
    
    query = build_index_query(params)
    result = paginate_query(query, pagination.page, pagination.per_page)
    
    schools = 
      result.entries
      |> Repo.preload(:address)
      |> Enum.map(&format_school/1)
    
    render_paginated(conn, schools, %{
      page: result.page,
      per_page: result.per_page,
      total_pages: result.total_pages,
      total_entries: result.total_entries
    })
  end

  def show(conn, %{"slug" => slug}) do
    with {:ok, school} <- get_school_by_slug(slug) do
      school = Repo.preload(school, :address)
      render_json(conn, format_school(school))
    end
  end

  def periods(conn, %{"slug" => slug} = params) do
    with {:ok, school} <- get_school_by_slug(slug) do
      {start_date, end_date} = parse_date_range(params)
      location_ids = Locations.recursive_location_ids(school)
      
      periods = 
        case params["type"] do
          "vacation" ->
            Periods.list_school_vacation_periods(location_ids, start_date, end_date)
          "holiday" ->
            Periods.list_public_periods(location_ids, start_date, end_date)
          _ ->
            Periods.list_school_vacation_periods(location_ids, start_date, end_date) ++
            Periods.list_public_periods(location_ids, start_date, end_date)
        end
        |> Enum.map(&format_period/1)
        |> Enum.sort_by(& &1.starts_on)
      
      render_json(conn, periods, %{
        location: format_school(school),
        date_range: %{
          start_date: start_date,
          end_date: end_date
        }
      })
    end
  end

  def icalendar(conn, %{"slug" => slug} = params) do
    with {:ok, school} <- get_school_by_slug(slug) do
      ical_params = parse_ical_params(params)
      location_ids = Locations.recursive_location_ids(school)
      
      {start_date, end_date, is_school_year} = 
        get_date_range(ical_params.year, ical_params.use_calendar_year)
      
      periods = list_periods(ical_params.vacation_types, location_ids, start_date, end_date)
      
      # For calendar year view, filter periods to only include days within the specified year
      periods =
        if ical_params.use_calendar_year do
          filter_periods_by_calendar_year(periods, ical_params.year)
        else
          periods
        end
      
      ical_content = CustomICal.generate(periods, school)
      
      conn
      |> put_resp_header("content-type", "text/calendar; charset=utf-8")
      |> put_resp_header("content-disposition", 
           build_ical_filename(school.name, ical_params.year, is_school_year))
      |> text(ical_content)
    end
  end

  def vcard(conn, %{"slug" => slug}) do
    with {:ok, school} <- get_school_by_slug(slug) do
      school = Repo.preload(school, :address)
      
      vcard_content = generate_vcard(school)
      
      conn
      |> put_resp_header("content-type", "text/x-vcard; charset=utf-8")
      |> put_resp_header("content-disposition", 
           "attachment; filename=#{slug}.vcf")
      |> text(vcard_content)
    end
  end

  # Private functions

  defp build_index_query(params) do
    query = from l in Location,
      where: l.is_school == true,
      order_by: [asc: l.name]
    
    query = 
      case params["city"] do
        nil -> query
        city_slug ->
          from l in query,
            join: c in Location,
            on: l.parent_location_id == c.id,
            where: c.slug == ^city_slug and c.is_city == true
      end
    
    case params["federal_state"] do
      nil -> query
      federal_state_slug ->
        from l in query,
          join: c in Location,
          on: l.parent_location_id == c.id,
          join: fs in Location,
          on: c.parent_location_id == fs.id,
          where: fs.slug == ^federal_state_slug and fs.is_federal_state == true
    end
  end

  defp get_school_by_slug(slug) do
    query = from l in Location,
      where: l.slug == ^slug and l.is_school == true
    
    case Repo.one(query) do
      nil -> {:error, :not_found}
      school -> {:ok, school}
    end
  end

  defp format_school(school) do
    base = format_location(school)
    
    address_info = 
      case school.address do
        nil -> %{}
        address ->
          %{
            street: address.street,
            zip_code: address.zip_code,
            city: address.city,
            phone: address.phone_number,
            fax: address.fax_number,
            email: address.email_address,
            homepage: address.homepage_url
          }
      end
    
    Map.merge(base, %{address: address_info})
  end

  defp generate_vcard(school) do
    address = school.address || %{}
    
    vcard_lines = [
      "BEGIN:VCARD",
      "VERSION:3.0",
      "FN:#{school.name}",
      "ORG:#{school.name}"
    ]
    
    vcard_lines = 
      if address.street && address.zip_code && address.city do
        vcard_lines ++ ["ADR;WORK:;;#{address.street};#{address.city};;#{address.zip_code};Deutschland"]
      else
        vcard_lines
      end
    
    vcard_lines = 
      case address.phone_number do
        nil -> vcard_lines
        phone -> vcard_lines ++ ["TEL;WORK:#{phone}"]
      end
    
    vcard_lines = 
      case address.fax_number do
        nil -> vcard_lines
        fax -> vcard_lines ++ ["TEL;WORK;FAX:#{fax}"]
      end
    
    vcard_lines = 
      case address.email_address do
        nil -> vcard_lines
        email -> vcard_lines ++ ["EMAIL;INTERNET:#{email}"]
      end
    
    vcard_lines = 
      case address.homepage_url do
        nil -> vcard_lines
        url -> vcard_lines ++ ["URL:#{url}"]
      end
    
    vcard_lines = vcard_lines ++ ["END:VCARD"]
    
    Enum.join(vcard_lines, "\r\n")
  end

  defp list_periods("all", location_ids, start_date, end_date) do
    periods =
      list_school_vacation_periods(location_ids, start_date, end_date) ++
        Periods.list_public_periods(location_ids, start_date, end_date)

    Enum.sort(periods, &(Date.compare(&1.starts_on, &2.starts_on) != :gt))
  end

  defp list_periods(_, location_ids, start_date, end_date) do
    list_school_vacation_periods(location_ids, start_date, end_date)
  end

  defp list_school_vacation_periods(location_ids, start_date, end_date) do
    location_ids
    |> Periods.list_school_vacation_periods(start_date, end_date)
    |> Enum.reject(
      &(&1.holiday_or_vacation_type.name == "Sommer" and
          Date.compare(&1.starts_on, start_date) == :lt)
    )
  end

  defp filter_periods_by_calendar_year(periods, year) do
    {:ok, year_start} = Date.new(year, 1, 1)
    {:ok, year_end} = Date.new(year, 12, 31)

    Enum.map(periods, fn period ->
      cond do
        # Period starts before this year and ends after this year
        Date.compare(period.starts_on, year_start) == :lt &&
            Date.compare(period.ends_on, year_end) == :gt ->
          %{period | starts_on: year_start, ends_on: year_end}

        # Period starts before this year and ends within this year
        Date.compare(period.starts_on, year_start) == :lt &&
            Date.compare(period.ends_on, year_start) != :lt ->
          %{period | starts_on: year_start}

        # Period starts within this year and ends after this year
        Date.compare(period.starts_on, year_end) != :gt &&
            Date.compare(period.ends_on, year_end) == :gt ->
          %{period | ends_on: year_end}

        # Period is entirely within this year
        true ->
          period
      end
    end)
  end

  defp build_ical_filename(name, year, true = _is_school_year) do
    sanitized_name = String.replace(name, [" ", "-"], "_")
    "attachment; filename=Schulferien_#{sanitized_name}_Schuljahr_#{year}-#{year + 1}.ics"
  end

  defp build_ical_filename(name, year, false = _is_school_year) do
    sanitized_name = String.replace(name, [" ", "-"], "_")
    "attachment; filename=Schulferien_#{sanitized_name}_#{year}.ics"
  end
end