defmodule MehrSchulferienWeb.Api.V21.BaseController do
  @moduledoc """
  Base controller for API v2.1 providing common functionality.
  
  API v2.1 improvements:
  - Clear separation of location types (federal states, cities, schools, etc.)
  - Consistent JSON API response format
  - Better error handling
  - Pagination support for list endpoints
  """

  defmacro __using__(_) do
    quote do
      use MehrSchulferienWeb, :controller

      alias MehrSchulferien.{Locations, Periods}
      alias MehrSchulferien.Locations.Location
      alias MehrSchulferien.Repo
      import Ecto.Query
      import MehrSchulferienWeb.Api.V21.BaseController

      action_fallback MehrSchulferienWeb.Api.V21.FallbackController
    end
  end

  @doc """
  Render a successful JSON response with data and metadata.
  """
  def render_json(conn, data, meta \\ %{}) do
    Phoenix.Controller.json(conn, %{
      data: data,
      meta: Map.merge(%{api_version: "2.1"}, meta)
    })
  end

  @doc """
  Render a paginated JSON response.
  """
  def render_paginated(conn, data, pagination_meta) do
    render_json(conn, data, %{
      pagination: pagination_meta
    })
  end

  @doc """
  Parse pagination parameters from the request.
  """
  def parse_pagination(params) do
    page = param_to_integer(params["page"], 1)
    per_page = param_to_integer(params["per_page"], 20) |> min(100)
    
    %{page: page, per_page: per_page}
  end

  @doc """
  Apply pagination to a query and return results with metadata.
  
  This function must be called from within a controller that has imported Ecto.Query.
  """
  def paginate(query, page, per_page, repo \\ MehrSchulferien.Repo) do
    import Ecto.Query
    
    offset = (page - 1) * per_page
    
    entries = 
      query
      |> limit(^per_page)
      |> offset(^offset)
      |> repo.all()
    
    # Get total count
    total_entries = 
      query
      |> exclude(:order_by)
      |> exclude(:preload)
      |> select([x], count(x.id))
      |> repo.one()
    
    total_pages = ceil(total_entries / per_page)
    
    %{
      entries: entries,
      page: page,
      per_page: per_page,
      total_pages: total_pages,
      total_entries: total_entries
    }
  end

  @doc """
  Parse date range parameters.
  """
  def parse_date_range(params) do
    today = Date.utc_today()
    
    start_date = case params["start_date"] do
      nil -> today
      date_string -> Date.from_iso8601!(date_string)
    end
    
    end_date = case params["end_date"] do
      nil -> Date.add(start_date, 365)
      date_string -> Date.from_iso8601!(date_string)
    end
    
    {start_date, end_date}
  end

  @doc """
  Parse year and calendar year parameters for iCal.
  """
  def parse_ical_params(params) do
    year = param_to_integer(params["year"], Date.utc_today().year)
    vacation_types = params["vacation_types"] || "school"
    use_calendar_year = params["calendar_year"] == "true"
    
    %{
      year: year,
      vacation_types: vacation_types,
      use_calendar_year: use_calendar_year
    }
  end

  @doc """
  Get date range for calendar year or school year.
  """
  def get_date_range(year, use_calendar_year) do
    if use_calendar_year do
      # Calendar year (Jan 1 to Dec 31)
      {:ok, start_date} = Date.new(year, 1, 1)
      {:ok, end_date} = Date.new(year, 12, 31)
      {start_date, end_date, false}
    else
      # School year (Aug 1 to Jul 31)
      {:ok, start_date} = Date.new(year, 8, 1)
      {:ok, end_date} = Date.new(year + 1, 7, 31)
      {start_date, end_date, true}
    end
  end

  @doc """
  Convert parameter to integer with default value.
  """
  def param_to_integer(nil, default), do: default
  def param_to_integer(value, default) when is_binary(value) do
    case Integer.parse(value) do
      {int, _} -> int
      :error -> default
    end
  end
  def param_to_integer(value, _default) when is_integer(value), do: value

  @doc """
  Format location for JSON response.
  """
  def format_location(location) do
    %{
      id: location.id,
      name: location.name,
      slug: location.slug,
      code: location.code,
      type: get_location_type(location),
      parent_location_id: location.parent_location_id,
      links: %{
        self: get_location_url(location),
        periods: get_location_periods_url(location),
        icalendar: get_location_icalendar_url(location)
      }
    }
  end

  @doc """
  Format period for JSON response.
  """
  def format_period(period) do
    %{
      id: period.id,
      starts_on: period.starts_on,
      ends_on: period.ends_on,
      name: period.holiday_or_vacation_type.name,
      type: get_period_type(period),
      is_school_vacation: period.is_school_vacation,
      is_public_holiday: period.is_public_holiday,
      location_id: period.location_id
    }
  end

  defp get_location_type(location) do
    cond do
      location.is_country -> "country"
      location.is_federal_state -> "federal_state"
      location.is_county -> "county"
      location.is_city -> "city"
      location.is_school -> "school"
      true -> "unknown"
    end
  end

  defp get_period_type(period) do
    cond do
      period.is_school_vacation -> "school_vacation"
      period.is_public_holiday -> "public_holiday"
      true -> "other"
    end
  end

  defp get_location_url(location) do
    type = get_location_type(location)
    path = case type do
      "country" -> "/api/v2.1/countries/#{location.slug}"
      "federal_state" -> "/api/v2.1/federal-states/#{location.slug}"
      "county" -> "/api/v2.1/counties/#{location.slug}"
      "city" -> "/api/v2.1/cities/#{location.slug}"
      "school" -> "/api/v2.1/schools/#{location.slug}"
      _ -> nil
    end
    
    if path, do: "#{get_base_url()}#{path}", else: nil
  end

  defp get_location_periods_url(location) do
    url = get_location_url(location)
    if url, do: "#{url}/periods", else: nil
  end

  defp get_location_icalendar_url(location) do
    url = get_location_url(location)
    if url, do: "#{url}/icalendar", else: nil
  end

  defp get_base_url do
    # This should be configured in your application
    Application.get_env(:mehr_schulferien, :base_url, "https://www.mehr-schulferien.de")
  end
end