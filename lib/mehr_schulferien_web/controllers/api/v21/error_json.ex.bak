defmodule MehrSchulferienWeb.Api.V21.ErrorJSON do
  @moduledoc """
  Error JSON responses for API v2.1.
  """

  def render("404.json", _assigns) do
    %{
      errors: [
        %{
          status: "404",
          title: "Not Found",
          detail: "The requested resource could not be found."
        }
      ],
      meta: %{api_version: "2.1"}
    }
  end

  def render("400.json", assigns) do
    message = Map.get(assigns, :message, "Bad request")
    
    %{
      errors: [
        %{
          status: "400",
          title: "Bad Request",
          detail: message
        }
      ],
      meta: %{api_version: "2.1"}
    }
  end

  def render("422.json", %{changeset: changeset}) do
    errors = Ecto.Changeset.traverse_errors(changeset, fn {msg, opts} ->
      Regex.replace(~r"%{(\w+)}", msg, fn _, key ->
        opts |> Keyword.get(String.to_existing_atom(key), key) |> to_string()
      end)
    end)

    %{
      errors: format_changeset_errors(errors),
      meta: %{api_version: "2.1"}
    }
  end

  def render("500.json", _assigns) do
    %{
      errors: [
        %{
          status: "500",
          title: "Internal Server Error",
          detail: "An unexpected error occurred."
        }
      ],
      meta: %{api_version: "2.1"}
    }
  end

  defp format_changeset_errors(errors) do
    Enum.flat_map(errors, fn {field, messages} ->
      Enum.map(messages, fn message ->
        %{
          status: "422",
          title: "Validation Error",
          detail: message,
          source: %{pointer: "/data/attributes/#{field}"}
        }
      end)
    end)
  end
end