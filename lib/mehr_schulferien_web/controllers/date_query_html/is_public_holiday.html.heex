<div class="container mx-auto px-4 py-8 max-w-4xl">
  <.heading level={1} class="mb-6">
    Ist {Calendar.strftime(@result.date, "%d.%m.%Y")} ein Feiertag in {@federal_state.name}?
  </.heading>

  <div class="mb-8">
    <.card>
      <:content>
        <div class="text-center py-8">
          <%= if @result.is_public_holiday do %>
            <div class="text-6xl font-bold text-green-600 mb-4">JA</div>
            <.text variant="lead" class="mb-4">
              Der {Calendar.strftime(@result.date, "%d.%m.%Y")} ist ein Feiertag in {@federal_state.name}.
            </.text>
            <.text class="text-gray-600">
              {@result.explanation}
            </.text>
          <% else %>
            <div class="text-6xl font-bold text-gray-600 mb-4">NEIN</div>
            <.text variant="lead" class="mb-4">
              Der {Calendar.strftime(@result.date, "%d.%m.%Y")} ist kein Feiertag in {@federal_state.name}.
            </.text>
            <%= if @result.is_weekend do %>
              <.text class="text-gray-600">
                Es ist {@result.explanation}.
              </.text>
            <% end %>
          <% end %>
        </div>
      </:content>
    </.card>
  </div>

  <%= if length(@result.public_holiday_periods) > 0 do %>
    <div class="mb-8">
      <.heading level={2} class="mb-4">Feiertage</.heading>
      <.card>
        <:content>
          <ul class="list-disc ml-5 space-y-2">
            <%= for period <- @result.public_holiday_periods do %>
              <li>{period.holiday_or_vacation_type.name}</li>
            <% end %>
          </ul>
        </:content>
      </.card>
    </div>
  <% end %>

  <%= if length(@result.school_vacation_periods) > 0 do %>
    <div class="mb-8">
      <.heading level={2} class="mb-4">Ferien</.heading>
      <.card>
        <:content>
          <ul class="list-disc ml-5 space-y-2">
            <%= for period <- @result.school_vacation_periods do %>
              <li>
                {period.holiday_or_vacation_type.colloquial} ({Calendar.strftime(
                  period.starts_on,
                  "%d.%m."
                )} - {Calendar.strftime(period.ends_on, "%d.%m.%Y")})
              </li>
            <% end %>
          </ul>
        </:content>
      </.card>
    </div>
  <% end %>

  <div class="mb-8">
    <.heading level={2} class="mb-4">Weitere Informationen</.heading>
    <div class="space-y-4">
      <a href={~p"/ferien/#{@federal_state.slug}/#{@result.date.year}"} class="block">
        <.card class="hover:shadow-lg transition-shadow">
          <:content>
            <p class="text-lg font-semibold text-blue-700 dark:text-blue-400">
              Ferienkalender {@federal_state.name} {@result.date.year}
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Alle Ferien und Feiertage für {@result.date.year}
            </p>
          </:content>
        </.card>
      </a>

      <a
        href={
          ~p"/brueckentage/deutschland/bundesland/#{@federal_state.slug}/#{@result.date.year}"
        }
        class="block"
      >
        <.card class="hover:shadow-lg transition-shadow">
          <:content>
            <p class="text-lg font-semibold text-blue-700 dark:text-blue-400">
              Brückentage {@federal_state.name} {@result.date.year}
            </p>
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Optimale Urlaubsplanung mit Brückentagen
            </p>
          </:content>
        </.card>
      </a>
    </div>
  </div>
</div>
